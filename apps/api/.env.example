DATABASE_URL="postgresql://plataforma:plataforma@localhost:5432/plataforma_comercial?schema=public"
REDIS_URL="redis://localhost:6379"

JWT_ACCESS_SECRET="troque-este-segredo-em-producao-access"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="troque-este-segredo-em-producao-refresh"
JWT_REFRESH_EXPIRES_IN="7d"

PORT=3001
CORS_ORIGIN="http://localhost:3000"

# SMTP genérico (nodemailer) — usado para enviar senha provisória etc. Em
# dev, aponta pro Mailhog do docker-compose.dev.yml (sem autenticação, e-mails
# ficam só na UI local em http://localhost:8025, nunca saem de verdade). Em
# produção, troque pelas credenciais reais do provedor (SendGrid, SES, etc.).
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="Plataforma Comercial <no-reply@plataforma.local>"

# MySQL do dump legado (serviço mysql do docker-compose.dev.yml) — usado só
# pelo script prisma/import-clientes.ts, nunca pela API em runtime.
MYSQL_HOST="localhost"
MYSQL_PORT=3307
MYSQL_USER="rcg"
MYSQL_PASSWORD="rcg"
MYSQL_DATABASE="rcgdistc_portal"
