generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------
// Identidade & acesso
// ------------------------------------------------------------------

model Empresa {
  id           String  @id @default(uuid())
  razaoSocial  String
  nomeFantasia String
  cnpj         String  @unique
  alias        String? @unique
  logoUrl      String?
  ativo        Boolean @default(true)

  // Identificação fiscal e contato — o que sai no cabeçalho de documentos
  // emitidos pro cliente (hoje a proposta em PDF do orçamento). Todos
  // opcionais: empresa cadastrada antes destes campos continua válida.
  inscricaoEstadual  String?
  inscricaoMunicipal String?
  endereco           String?
  complemento        String?
  bairro             String?
  municipio          String?
  uf                 String?
  cep                String?
  telefone           String?
  email              String?
  site               String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  usuarioEmpresas            UsuarioEmpresa[]
  produtos                   Produto[]
  vendedores                 Vendedor[]
  clientes                   Cliente[]
  categorias                 Categoria[]
  condicoesPagamento         CondicaoPagamento[]
  armazens                   Armazem[]
  estoques                   Estoque[]
  tabelasPreco               TabelaPreco[]
  regrasDesconto             RegraDesconto[]
  regrasDescontoFaixas       RegraDescontoFaixa[]
  tabelasPrecoItens          TabelaPrecoItem[]
  notasSaida                 NotaSaida[]
  notasSaidaItens            NotaSaidaItem[]
  titulosReceber             TituloReceber[]
  oportunidades              Oportunidade[]
  atividades                 Atividade[]
  objetivosVendedorMes       ObjetivoVendedorMes[]
  objetivosVendedorCategoria ObjetivoVendedorCategoria[]
  orcamentos                 Orcamento[]
  orcamentoItens             OrcamentoItem[]
  integracaoApiKeys          IntegracaoApiKey[]
  clienteCampoConfigs        ClienteCampoConfig[]
  orcamentoConfig            OrcamentoConfig?
  parametros                 ParametroEmpresa[]
  clienteCnaes               ClienteCnae[]
  clienteAlteracoes          ClienteAlteracao[]
  clienteHistorico           ClienteHistorico[]
  sugestoesCompra            SugestaoCompraGerada[]
  agenteConfig               AgenteConfig?
  agenteCredenciais          AgenteCredencial[]
  agenteConversas            AgenteConversa[]
  agenteMensagens            AgenteMensagem[]
  whatsappConfig             WhatsappConfig?
  whatsappSessoes            WhatsappSessao[]
  whatsappContatos           WhatsappContato[]
  whatsappConversas          WhatsappConversa[]
  whatsappMensagens          WhatsappMensagem[]
  whatsappAcoes              WhatsappAcaoRegistro[]

  @@map("empresas")
}

model Usuario {
  id          String    @id @default(uuid())
  nome        String
  email       String    @unique
  senhaHash   String
  ativo       Boolean   @default(true)
  ultimoLogin DateTime?
  avatarUrl   String?
  mfaEnabled  Boolean   @default(false)

  // Política de senha (ver PoliticaSenha, singleton global): senhaAlteradaEm
  // marca a "idade" da senha atual para cálculo de expiração; tentativasFalhas
  // e bloqueadoAte implementam o lockout de login; deveTrocarSenha força a
  // troca no próximo login após um reset feito por admin.
  senhaAlteradaEm  DateTime?
  tentativasFalhas Int       @default(0)
  bloqueadoAte     DateTime?
  deveTrocarSenha  Boolean   @default(false)

  // Restrição de expediente (ver UsuarioHorario): quando false — o padrão —
  // o usuário acessa a qualquer hora. Ligada, o login e cada requisição
  // autenticada passam a exigir que o momento esteja dentro de uma das faixas
  // cadastradas, no fuso da operação. O flag separado é necessário porque
  // "nenhuma faixa cadastrada" significa coisas opostas nos dois casos.
  restringirHorario Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  usuarioEmpresas UsuarioEmpresa[]
  refreshTokens   RefreshToken[]
  vendedores      Vendedor[]
  senhaHistorico  SenhaHistorico[]
  horarios        UsuarioHorario[]
  acessos         AcessoLog[]
  sessoes         Sessao[]

  @@map("usuarios")
}

/**
 * Faixa de expediente de um usuário, uma por dia da semana (0 = domingo …
 * 6 = sábado). Dia sem linha = sem acesso naquele dia, quando
 * `Usuario.restringirHorario` está ligado.
 *
 * Horas ficam como texto "HH:MM" de propósito: é hora de parede no fuso da
 * operação (America/Campo_Grande), não um instante — guardar em DateTime
 * traria fuso e data junto, que não têm significado aqui.
 *
 * Sem `empresaId`: a trava é da conta (login é global, como a política de
 * senha), não do vínculo com uma empresa. Por isso não tem RLS.
 */
model UsuarioHorario {
  id         String @id @default(uuid())
  usuarioId  String
  diaSemana  Int
  horaInicio String
  horaFim    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@unique([usuarioId, diaSemana])
  @@map("usuario_horarios")
}

// Vínculo usuário×empresa: perfil (RBAC) + hierarquia/dados de vendedor
// nessa empresa (ver docs/regras-de-negocio.md). Um usuário multiempresa tem
// um registro aqui por empresa, cada um com seu próprio perfil/superior. O
// perfil sistemaBase enxerga tudo da empresa sem restrição de carteira; os
// demais são escopados pela árvore superiorId, qualquer que seja o perfil.
model UsuarioEmpresa {
  id        String  @id @default(uuid())
  usuarioId String
  empresaId String
  perfilId  String
  ativo     Boolean @default(true)

  superiorId     String?
  codigoErp      String?
  nomeReduzido   String?
  telefone       String?
  celular        String?
  dataNascimento DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  usuario   Usuario          @relation(fields: [usuarioId], references: [id])
  empresa   Empresa          @relation(fields: [empresaId], references: [id])
  perfil    Perfil           @relation(fields: [perfilId], references: [id])
  superior  UsuarioEmpresa?  @relation("UsuarioEmpresaHierarquia", fields: [superiorId], references: [id])
  liderados UsuarioEmpresa[] @relation("UsuarioEmpresaHierarquia")

  @@unique([usuarioId, empresaId])
  @@map("usuario_empresas")
}

// Perfil (papel RBAC) é global — compartilhado por todas as empresas, sem
// empresaId/RLS (mesmo precedente de Modulo/Menu/Rotina). Cada vínculo
// usuário×empresa (UsuarioEmpresa) escolhe um perfil dessa lista global.
model Perfil {
  id          String  @id @default(uuid())
  nome        String
  descricao   String?
  sistemaBase Boolean @default(false)
  ativo       Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  usuarioEmpresas UsuarioEmpresa[]
  permissoes      PerfilPermissao[]

  @@unique([nome])
  @@map("perfis")
}

model Modulo {
  id    String  @id @default(uuid())
  nome  String
  icone String?
  ordem Int     @default(0)
  ativo Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  menus Menu[]

  @@map("modulos")
}

model Menu {
  id        String  @id @default(uuid())
  moduloId  String
  menuPaiId String?
  nome      String
  icone     String?
  rota      String?
  ordem     Int     @default(0)
  ativo     Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  modulo   Modulo   @relation(fields: [moduloId], references: [id])
  menuPai  Menu?    @relation("MenuSubmenu", fields: [menuPaiId], references: [id])
  submenus Menu[]   @relation("MenuSubmenu")
  rotinas  Rotina[]

  @@map("menus")
}

model Rotina {
  id     String  @id @default(uuid())
  menuId String
  nome   String
  codigo String
  ativo  Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  menu       Menu              @relation(fields: [menuId], references: [id])
  permissoes PerfilPermissao[]

  @@unique([codigo])
  @@map("rotinas")
}

enum Acao {
  visualizar
  cadastrar
  editar
  excluir
  importar
  exportar
  aprovar
  cancelar
  bloquear
}

model PerfilPermissao {
  id        String  @id @default(uuid())
  perfilId  String
  rotinaId  String
  acao      Acao
  permitido Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  perfil Perfil @relation(fields: [perfilId], references: [id])
  rotina Rotina @relation(fields: [rotinaId], references: [id])

  @@unique([perfilId, rotinaId, acao])
  @@map("perfil_permissoes")
}

model RefreshToken {
  id        String    @id @default(uuid())
  usuarioId String
  empresaId String?
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  ip        String?
  userAgent String?
  // Sessão a que este token pertence (ver Sessao): o login abre a sessão e
  // cada rotação de refresh carrega o mesmo id adiante, então o logout sabe
  // qual sessão encerrar e o tempo de uso não recomeça a cada 15 minutos.
  sessaoId  String?

  createdAt DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id])
  sessao  Sessao? @relation(fields: [sessaoId], references: [id])

  @@map("refresh_tokens")
}

/**
 * Uso do sistema por sessão: do login até o logout (ou até a última renovação
 * de token, quando o usuário simplesmente fecha o navegador). Alimenta o
 * "tempo de uso" da tela Administração > Acessos.
 *
 * `ultimaAtividadeEm` avança a cada renovação de token (~15 min) e na troca de
 * empresa — não a cada requisição, que custaria uma escrita por chamada de
 * API. A precisão do tempo de uso é, portanto, da ordem de um ciclo de token.
 *
 * Sem RLS pelo mesmo motivo de `refresh_tokens`: é escrita no login, antes de
 * haver empresa ativa no contexto. `empresaId` fica como informação de qual
 * empresa a sessão abriu, e é o que a consulta filtra.
 */
model Sessao {
  id                String    @id @default(uuid())
  usuarioId         String
  empresaId         String?
  iniciadaEm        DateTime  @default(now())
  ultimaAtividadeEm DateTime  @default(now())
  encerradaEm       DateTime?
  // "logout", "troca_empresa", "fora_horario" — nulo enquanto aberta.
  motivoFim         String?
  ip                String?
  userAgent         String?

  usuario       Usuario        @relation(fields: [usuarioId], references: [id])
  refreshTokens RefreshToken[]

  @@index([usuarioId, iniciadaEm])
  @@map("sessoes")
}

enum AcessoEvento {
  login_sucesso
  login_falha
  login_bloqueado
  login_fora_horario
  acesso_fora_horario
  logout
  troca_empresa
}

/**
 * Rastro de cada tentativa de autenticação e seu desfecho — inclusive as que
 * falharam, que são justamente as que interessam investigar. Alimenta a tela
 * Administração > Acessos.
 *
 * `usuarioId` é nulo quando o e-mail digitado não existe no cadastro (a
 * tentativa é registrada mesmo assim, com o e-mail em `email`). Sem RLS pelo
 * mesmo motivo de `refresh_tokens`: é escrito no login, antes de existir
 * empresa ativa — a consulta é que filtra por empresa (ver AcessosService).
 */
model AcessoLog {
  id        String       @id @default(uuid())
  usuarioId String?
  email     String
  empresaId String?
  evento    AcessoEvento
  detalhe   String?
  ip        String?
  userAgent String?

  criadoEm DateTime @default(now())

  usuario Usuario? @relation(fields: [usuarioId], references: [id])

  @@index([criadoEm])
  @@index([usuarioId, criadoEm])
  @@map("acessos_log")
}

// Chave de integração máquina-a-máquina (ERP externo → plataforma, ver
// docs/planos/api-integracao-erp.md). A chave em claro só é exibida na
// criação; o banco guarda hash SHA-256. `prefixo` (8 primeiros chars da
// chave em claro) permite identificar a chave em tela/log sem expor o
// segredo. Sem RLS de propósito — mesma exceção de `refresh_tokens`: o
// ApiKeyGuard consulta por `chaveHash` antes de existir empresaId de
// contexto (é essa consulta que descobre o tenant).
model IntegracaoApiKey {
  id        String    @id @default(uuid())
  empresaId String
  nome      String
  chaveHash String    @unique
  prefixo   String
  ativo     Boolean   @default(true)
  expiraEm  DateTime?
  ultimoUso DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@index([empresaId])
  @@map("integracao_api_keys")
}

// ------------------------------------------------------------------
// Organização comercial
// ------------------------------------------------------------------

// Catálogo de produtos, espelhando a tabela `produto` do sistema legado.
// Categoria/subcategoria/armazém apontam para os cadastros auxiliares (a
// versão inicial usava texto achatado; virou FK quando os auxiliares foram
// implementados).
model Produto {
  id             String  @id @default(uuid())
  empresaId      String
  codigoErp      String
  descricao      String
  unidade        String?
  categoriaId    String?
  subCategoriaId String?
  armazemId      String?
  marca          String?
  codigoBarras   String?
  ncm            String?
  qtdEmbalagem   Float?
  peso           Float?
  ultimoPreco    Float?
  observacao     String?
  ativo          Boolean @default(true)

  // Regra de desconto aplicável (SZ0 do ERP). Nulo = sem regra própria;
  // a resolução de qual regra vale ainda não existe — por ora é só o vínculo.
  regraDescontoId String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  empresa       Empresa        @relation(fields: [empresaId], references: [id])
  regraDesconto RegraDesconto? @relation(fields: [regraDescontoId], references: [id])
  categoria     Categoria?     @relation("ProdutoCategoria", fields: [categoriaId], references: [id])
  subCategoria  Categoria?     @relation("ProdutoSubCategoria", fields: [subCategoriaId], references: [id])
  armazem       Armazem?       @relation(fields: [armazemId], references: [id])

  estoques          Estoque[]
  tabelasPrecoItens TabelaPrecoItem[]
  notasSaidaItens   NotaSaidaItem[]
  orcamentoItens    OrcamentoItem[]
  sugestoesCompra   SugestaoCompraGerada[]

  @@unique([empresaId, codigoErp])
  @@index([empresaId, descricao])
  @@index([empresaId, categoriaId])
  @@index([empresaId, regraDescontoId])
  @@map("produtos")
}

// Cadastro de vendedores, supervisores e gerentes (mesma tabela, com flags
// de papel — uma pessoa pode acumular mais de um papel). supervisorId e
// gerenteId são dois vínculos hierárquicos independentes, ambos
// autorreferenciando esta tabela, análogos a UsuarioEmpresa.superiorId mas
// sem checagem de ciclo (mesma limitação já aceita lá).
model Vendedor {
  id             String    @id @default(uuid())
  empresaId      String
  usuarioId      String?
  codigoErp      String?
  nome           String
  nomeReduzido   String?
  telefone       String?
  email          String?
  dataNascimento DateTime?

  // Percentual de comissão do vendedor. Mantido pelo ERP (API de integração),
  // somente leitura na tela — mesmo tratamento dos campos de regra de desconto.
  percComissao Float?

  // Papel na hierarquia comercial — exatamente um. Antes eram três booleanos
  // independentes (vendedor/supervisor/gerente), que aceitavam combinações
  // sem sentido; o enum torna o estado inválido impossível.
  tipo         TipoVendedor     @default(vendedor)
  // Como o vendedor se liga à empresa. `sistema` são os cadastros que não são
  // pessoas de venda (ESCRITORIO, E-COMMERCE...), mantidos porque o ERP
  // credita notas a eles.
  vinculo      VinculoVendedor?
  // Aparece nas telas gerenciais (dashboard/objetivos). Cadastro de sistema e
  // vendedor sem carteira normalmente ficam de fora.
  usaDashboard Boolean          @default(true)

  supervisorId String?
  gerenteId    String?

  // `desligado` é o controle de saída do vendedor, e é ele que a tela exibe;
  // o serviço mantém `ativo` como seu espelho (desligado = não ativo), porque
  // `ativo` é o que todos os selects e filtros do sistema já consultam.
  ativo     Boolean @default(true)
  desligado Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  empresa Empresa  @relation(fields: [empresaId], references: [id])
  usuario Usuario? @relation(fields: [usuarioId], references: [id])

  supervisorVendedor   Vendedor?             @relation("VendedorSupervisor", fields: [supervisorId], references: [id])
  supervisionados      Vendedor[]            @relation("VendedorSupervisor")
  gerenteVendedor      Vendedor?             @relation("VendedorGerente", fields: [gerenteId], references: [id])
  gerenciados          Vendedor[]            @relation("VendedorGerente")
  clientes             Cliente[]
  notasSaida           NotaSaida[]
  notasSaidaItens      NotaSaidaItem[]
  titulosReceber       TituloReceber[]
  oportunidades        Oportunidade[]
  atividades           Atividade[]
  objetivosVendedorMes ObjetivoVendedorMes[]
  orcamentos           Orcamento[]
  whatsappSessoes      WhatsappSessao[]

  @@unique([empresaId, codigoErp])
  @@index([empresaId, nome])
  @@map("vendedores")
}

enum TipoPessoa {
  fisica
  juridica
}

/// Papel do vendedor na hierarquia comercial — um só por cadastro. `gerente`
/// enxerga o time inteiro, `supervisor` os vendedores abaixo dele e `vendedor`
/// só a própria carteira (ver escopo-vendedores.ts).
enum TipoVendedor {
  vendedor
  supervisor
  gerente
}

/// Vínculo do vendedor com a empresa. `sistema` marca os cadastros que não são
/// pessoas de venda (ESCRITORIO, E-COMMERCE, balcão), mas que recebem nota no
/// ERP e por isso precisam existir aqui.
enum VinculoVendedor {
  clt
  representante
  sistema
}

// Carteira de clientes, espelhando a tabela `cliente` do sistema legado
// (lookups como segmento/região ficaram de fora do v1 — ver
// docs/planos/clientes-crud.md). vendedorId define a carteira e é a base do
// escopo hierárquico aplicado em ClientesService (vendedor vê a própria
// carteira, supervisor/gerente veem o time). Campos de histórico comercial
// (primeiraCompra, ultimaCompra, ...) são preenchidos pelo import do legado,
// não pelo formulário.
model Cliente {
  id                  String  @id @default(uuid())
  empresaId           String
  vendedorId          String?
  tabelaPrecoId       String?
  condicaoPagamentoId String?
  codigoErp           String?

  tipoPessoa         TipoPessoa @default(juridica)
  razaoSocial        String
  nomeFantasia       String?
  cnpjCpf            String?
  inscricaoEstadual  String?
  inscricaoMunicipal String?
  contribuinteIcms   Boolean?
  rg                 String?
  dataNascimento     DateTime?

  contato   String?
  email     String?
  telefone  String?
  telefone2 String?
  celular   String?

  endereco    String?
  complemento String?
  bairro      String?
  municipio   String?
  uf          String?
  cep         String?
  latitude    Float?
  longitude   Float?

  ativo            Boolean   @default(true)
  carteira         Boolean?
  site             String?
  limiteCredito    Float?
  vencimentoLimite DateTime?
  observacao       String?

  dataBloqueio         DateTime?
  observacaoBloqueio   String?
  dataReativacao       DateTime?
  observacaoReativacao String?

  primeiraCompra    DateTime?
  ultimaVisita      DateTime?
  ultimaCompra      DateTime?
  ultimoAtendimento DateTime?
  dataConsultaRfb   DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  empresa           Empresa            @relation(fields: [empresaId], references: [id])
  vendedor          Vendedor?          @relation(fields: [vendedorId], references: [id])
  tabelaPreco       TabelaPreco?       @relation(fields: [tabelaPrecoId], references: [id])
  condicaoPagamento CondicaoPagamento? @relation(fields: [condicaoPagamentoId], references: [id])

  notasSaida        NotaSaida[]
  notasSaidaItens   NotaSaidaItem[]
  titulosReceber    TituloReceber[]
  oportunidades     Oportunidade[]
  atividades        Atividade[]
  orcamentos        Orcamento[]
  cnaes             ClienteCnae[]
  alteracoes        ClienteAlteracao[]
  historico         ClienteHistorico[]
  sugestoesCompra   SugestaoCompraGerada[]
  whatsappContatos  WhatsappContato[]
  whatsappConversas WhatsappConversa[]

  @@unique([empresaId, codigoErp])
  @@index([empresaId, razaoSocial])
  @@index([empresaId, vendedorId])
  @@index([empresaId, tabelaPrecoId])
  @@index([empresaId, condicaoPagamentoId])
  @@map("clientes")
}

// De onde partiu a alteração do cadastro de cliente. Todas passam pela mesma
// fila de aprovação — inclusive `integracao`: decisão de 2026-08-14, nenhuma
// origem altera cliente sem alguém com direito aprovar.
enum OrigemAlteracaoCliente {
  manual
  enriquecimento
  integracao
  agente
}

enum StatusAlteracaoCliente {
  pendente
  aprovada
  rejeitada
}

/**
 * Solicitação de alteração de cliente: o "de → para" aguardando aprovação.
 *
 * `alteracoes` é um JSON `{ campo: { de, para } }` calculado sempre contra o
 * estado atual do cliente — é o que torna a fila idempotente perante o ERP,
 * que reenvia o mesmo payload a cada sincronização: payload igual ao gravado
 * gera diff vazio e nenhuma solicitação.
 *
 * Tabela volátil (a solicitação se resolve); o rastro permanente é
 * ClienteHistorico.
 */
model ClienteAlteracao {
  id        String                 @id @default(uuid())
  empresaId String
  clienteId String
  origem    OrigemAlteracaoCliente @default(manual)
  status    StatusAlteracaoCliente @default(pendente)

  alteracoes    Json
  justificativa String?

  solicitadoPor String?
  solicitadoEm  DateTime  @default(now())
  analisadoPor  String?
  analisadoEm   DateTime?
  motivoRecusa  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id])
  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  // Índice único parcial (só entre as pendentes) é criado na migration por SQL
  // — o Prisma não modela `WHERE status = 'pendente'`. Uma pendência por
  // cliente **por origem**: o pedido do vendedor e o do ERP não se misturam.
  @@index([empresaId, status])
  @@index([empresaId, clienteId])
  @@map("cliente_alteracoes")
}

/**
 * Log imutável do que efetivamente mudou no cliente, campo a campo. Responde
 * "quem mexeu no limite de crédito deste cliente, quando e por quê" — inclusive
 * para mudanças vindas do ERP.
 */
model ClienteHistorico {
  id            String                 @id @default(uuid())
  empresaId     String
  clienteId     String
  alteracaoId   String?
  campo         String
  // Texto porque o histórico é para leitura humana; o valor tipado vive no
  // cliente, não aqui.
  valorAnterior String?
  valorNovo     String?
  // `origem` é de onde a mudança nasceu (tela, ERP, consulta de CNPJ);
  // `autor` é quem a **aplicou** — ou seja, quem aprovou, e portanto responde
  // por ela. Quem pediu está em ClienteAlteracao.solicitadoPor, alcançável
  // por `alteracaoId`.
  origem        OrigemAlteracaoCliente
  autor         String?

  criadoEm DateTime @default(now())

  empresa Empresa @relation(fields: [empresaId], references: [id])
  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([empresaId, clienteId, criadoEm])
  @@map("cliente_historico")
}

enum OrigemSugestaoCompra {
  local
  ia
}

enum AgentePapel {
  usuario
  sistema
  assistente
  ferramenta
}

/**
 * Configuração do agente de IA por empresa (singleton, padrão do
 * OrcamentoConfig). A personalidade e a temperatura são editáveis em tela para
 * ajustar o comportamento sem redeploy.
 *
 * `apiKeyCifrada` é AES-256-GCM (ver `agente-cripto.ts`) — precisa ser
 * reversível, porque a chave é usada para chamar o provedor; não é hash. A
 * chave em claro **nunca** sai da API: a leitura devolve só os últimos 4
 * dígitos, como a tela de parâmetros faz com tipo senha.
 */
model AgenteConfig {
  id        String  @id @default(uuid())
  empresaId String  @unique
  ativo     Boolean @default(false)

  // Provedor ativo. As chaves ficam em AgenteCredencial, uma por provedor,
  // para trocar de provedor não exigir recolar a chave.
  provedor String @default("anthropic")
  baseUrl  String @default("https://api.anthropic.com")
  modelo   String @default("claude-opus-5")

  // Mantidos por compatibilidade com o que já foi gravado antes da tabela de
  // credenciais existir; a leitura prefere AgenteCredencial.
  apiKeyCifrada  String?
  apiKeyUltimos4 String?

  systemPrompt String? @db.Text
  temperatura  Float   @default(0.3)
  maxTokens    Int     @default(2048)

  // Teto de voltas do laço de ferramentas: sem ele, um modelo em loop de
  // tool_calls consome tokens (pagos) indefinidamente.
  maxIteracoesFerramentas Int @default(5)
  historicoMensagens      Int @default(20)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@map("agente_config")
}

/**
 * Chave de API por provedor. Existe para tornar a troca de provedor um clique:
 * alternar entre Claude e Groq não pode exigir recolar a chave do outro.
 *
 * `modelo` guarda o último modelo usado naquele provedor, para a volta trazer
 * a configuração de antes em vez do padrão.
 */
model AgenteCredencial {
  id        String @id @default(uuid())
  empresaId String
  provedor  String

  apiKeyCifrada  String
  apiKeyUltimos4 String
  modelo         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  updatedBy String?

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@unique([empresaId, provedor])
  @@map("agente_credenciais")
}

model AgenteConversa {
  id        String  @id @default(uuid())
  empresaId String
  usuarioId String
  titulo    String?
  arquivada Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empresa   Empresa          @relation(fields: [empresaId], references: [id])
  mensagens AgenteMensagem[]

  @@index([empresaId, usuarioId, updatedAt])
  @@map("agente_conversas")
}

/**
 * Cada passo da conversa, inclusive as chamadas de ferramenta — é aqui que
 * mora a auditoria: qual ferramenta o agente quis executar, com que argumentos
 * exatos, e quem confirmou.
 *
 * `pendente` marca a ação de escrita que ainda não foi confirmada pelo
 * usuário; até `confirmadaEm` ser preenchida, nada foi gravado no sistema.
 */
model AgenteMensagem {
  id         String      @id @default(uuid())
  empresaId  String
  conversaId String
  papel      AgentePapel

  conteudo   String? @db.Text
  ferramenta String?
  argumentos Json?
  resultado  Json?

  pendente      Boolean   @default(false)
  confirmadaEm  DateTime?
  confirmadaPor String?

  tokensEntrada Int?
  tokensSaida   Int?

  criadaEm DateTime @default(now())

  empresa  Empresa        @relation(fields: [empresaId], references: [id])
  conversa AgenteConversa @relation(fields: [conversaId], references: [id], onDelete: Cascade)

  @@index([empresaId, conversaId, criadaEm])
  @@map("agente_mensagens")
}

/**
 * Sugestão de compra gerada para um cliente: produto que clientes semelhantes
 * compram e ele não.
 *
 * Guardar o resultado não é cache por preguiça — é requisito. A geração por IA
 * é paga e lenta demais para rodar a cada abertura de tela, e a linha gravada é
 * o que permite auditar **o que a IA sugeriu** depois.
 *
 * `origem` distingue o motor determinístico (`local`, SQL sobre a cesta de
 * compras e o CNAE) da recomendação do modelo (`ia`). `loteId` agrupa o que
 * saiu de uma mesma execução, para substituir um lote inteiro sem apagar o
 * outro motor.
 *
 * Nada de valor ou nome de cliente vai para a IA — ver `anonimizar.ts`. Aqui
 * só voltam códigos de produto, que são reenriquecidos na leitura.
 */
model SugestaoCompraGerada {
  id        String               @id @default(uuid())
  empresaId String
  clienteId String
  produtoId String
  origem    OrigemSugestaoCompra @default(local)

  ordem  Int
  score  Float?
  motivo String?
  modelo String?
  loteId String

  geradaEm DateTime @default(now())

  empresa Empresa @relation(fields: [empresaId], references: [id])
  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  produto Produto @relation(fields: [produtoId], references: [id])

  @@unique([clienteId, produtoId, origem])
  @@index([empresaId, clienteId, origem, ordem])
  @@index([empresaId, loteId])
  @@map("sugestoes_compra")
}

// Define, por empresa, quais campos do cadastro de Cliente o formulário
// interno permite alterar (ex.: travar campos que vêm do ERP). Sem linha
// para um campo = editável por padrão — ver ClienteCampoConfigService.
model ClienteCampoConfig {
  id        String  @id @default(uuid())
  empresaId String
  campo     String
  editavel  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@unique([empresaId, campo])
  @@map("cliente_campo_config")
}

// Parâmetro comercial (por empresa) usado pra sugerir a "Válido até" na
// criação de um Orçamento. Singleton por empresa, mesmo padrão de
// PoliticaSenha (upsert idempotente no primeiro GET), só que aqui escopado
// por empresaId (RLS) porque cada tenant pode ter um prazo diferente.
enum TipoParametro {
  texto
  numero
  booleano
  data
  senha
}

// Parâmetros do sistema por empresa, no formato clássico de tabela de
// parâmetros de ERP (uma linha por parâmetro, com tipo e conteúdo em texto).
// Centraliza o que antes ficava espalhado em telas próprias de Administração.
//
// conteudo é sempre texto: o campo `tipo` diz como interpretá-lo (ver
// ParametrosService.valorDe, que converte e valida). Parâmetro de tipo
// `senha` nunca tem o conteúdo devolvido pela API.
model ParametroEmpresa {
  id        String        @id @default(uuid())
  empresaId String
  parametro String
  tipo      TipoParametro @default(texto)
  // Limite de caracteres do conteúdo (texto/senha) ou de dígitos (numero).
  tamanho   Int?
  conteudo  String?
  descricao String?
  ativo     Boolean       @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@unique([empresaId, parametro])
  @@index([empresaId, parametro])
  @@map("parametros_empresa")
}

// Só o contador da numeração do orçamento — os parâmetros de negócio (dias
// de validade) migraram para ParametroEmpresa.
model OrcamentoConfig {
  id           String @id @default(uuid())
  empresaId    String @unique
  // Contador do Orcamento.numero. Incrementado por um INSERT ... ON CONFLICT
  // DO UPDATE (ver proximoNumeroOrcamento) — atômico, então dois vendedores
  // gravando ao mesmo tempo nunca pegam o mesmo número.
  ultimoNumero Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  updatedBy String?

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@map("orcamento_config")
}

// ------------------------------------------------------------------
// Cadastros auxiliares
// ------------------------------------------------------------------
// Dois grupos (decisão registrada em docs/planos): os geográficos/fiscais
// (Pais, Estado, Municipio, Cep, Cnae) são referência universal compartilhada
// entre as empresas — sem empresaId e sem RLS, como Modulo/Menu. Os de
// negócio (Categoria, CondicaoPagamento, Armazem) são por empresa com RLS,
// como Produto. codigoErp é a chave natural de upsert dos imports do legado
// e o ponto de amarração dos futuros módulos (Estoque, NF Saída, Títulos).

model Pais {
  id        String  @id @default(uuid())
  codigoErp String?
  nome      String
  sigla     String?
  comexId   String?
  ativo     Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  @@unique([codigoErp])
  @@map("paises")
}

model Estado {
  id         String  @id @default(uuid())
  codigoErp  String?
  sigla      String
  descricao  String
  codigoIbge String?
  ativo      Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  municipios Municipio[]
  ceps       Cep[]

  @@unique([sigla])
  @@map("estados")
}

model Municipio {
  id         String  @id @default(uuid())
  estadoId   String?
  codigoErp  String?
  descricao  String
  codigoIbge String?
  ativo      Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  estado Estado? @relation(fields: [estadoId], references: [id])
  ceps   Cep[]

  @@unique([codigoErp])
  // Chave natural do sync do IBGE e do casamento com o município que a
  // MinhaReceita/ViaCEP devolvem por código. Nulo é permitido (Postgres não
  // colide NULLs no índice único) — município cadastrado à mão fica de fora.
  @@unique([codigoIbge])
  @@index([descricao])
  @@map("municipios")
}

// Cache de consultas de CEP (o legado alimentava via serviço dos Correios —
// campo `origem` guarda a procedência da consulta).
model Cep {
  id          String  @id @default(uuid())
  cep         String
  estadoId    String?
  municipioId String?
  bairro      String?
  endereco    String?
  latitude    Float?
  longitude   Float?
  origem      String?
  ativo       Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  estado    Estado?    @relation(fields: [estadoId], references: [id])
  municipio Municipio? @relation(fields: [municipioId], references: [id])

  @@unique([cep])
  @@map("ceps")
}

// Referência de CNAEs. Vinha vazia do legado — quem popula é o `sync-ibge.ts`
// (subclasses da API do IBGE), então aqui `codigoErp` guarda o código da
// subclasse (7 dígitos) na fonte oficial, e não um código de ERP.
model Cnae {
  id        String  @id @default(uuid())
  codigoErp String?
  secao     String?
  divisao   String?
  grupo     String?
  classe    String?
  subclasse String?
  descricao String
  ativo     Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  clientes ClienteCnae[]

  @@unique([codigoErp])
  @@map("cnaes")
}

// CNAEs de um cliente (principal + secundárias), apontando para a referência
// `cnaes`. `principal` distingue o CNAE fiscal principal — o legado não tinha
// essa marca, a MinhaReceita tem (`cnae_fiscal` × `cnaes_secundarias`).
//
// É o eixo de afinidade da sugestão de compra: clientes do mesmo ramo tendem a
// comprar o mesmo conjunto de produtos.
model ClienteCnae {
  id        String  @id @default(uuid())
  empresaId String
  clienteId String
  cnaeId    String
  principal Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  empresa Empresa @relation(fields: [empresaId], references: [id])
  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  cnae    Cnae    @relation(fields: [cnaeId], references: [id])

  @@unique([clienteId, cnaeId])
  @@index([empresaId, clienteId])
  @@index([empresaId, cnaeId])
  @@map("cliente_cnaes")
}

// Categorias e subcategorias de produto na mesma tabela (auto-referência via
// categoriaPaiId), unificando as tabelas categoria/sub_categoria do legado —
// os cod_erp dos dois níveis não colidem. `usado` replica o flag S/N do
// legado (só existe no nível raiz; null nas subcategorias).
model Categoria {
  id             String   @id @default(uuid())
  empresaId      String
  categoriaPaiId String?
  codigoErp      String
  descricao      String
  usado          Boolean?
  ativo          Boolean  @default(true)

  // Regra de desconto aplicável (SZ0 do ERP). Nulo = sem regra própria;
  // a resolução de qual regra vale ainda não existe — por ora é só o vínculo.
  regraDescontoId String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  empresa       Empresa        @relation(fields: [empresaId], references: [id])
  regraDesconto RegraDesconto? @relation(fields: [regraDescontoId], references: [id])
  categoriaPai  Categoria?     @relation("CategoriaSubcategoria", fields: [categoriaPaiId], references: [id])
  subcategorias Categoria[]    @relation("CategoriaSubcategoria")

  produtos                   Produto[]                   @relation("ProdutoCategoria")
  produtosSub                Produto[]                   @relation("ProdutoSubCategoria")
  objetivosVendedorCategoria ObjetivoVendedorCategoria[]

  @@unique([empresaId, codigoErp])
  @@index([empresaId, descricao])
  @@index([empresaId, regraDescontoId])
  @@map("categorias")
}

model CondicaoPagamento {
  id        String  @id @default(uuid())
  empresaId String
  codigoErp String
  descricao String
  forma     String?
  ativo     Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  empresa    Empresa     @relation(fields: [empresaId], references: [id])
  notasSaida NotaSaida[]
  orcamentos Orcamento[]
  clientes   Cliente[]

  @@unique([empresaId, codigoErp])
  @@map("condicoes_pagamento")
}

model Armazem {
  id        String  @id @default(uuid())
  empresaId String
  codigoErp String
  descricao String
  ativo     Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  empresa  Empresa   @relation(fields: [empresaId], references: [id])
  produtos Produto[]
  estoques Estoque[]

  @@unique([empresaId, codigoErp])
  @@map("armazens")
}

// Tabela de preços — cabeçalho. Espelha `tabela_preco` do legado; campos
// nunca usados no legado (filial_id, system_unit_id, utiliza) foram
// descartados (sempre NULL no dump).
model TabelaPreco {
  id        String    @id @default(uuid())
  empresaId String
  codigoErp String
  descricao String
  dtInicio  DateTime?
  dtFim     DateTime?
  ativo     Boolean   @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  empresa  Empresa           @relation(fields: [empresaId], references: [id])
  itens    TabelaPrecoItem[]
  clientes Cliente[]

  @@unique([empresaId, codigoErp])
  @@index([empresaId, descricao])
  @@map("tabelas_preco")
}

// Item (produto + preço) de uma tabela de preço. empresaId denormalizado
// (mesmo padrão de NotaSaidaItem) para RLS/consulta sem join na tabela mãe.
// codigoLegado é a chave de idempotência do import (linhas criadas
// manualmente ficam com codigoLegado = null).
model TabelaPrecoItem {
  id            String  @id @default(uuid())
  empresaId     String
  tabelaPrecoId String
  produtoId     String
  codigoLegado  Int?
  preco         Float
  ativo         Boolean @default(true)

  // Regra de desconto aplicável (SZ0 do ERP). Nulo = sem regra própria;
  // a resolução de qual regra vale ainda não existe — por ora é só o vínculo.
  regraDescontoId String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  empresa       Empresa        @relation(fields: [empresaId], references: [id])
  regraDesconto RegraDesconto? @relation(fields: [regraDescontoId], references: [id])
  tabelaPreco   TabelaPreco    @relation(fields: [tabelaPrecoId], references: [id], onDelete: Cascade)
  produto       Produto        @relation(fields: [produtoId], references: [id], onDelete: Restrict)

  @@unique([empresaId, codigoLegado])
  @@index([tabelaPrecoId, produtoId])
  @@index([empresaId, produtoId])
  @@index([empresaId, regraDescontoId])
  @@map("tabela_preco_itens")
}

// Regra de desconto (SZ0 do ERP): teto de desconto e escalonamento da
// comissão do vendedor conforme o desconto concedido. Mestre-detalhe —
// o cabeçalho traz os limites e a comissão cheia, e as faixas dizem quanto
// dessa comissão sobra em cada intervalo de desconto.
//
// Por ora é só cadastro: nada no orçamento consulta estas regras ainda, e
// elas não estão vinculadas a produto/categoria/cliente.
model RegraDesconto {
  id        String  @id @default(uuid())
  empresaId String
  // Z0_CODIGO — chave de upsert da API de integração; null quando a regra
  // nasce na tela do CRM (mesmo padrão de Orcamento.codigoLegado).
  codigoErp String?
  descricao String

  // Z0_DESCAUT ("% Desc. Aut"): percentual de desconto autorizado.
  percDescontoAutorizado Float   @default(0)
  // Z0_PERMAX ("% Desc Max"): percentual de desconto máximo da regra.
  percDescontoMaximo     Float   @default(0)
  // Z0_COMIS: comissão cheia da regra, sobre a qual as faixas aplicam a base.
  percComissao           Float   @default(0)
  // Z0_PADRAO: regra usada quando nenhuma outra se aplica.
  padrao                 Boolean @default(false)
  ativo                  Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  empresa Empresa              @relation(fields: [empresaId], references: [id])
  faixas  RegraDescontoFaixa[]

  // Quem aponta pra esta regra. A precedência entre eles (item > tabela de
  // preço > produto > categoria) ainda não está implementada.
  categorias       Categoria[]
  produtos         Produto[]
  tabelaPrecoItens TabelaPrecoItem[]
  notasSaidaItens  NotaSaidaItem[]
  orcamentoItens   OrcamentoItem[]

  @@unique([empresaId, codigoErp])
  @@index([empresaId, descricao])
  @@map("regras_desconto")
}

// Faixa de desconto de uma regra (uma linha Z0_SEQ da SZ0): dentro do
// intervalo percInicial..percFinal, o vendedor recebe percBaseComissao% da
// comissão cheia da regra. empresaId denormalizado para RLS sem join na
// tabela mãe, como TabelaPrecoItem.
model RegraDescontoFaixa {
  id              String @id @default(uuid())
  empresaId       String
  regraDescontoId String

  sequencia        Int
  percInicial      Float @default(0)
  percFinal        Float @default(0)
  percBaseComissao Float @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  empresa       Empresa       @relation(fields: [empresaId], references: [id])
  regraDesconto RegraDesconto @relation(fields: [regraDescontoId], references: [id], onDelete: Cascade)

  @@unique([regraDescontoId, sequencia])
  @@index([empresaId, regraDescontoId])
  @@map("regras_desconto_faixas")
}

// ------------------------------------------------------------------
// Movimento comercial (consulta)
// ------------------------------------------------------------------
// Espelhos read-only do ERP legado (estoque, notas fiscais de saída e
// títulos a receber): a API só expõe listagem/detalhe — os dados entram
// exclusivamente pelos scripts de import (e no futuro pela API externa de
// manutenção). codigoLegado guarda o id da linha no MySQL e é a chave de
// upsert idempotente dos imports (as chaves "naturais" do legado têm
// duplicata/nulos). Notas, itens e títulos carregam vendedorId para o mesmo
// escopo hierárquico de Clientes.

model Estoque {
  id        String @id @default(uuid())
  empresaId String
  produtoId String
  armazemId String

  saldo        Float     @default(0)
  reserva      Float?
  custo        Float?
  ultimoPreco  Float?
  ultimaCompra DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  empresa Empresa @relation(fields: [empresaId], references: [id])
  produto Produto @relation(fields: [produtoId], references: [id])
  armazem Armazem @relation(fields: [armazemId], references: [id])

  @@unique([empresaId, produtoId, armazemId])
  @@index([empresaId, armazemId])
  @@map("estoques")
}

model NotaSaida {
  id                  String  @id @default(uuid())
  empresaId           String
  codigoLegado        Int?
  clienteId           String?
  vendedorId          String?
  condicaoPagamentoId String?

  numero        String
  serie         String?
  especieFiscal String?
  tipo          String?
  dtEmissao     DateTime?
  ano           Int?
  mes           Int?

  vlrBruto      Float @default(0)
  vlrMercadoria Float @default(0)
  vlrItens      Float @default(0)
  vlrDesconto   Float @default(0)
  vlrIcms       Float @default(0)
  vlrIpi        Float @default(0)
  vlrFrete      Float @default(0)
  vlrDevolucao  Float @default(0)

  chaveNfe String?
  dtNfe    DateTime?
  mensagem String?
  comodato Boolean   @default(false)
  ativo    Boolean   @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  empresa           Empresa            @relation(fields: [empresaId], references: [id])
  cliente           Cliente?           @relation(fields: [clienteId], references: [id])
  vendedor          Vendedor?          @relation(fields: [vendedorId], references: [id])
  condicaoPagamento CondicaoPagamento? @relation(fields: [condicaoPagamentoId], references: [id])
  itens             NotaSaidaItem[]

  @@unique([empresaId, codigoLegado])
  @@index([empresaId, numero])
  @@index([empresaId, vendedorId, ano, mes])
  @@index([empresaId, clienteId])
  @@index([empresaId, dtEmissao])
  @@map("notas_saida")
}

// Item de nota com empresaId/clienteId/vendedorId/dtEmissao denormalizados
// (como no legado) — viabiliza a tela própria de itens com RLS e escopo sem
// join na nota.
model NotaSaidaItem {
  id           String  @id @default(uuid())
  empresaId    String
  notaSaidaId  String
  codigoLegado Int?
  clienteId    String?
  vendedorId   String?
  produtoId    String?

  item      Int?
  dtEmissao DateTime?
  ano       Int?
  mes       Int?
  cfop      String?
  tipo      String?

  quantidade    Float  @default(0)
  vlrUnitario   Float  @default(0)
  vlrTabela     Float?
  percDesconto  Float?
  vlrDesconto   Float  @default(0)
  vlrTotal      Float  @default(0)
  quantidadeDev Float?
  vlrDev        Float?
  peso          Float?

  comodato Boolean @default(false)
  ativo    Boolean @default(true)

  // Percentual de comissão apurado na linha (resultado da regra de desconto
  // aplicada). Nulo enquanto não houver cálculo — nada preenche ainda.
  percComissao Float?

  // Regra de desconto aplicável (SZ0 do ERP). Nulo = sem regra própria;
  // a resolução de qual regra vale ainda não existe — por ora é só o vínculo.
  regraDescontoId String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  empresa       Empresa        @relation(fields: [empresaId], references: [id])
  regraDesconto RegraDesconto? @relation(fields: [regraDescontoId], references: [id])
  notaSaida     NotaSaida      @relation(fields: [notaSaidaId], references: [id], onDelete: Cascade)
  cliente       Cliente?       @relation(fields: [clienteId], references: [id])
  vendedor      Vendedor?      @relation(fields: [vendedorId], references: [id])
  produto       Produto?       @relation(fields: [produtoId], references: [id])

  @@unique([empresaId, codigoLegado])
  @@index([notaSaidaId])
  @@index([empresaId, produtoId])
  @@index([empresaId, vendedorId, dtEmissao])
  @@index([empresaId, regraDescontoId])
  // Monta a cesta de compras de um cliente (Sugestão de Compra) — sem ele,
  // cada cliente-alvo faz seq scan na maior tabela da base.
  @@index([empresaId, clienteId, produtoId])
  @@map("notas_saida_itens")
}

model TituloReceber {
  id           String  @id @default(uuid())
  empresaId    String
  codigoLegado Int?
  clienteId    String?
  vendedorId   String?

  numero  String
  parcela String?
  prefixo String?
  tipo    String?

  emissao        DateTime?
  vencimento     DateTime?
  vencimentoReal DateTime?
  valor          Float     @default(0)
  saldo          Float     @default(0)
  acrescimo      Float?
  decrescimo     Float?
  dtBaixa        DateTime?
  formaPgto      String?
  historico      String?
  ativo          Boolean   @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  empresa  Empresa   @relation(fields: [empresaId], references: [id])
  cliente  Cliente?  @relation(fields: [clienteId], references: [id])
  vendedor Vendedor? @relation(fields: [vendedorId], references: [id])

  @@unique([empresaId, codigoLegado])
  @@index([empresaId, clienteId])
  @@index([empresaId, vendedorId, vencimento])
  @@index([empresaId, vencimento])
  @@map("titulos_receber")
}

// ------------------------------------------------------------------
// CRM (funil de vendas + atividades comerciais)
// ------------------------------------------------------------------
// Cadastro novo (não vem do legado), editável, com o mesmo escopo
// hierárquico de vendedor das demais telas comerciais. Oportunidade e
// Atividade são recursos independentes (não mestre-detalhe entre si) — cada
// um referencia Cliente/Vendedor diretamente, e Atividade tem um vínculo
// opcional a uma Oportunidade.

enum EstagioOportunidade {
  prospeccao
  qualificacao
  proposta
  negociacao
  ganha
  perdida
}

enum TipoAtividade {
  ligacao
  reuniao
  email
  visita
  tarefa
}

model Oportunidade {
  id             String              @id @default(uuid())
  empresaId      String
  clienteId      String
  vendedorId     String
  titulo         String
  estagio        EstagioOportunidade @default(prospeccao)
  valorPrevisto  Float?
  dataPrevisao   DateTime?
  dataFechamento DateTime?
  motivoPerda    String?
  observacao     String?
  ativo          Boolean             @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  empresa    Empresa     @relation(fields: [empresaId], references: [id])
  cliente    Cliente     @relation(fields: [clienteId], references: [id])
  vendedor   Vendedor    @relation(fields: [vendedorId], references: [id])
  atividades Atividade[]
  orcamentos Orcamento[]

  @@index([empresaId, vendedorId])
  @@index([empresaId, clienteId])
  @@index([empresaId, estagio])
  @@map("oportunidades")
}

model Atividade {
  id             String        @id @default(uuid())
  empresaId      String
  clienteId      String?
  oportunidadeId String?
  orcamentoId    String?
  vendedorId     String
  tipo           TipoAtividade @default(tarefa)
  titulo         String
  descricao      String?
  dataVencimento DateTime?
  concluida      Boolean       @default(false)
  dataConclusao  DateTime?
  ativo          Boolean       @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  empresa      Empresa       @relation(fields: [empresaId], references: [id])
  cliente      Cliente?      @relation(fields: [clienteId], references: [id])
  oportunidade Oportunidade? @relation(fields: [oportunidadeId], references: [id])
  orcamento    Orcamento?    @relation(fields: [orcamentoId], references: [id])
  vendedor     Vendedor      @relation(fields: [vendedorId], references: [id])

  @@index([empresaId, vendedorId])
  @@index([empresaId, clienteId])
  @@index([empresaId, oportunidadeId])
  @@index([empresaId, orcamentoId])
  @@index([empresaId, dataVencimento])
  @@map("atividades")
}

// Orçamento/Proposta: mestre-detalhe editável (mesmo padrão de mestre-detalhe
// de ObjetivoVendedorMes — os itens são substituídos por inteiro a cada
// update, sem upsert por linha). vlrTabela referencia o preço vigente na
// TabelaPreco do cliente no momento em que o item foi adicionado (mesma
// convenção de NotaSaidaItem.vlrTabela); vlrUnitario é o preço praticado,
// que o vendedor pode ajustar manualmente. Não gera Nota de Saída — é só
// registro comercial nesta primeira versão.
enum StatusOrcamento {
  rascunho
  enviado
  aprovado
  recusado
  expirado
}

model Orcamento {
  id                  String          @id @default(uuid())
  empresaId           String
  // Chave de upsert idempotente da API de integração ERP — null pra
  // orçamentos criados manualmente na tela do CRM (mesmo padrão de
  // NotaSaida/ObjetivoVendedorMes: os dois caminhos de escrita coexistem).
  codigoLegado        Int?
  // Número do orçamento pro cliente (é o que sai na proposta em PDF):
  // sequencial por empresa, atribuído na criação a partir do contador
  // OrcamentoConfig.ultimoNumero. Existe desde o rascunho — diferente do
  // codigoLegado, que só aparece quando o ERP integra.
  numero              Int
  clienteId           String
  vendedorId          String
  oportunidadeId      String?
  condicaoPagamentoId String?
  titulo              String
  status              StatusOrcamento @default(rascunho)
  dataValidade        DateTime?
  // Data de retorno/follow-up: ao ser definida (na criação ou numa edição
  // que muda o valor), o backend gera automaticamente uma Atividade de
  // acompanhamento (tipo ligação) vinculada a este orçamento, com
  // dataVencimento = dataRetorno — vira um lembrete na Agenda/Atividades pro
  // vendedor retomar contato, que pode resultar num novo orçamento.
  dataRetorno         DateTime?
  observacao          String?
  vlrTotal            Float           @default(0)
  ativo               Boolean         @default(true)

  // Autorização de desconto em duas etapas: item com desconto igual ou acima
  // do "% Desc Máximo" da regra trava PDF e efetivação (status aprovado) até
  // alguém com permissão de aprovar autorizar. O vendedor solicita
  // (solicitadoEm/Por, que gera uma Atividade de pendência para o supervisor)
  // e o autorizador libera (autorizadoEm/Por). Autorizado vale para o
  // orçamento como está: mexer nos itens ou nos preços derruba a autorização,
  // senão daria para autorizar 15% e gravar 40% depois.
  descontoSolicitadoEm  DateTime?
  descontoSolicitadoPor String?
  descontoAutorizadoEm  DateTime?
  descontoAutorizadoPor String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  empresa           Empresa            @relation(fields: [empresaId], references: [id])
  cliente           Cliente            @relation(fields: [clienteId], references: [id])
  vendedor          Vendedor           @relation(fields: [vendedorId], references: [id])
  oportunidade      Oportunidade?      @relation(fields: [oportunidadeId], references: [id])
  condicaoPagamento CondicaoPagamento? @relation(fields: [condicaoPagamentoId], references: [id])
  itens             OrcamentoItem[]
  atividades        Atividade[]

  @@unique([empresaId, codigoLegado])
  @@unique([empresaId, numero])
  @@index([empresaId, vendedorId])
  @@index([empresaId, clienteId])
  @@index([empresaId, status])
  @@map("orcamentos")
}

model OrcamentoItem {
  id          String @id @default(uuid())
  empresaId   String
  orcamentoId String
  produtoId   String

  quantidade   Float  @default(1)
  vlrTabela    Float?
  vlrUnitario  Float  @default(0)
  percDesconto Float?
  vlrDesconto  Float  @default(0)
  vlrTotal     Float  @default(0)

  // Regra de desconto aplicável (SZ0 do ERP). Nulo = sem regra própria;
  // a resolução de qual regra vale ainda não existe — por ora é só o vínculo.
  regraDescontoId String?
  // Percentual de comissão apurado na linha (resultado da regra de desconto
  // aplicada). Nulo enquanto não houver cálculo — nada preenche ainda.
  percComissao    Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empresa       Empresa        @relation(fields: [empresaId], references: [id])
  regraDesconto RegraDesconto? @relation(fields: [regraDescontoId], references: [id])
  orcamento     Orcamento      @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)
  produto       Produto        @relation(fields: [produtoId], references: [id], onDelete: Restrict)

  @@index([empresaId, produtoId])
  @@index([orcamentoId])
  @@index([empresaId, regraDescontoId])
  @@map("orcamento_itens")
}

// ------------------------------------------------------------------
// Objetivos (metas comerciais)
// ------------------------------------------------------------------
// Mestre-detalhe (mês/ano/vendedor + linhas por categoria), espelhando as
// tabelas `meta_vendedor_mes`/`meta_vendedor_categoria` do legado — base do
// Dashboard Comercial (realizado vs objetivo). Cadastro editável (não
// read-only como NotaSaida/Item), com o mesmo escopo hierárquico de
// vendedor das demais telas comerciais.
model ObjetivoVendedorMes {
  id           String @id @default(uuid())
  empresaId    String
  vendedorId   String
  codigoLegado Int?

  mes           Int
  ano           Int
  valor         Float   @default(0)
  numeroCliente Float?
  novoCliente   Float?
  tipo          String?
  ativo         Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  empresa    Empresa                     @relation(fields: [empresaId], references: [id])
  vendedor   Vendedor                    @relation(fields: [vendedorId], references: [id])
  categorias ObjetivoVendedorCategoria[]

  @@unique([empresaId, vendedorId, mes, ano])
  @@unique([empresaId, codigoLegado])
  @@index([empresaId, ano, mes])
  @@map("objetivos_vendedor_mes")
}

model ObjetivoVendedorCategoria {
  id                    String @id @default(uuid())
  empresaId             String
  objetivoVendedorMesId String
  categoriaId           String
  codigoLegado          Int?
  valor                 Float  @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  empresa   Empresa             @relation(fields: [empresaId], references: [id])
  objetivo  ObjetivoVendedorMes @relation(fields: [objetivoVendedorMesId], references: [id], onDelete: Cascade)
  categoria Categoria           @relation(fields: [categoriaId], references: [id])

  @@unique([objetivoVendedorMesId, categoriaId])
  @@unique([empresaId, codigoLegado])
  @@map("objetivos_vendedor_categoria")
}

// ------------------------------------------------------------------
// Sistema
// ------------------------------------------------------------------

model AuditLog {
  id            String   @id @default(uuid())
  entidade      String
  entidadeId    String
  acao          String
  usuarioId     String?
  valorAnterior Json?
  valorNovo     Json?
  ip            String?
  userAgent     String?
  criadoEm      DateTime @default(now())

  @@index([entidade, entidadeId])
  @@map("audit_logs")
}

// Parâmetros de política de senha da plataforma — singleton global (id
// sempre "singleton", nunca gerado), sem empresaId/RLS: login e senha são
// globais (um mesmo Usuario acessa várias empresas com a mesma senha), então
// a regra é única para todo o sistema, no mesmo espírito de Modulo/Menu.
model PoliticaSenha {
  id String @id

  tamanhoMinimo   Int     @default(8)
  tamanhoMaximo   Int? // null = sem limite
  exigirMaiuscula Boolean @default(true)
  exigirMinuscula Boolean @default(false)
  exigirNumero    Boolean @default(true)
  exigirEspecial  Boolean @default(false)

  diasParaExpirar         Int? // null/0 = senha nunca expira
  historicoQuantidade     Int  @default(0) // 0 = não valida reuso de senha
  tentativasAntesBloqueio Int  @default(5)
  minutosBloqueio         Int  @default(15)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@map("politica_senha")
}

// Histórico de hashes de senha já usados por cada usuário, só para checar
// reuso (PoliticaSenha.historicoQuantidade). Global, sem RLS, mesmo
// precedente de RefreshToken.
model SenhaHistorico {
  id        String   @id @default(uuid())
  usuarioId String
  senhaHash String
  createdAt DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId, createdAt])
  @@map("senha_historico")
}

// ---------------------------------------------------------------------------
// WhatsApp do vendedor — ver docs/planos/whatsapp-vendedor.md
// ---------------------------------------------------------------------------

enum WhatsappTransporte {
  zapo
  cloud_api
}

enum WhatsappSessaoStatus {
  desconectada
  pareando
  conectada
  banida
}

enum WhatsappDirecao {
  entrada
  saida
}

enum WhatsappTipoMensagem {
  texto
  imagem
  documento
  audio
  video
  localizacao
  contato
  outro
}

enum WhatsappStatusEntrega {
  pendente
  enviada
  entregue
  lida
  erro
}

/**
 * Sessão de WhatsApp de um vendedor — uma conexão viva no worker.
 * `credencialCifrada` é o estado de autenticação devolvido pelo pareamento
 * (AES-256-GCM, como `AgenteCredencial.apiKeyCifrada`). É segredo de verdade:
 * quem tem essa credencial fala pelo WhatsApp do vendedor. Nunca sai da API.
 * `transporte` fica na linha, e não só no parâmetro da empresa, porque a
 * migração para a Cloud API será gradual — sessões antigas continuam no Zapo
 * enquanto as novas já nascem oficiais.
 * `aceiteEm`/`aceiteVersao` registram que o vendedor foi informado de que a
 * conversa com clientes é gravada e visível ao supervisor. A trava que exige o
 * aceite é da Fatia 3 (governança); as colunas nascem aqui porque o aceite
 * acontece no pareamento, que é Fatia 1.
 */
model WhatsappSessao {
  id         String @id @default(uuid())
  empresaId  String
  vendedorId String

  numero     String?
  jid        String?
  status     WhatsappSessaoStatus @default(desconectada)
  transporte WhatsappTransporte   @default(zapo)

  credencialCifrada String?   @db.Text
  ultimaConexao     DateTime?
  ultimoErro        String?

  aceiteEm     DateTime?
  aceiteVersao String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  empresa   Empresa            @relation(fields: [empresaId], references: [id])
  vendedor  Vendedor           @relation(fields: [vendedorId], references: [id])
  conversas WhatsappConversa[]

  @@unique([empresaId, vendedorId])
  @@index([empresaId, status])
  @@map("whatsapp_sessoes")
}

/**
 * Contato do WhatsApp, identificado pelo `jid` (ex.: `5567999998888@s.whatsapp.net`).
 * `clienteId` é o que separa atendimento de conversa pessoal: sem vínculo, as
 * mensagens **não são persistidas** (ver privacidade no plano). `ignorado`
 * marca o contato que o vendedor declarou como não-cliente, para a tela parar
 * de perguntar.
 */
model WhatsappContato {
  id        String @id @default(uuid())
  empresaId String

  jid                 String
  nomeExibicao        String?
  telefoneNormalizado String?

  clienteId    String?
  vinculadoPor String?
  vinculadoEm  DateTime?
  ignorado     Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empresa   Empresa            @relation(fields: [empresaId], references: [id])
  cliente   Cliente?           @relation(fields: [clienteId], references: [id])
  conversas WhatsappConversa[]

  @@unique([empresaId, jid])
  @@index([empresaId, telefoneNormalizado])
  @@index([empresaId, clienteId])
  @@map("whatsapp_contatos")
}

/**
 * Conversa entre uma sessão (vendedor) e um contato. `clienteId` é
 * desnormalizado do contato para permitir "todas as conversas deste cliente"
 * sem passar por contato — é a consulta do supervisor.
 */
model WhatsappConversa {
  id        String  @id @default(uuid())
  empresaId String
  sessaoId  String
  contatoId String
  clienteId String?

  ultimaMensagemEm DateTime?
  naoLidas         Int       @default(0)
  arquivada        Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empresa   Empresa                @relation(fields: [empresaId], references: [id])
  // Restrict, não Cascade: a conversa com o cliente é da empresa, não do
  // aparelho. Vendedor desligado, troca de celular ou limpeza de sessão não
  // podem levar o histórico junto — e com Cascade isso aconteceria em
  // silêncio, num DELETE que ninguém associaria a perder atendimento.
  sessao    WhatsappSessao         @relation(fields: [sessaoId], references: [id], onDelete: Restrict)
  contato   WhatsappContato        @relation(fields: [contatoId], references: [id], onDelete: Restrict)
  cliente   Cliente?               @relation(fields: [clienteId], references: [id])
  mensagens WhatsappMensagem[]
  acoes     WhatsappAcaoRegistro[]

  @@unique([empresaId, sessaoId, contatoId])
  @@index([empresaId, clienteId])
  @@index([empresaId, sessaoId, ultimaMensagemEm])
  @@map("whatsapp_conversas")
}

/**
 * Mensagem trocada. `externoId` é o id do WhatsApp, e a unicidade por conversa
 * é o que torna o recebimento **idempotente**: na reconexão o provedor reenvia
 * o que já foi entregue, e o mesmo id não pode virar duas linhas.
 * A unicidade é por conversa (e não global) porque o id do WhatsApp só é único
 * dentro do par remetente/destinatário.
 */
model WhatsappMensagem {
  id         String @id @default(uuid())
  empresaId  String
  conversaId String

  externoId String
  direcao   WhatsappDirecao
  tipo      WhatsappTipoMensagem @default(texto)

  conteudo    String? @db.Text
  arquivoUrl  String?
  arquivoNome String?
  arquivoMime String?

  // Preenchido só na saída: qual usuário do sistema mandou.
  enviadaPor    String?
  statusEntrega WhatsappStatusEntrega @default(pendente)
  respondeuA    String?

  criadaEm DateTime @default(now())

  empresa  Empresa          @relation(fields: [empresaId], references: [id])
  conversa WhatsappConversa @relation(fields: [conversaId], references: [id], onDelete: Cascade)

  @@unique([empresaId, conversaId, externoId])
  @@index([empresaId, conversaId, criadaEm])
  @@map("whatsapp_mensagens")
}

/**
 * O que foi disparado de dentro da conversa (orçamento gerado, visita
 * agendada, boleto reenviado). É o que permite medir se a ferramenta vende.
 * Os ids de destino são colunas simples, **sem relação Prisma**, de propósito:
 * isto é registro de auditoria e precisa sobreviver à remoção do orçamento ou
 * da atividade que originou.
 */
model WhatsappAcaoRegistro {
  id         String @id @default(uuid())
  empresaId  String
  conversaId String

  acao            String
  orcamentoId     String?
  atividadeId     String?
  tituloReceberId String?
  detalhe         Json?

  executadaPor String?
  criadaEm     DateTime @default(now())

  empresa  Empresa          @relation(fields: [empresaId], references: [id])
  conversa WhatsappConversa @relation(fields: [conversaId], references: [id], onDelete: Cascade)

  @@index([empresaId, conversaId, criadaEm])
  @@map("whatsapp_acoes")
}

/**
 * Configuração do WhatsApp por empresa (singleton, padrão do AgenteConfig).
 *
 * Separada da sessão de propósito: a sessão é do vendedor e é volátil (cai,
 * repareia, é banida); isto aqui é decisão da empresa e vale para todas elas.
 *
 * `workerUrl` aponta para o serviço que mantém as conexões de pé
 * (`apps/whatsapp-worker`). Fica em configuração e não em env por causa da
 * troca de transporte: a Cloud API não tem worker, e a migração é gradual.
 */
model WhatsappConfig {
  id        String  @id @default(uuid())
  empresaId String  @unique
  ativo     Boolean @default(false)

  transporte WhatsappTransporte @default(zapo)
  workerUrl  String?

  // DDD a usar quando o telefone do cadastro vem sem ele — o que é a regra,
  // não a exceção, nesta base (8 ou 9 dígitos na maioria das linhas). Fica
  // nulo de propósito até alguém configurar: completar número de telefone por
  // dedução manda mensagem para a pessoa errada.
  dddPadrao String?

  // 0 = sem expurgo. A rotina que apaga é da Fatia 3 (governança); a decisão
  // de por quanto tempo guardar é da empresa e nasce aqui.
  retencaoDias Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@map("whatsapp_config")
}
