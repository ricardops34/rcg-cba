  ativo     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  updatedBy String?

  empresa Empresa @relation(fields: [empresaId], references: [id])
  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([empresaId, ativo])
  @@map("portal_cliente_habilitacoes")
}

// Exceção sem RLS: consultada no login antes de haver tenant ativo. Guarda
// somente autenticação e referências; dados de negócio ficam no contato com RLS.
model PortalClienteCredencial {
  id               String    @id @default(uuid())
  empresaId        String
  contatoId        String    @unique
  empresaAlias     String
  emailNormalizado String
  senhaHash        String
  tentativasFalhas Int       @default(0)
  bloqueadoAte     DateTime?
  ultimoLogin      DateTime?
  ativo            Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contato ClienteContato        @relation(fields: [contatoId], references: [id], onDelete: Cascade)
  sessoes PortalClienteSessao[]

  @@unique([empresaAlias, emailNormalizado])
  @@index([empresaId])
  @@map("portal_cliente_credenciais")
}

// Sem RLS: refresh acontece antes de reconstruir o contexto do tenant.
model PortalClienteSessao {
  id           String    @id @default(uuid())
  credencialId String
  tokenHash    String    @unique
  expiresAt    DateTime
  revogadoEm   DateTime?
  ip           String?
  userAgent    String?
  createdAt    DateTime  @default(now())

  credencial PortalClienteCredencial @relation(fields: [credencialId], references: [id], onDelete: Cascade)

  @@index([credencialId, expiresAt])
  @@map("portal_cliente_sessoes")
}

// Sem RLS: registra inclusive tentativas com empresa/e-mail inválidos.
model PortalClienteAcessoLog {
  id        String   @id @default(uuid())
  empresaId String?
  contatoId String?
  email     String
  evento    String
  detalhe   String?
  ip        String?
  userAgent String?
  criadoEm  DateTime @default(now())

  @@index([empresaId, criadoEm])
  @@map("portal_cliente_acessos_log")
}

// De onde partiu a alteração do cadastro de cliente. Todas passam pela mesma
// fila de aprovação — inclusive `integracao`: decisão de 2026-08-14, nenhuma
// origem altera cliente sem alguém com direito aprovar.
enum OrigemAlteracaoCliente {
  manual
  enriquecimento
  integracao
  agente
}

enum StatusAlteracaoCliente {
  pendente
  aprovada
  rejeitada
}

enum StatusHistoricoCliente {
  aplicado
  reprovado
}

/**
 * Solicitação de alteração de cliente: o "de → para" aguardando aprovação.
 * `alteracoes` é um JSON `{ campo: { de, para } }` calculado sempre contra o
 * estado atual do cliente — é o que torna a fila idempotente perante o ERP,
 * que reenvia o mesmo payload a cada sincronização: payload igual ao gravado
 * gera diff vazio e nenhuma solicitação.
 * Tabela volátil (a solicitação se resolve); o rastro permanente é
 * ClienteHistorico.
 */
model ClienteAlteracao {
  id        String                 @id @default(uuid())
  empresaId String
  clienteId String
  origem    OrigemAlteracaoCliente @default(manual)
  status    StatusAlteracaoCliente @default(pendente)

  alteracoes    Json
  justificativa String?

  solicitadoPor String?
  solicitadoEm  DateTime  @default(now())
  analisadoPor  String?
  analisadoEm   DateTime?
  motivoRecusa  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id])
  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  // Índice único parcial (só entre as pendentes) é criado na migration por SQL
  // — o Prisma não modela `WHERE status = 'pendente'`. Uma pendência por
  // cliente **por origem**: o pedido do vendedor e o do ERP não se misturam.
  @@index([empresaId, status])
  @@index([empresaId, clienteId])
  @@map("cliente_alteracoes")
}

/**
 * Log imutável do que efetivamente mudou no cliente, campo a campo. Responde
 * "quem mexeu no limite de crédito deste cliente, quando e por quê" — inclusive
 * para mudanças vindas do ERP.
 */
model ClienteHistorico {
  id            String                 @id @default(uuid())
  empresaId     String
  clienteId     String
  alteracaoId   String?
  campo         String
  // Texto porque o histórico é para leitura humana; o valor tipado vive no
  // cliente, não aqui.
  valorAnterior String?
  valorNovo     String?
  // `origem` é de onde a mudança nasceu (tela, ERP, consulta de CNPJ);
  // `autor` é quem a **aplicou** — ou seja, quem aprovou, e portanto responde
  // por ela. Quem pediu está em ClienteAlteracao.solicitadoPor, alcançável
  // por `alteracaoId`.
  origem        OrigemAlteracaoCliente
  autor         String?
  // `reprovado` é linha de histórico que **não** mudou o cadastro: o campo foi
  // proposto e negado na aprovação campo a campo. Some do cadastro, fica no
  // rastro — senão ninguém saberia que a mudança chegou a ser pedida.
  status        StatusHistoricoCliente @default(aplicado)

  criadoEm DateTime @default(now())

  empresa Empresa @relation(fields: [empresaId], references: [id])
  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([empresaId, clienteId, criadoEm])
  @@map("cliente_historico")
}

enum OrigemSugestaoCompra {
  local
  ia
}

enum AgentePapel {
  usuario
  sistema
  assistente
  ferramenta
}

/**
 * Configuração do agente de IA por empresa (singleton, padrão do
 * OrcamentoConfig). A personalidade e a temperatura são editáveis em tela para
 * ajustar o comportamento sem redeploy.
 * `apiKeyCifrada` é AES-256-GCM (ver `agente-cripto.ts`) — precisa ser
 * reversível, porque a chave é usada para chamar o provedor; não é hash. A
 * chave em claro **nunca** sai da API: a leitura devolve só os últimos 4
 * dígitos, como a tela de parâmetros faz com tipo senha.
 */
model AgenteConfig {
  id        String  @id @default(uuid())
  empresaId String  @unique
  ativo     Boolean @default(false)

  // Provedor ativo. As chaves ficam em AgenteCredencial, uma por provedor,
  // para trocar de provedor não exigir recolar a chave.
  provedor String @default("anthropic")
  baseUrl  String @default("https://api.anthropic.com")
  modelo   String @default("claude-opus-5")

  // Mantidos por compatibilidade com o que já foi gravado antes da tabela de
  // credenciais existir; a leitura prefere AgenteCredencial.
  apiKeyCifrada  String?
  apiKeyUltimos4 String?

  /// Embeddings — a busca semântica das fichas técnicas.
  ///
  /// Configuração **separada** da do chat, e não por capricho: o provedor de
  /// conversa pode não gerar vetor (o Codex por OAuth não gera, a Anthropic não
  /// tem o serviço), e o modelo de embedding é escolhido por dimensão e preço,
  /// não por qualidade de escrita. Vazio = sem busca semântica, e a busca
  /// lexical continua atendendo sozinha.
  embeddingBaseUrl        String?
  embeddingModelo         String?
  embeddingApiKeyCifrada  String?
  embeddingApiKeyUltimos4 String?

  // Identidade e prompt base valem para qualquer provedor: trocar de LLM não
  // pode trocar o nome pelo qual a equipe conhece o assistente nem as regras
  // de resposta.
  nomeAgente         String  @default("Assistente")
  // Primeira fala de toda conversa nova. Não vai ao modelo: é texto da
  // empresa, escrito por gente, e o que ele faz é dizer ao vendedor o que
  // pedir — a tela em branco não ensina isso.
  mensagemBoasVindas String? @db.Text
  systemPrompt       String? @db.Text
  temperatura        Float   @default(0.3)
  maxTokens          Int     @default(2048)

  // Teto de voltas do laço de ferramentas: sem ele, um modelo em loop de
  // tool_calls consome tokens (pagos) indefinidamente.
  maxIteracoesFerramentas Int @default(5)
  historicoMensagens      Int @default(20)

  /// Aceite dos termos para **editar o comportamento** das ferramentas.
  ///
  /// Reescrever o prompt de uma ferramenta muda como o assistente fala com
  /// cliente e equipe, e o efeito não aparece numa tela — aparece numa conversa,
  /// depois. O aceite é o momento em que alguém assume isso por escrito, e a
  /// data diz desde quando.
  ///
  /// Nulo = ninguém aceitou ainda, e a API recusa a edição dos textos. Ligar ou
  /// desligar uma ferramenta continua liberado: aquilo é configuração, não
  /// redação.
  termosPromptAceitosEm  DateTime?
  termosPromptAceitosPor String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@map("agente_config")
}

/**
 * Chave de API por provedor. Existe para tornar a troca de provedor um clique:
 * alternar entre Claude e Groq não pode exigir recolar a chave do outro.
 * `modelo` guarda o último modelo usado naquele provedor, para a volta trazer
 * a configuração de antes em vez do padrão.
 */
/**
 * Governança das ferramentas do agente, por empresa.
 * A **implementação** de cada ferramenta continua no código
 * (`AgenteToolsService`) — o banco não executa nada. O que mora aqui é o que a
 * empresa decide sobre ela: se está ligada, como ela se apresenta ao modelo, e
 * quais perfis podem usá-la.
 * A linha é criada por sincronização a partir do catálogo do código, então
 * ferramenta nova aparece desligada/ligada conforme o padrão dela e ferramenta
 * removida do código simplesmente deixa de ser sincronizada.
 */
model AgenteFerramenta {
  id        String @id @default(uuid())
  empresaId String
  /**
   * Chave estável, igual ao `nome` no catálogo do código (ex.: buscar_cliente).
   */
  chave     String

  ativa Boolean @default(true)

  // Sobrescritas opcionais do texto que vai ao modelo. Nulo = usa o do código.
  // Existem porque a descrição é o que ensina o modelo *quando* usar a
  // ferramenta, e isso muda com o vocabulário de cada operação.
  nome      String?
  descricao String? @db.Text

  /// **Como a ferramenta deve se comportar** — o pedaço de prompt que vai ao
  /// modelo junto do catálogo, quando esta ferramenta está disponível.
  ///
  /// Separado da `descricao` porque respondem a perguntas diferentes: a
  /// descrição ensina *quando* chamar, isto ensina *como se portar* ao usar
  /// ("confirme qual antes de mandar", "não prometa antes de a ferramenta
  /// responder").
  ///
  /// Fica no cadastro, e não no código, para a empresa poder ajustar sem
  /// deploy — decisão do usuário em 2026-09-05. Vale insistir no limite disso:
  /// **comportamento é prompt, e prompt não é barreira**. Nada que dependa
  /// deste texto pode ser a única coisa entre alguém e um dado; o que protege
  /// está no recorte, no catálogo e nas guardas de código.
  instrucoes String? @db.Text

  /// Versão de prompt do sistema que esta empresa segue.
  ///
  /// Nulo = acompanha a mais recente, que e o que a maioria espera de uma
  /// atualizacao. Escolher trava numa versao: a empresa que testou e preferiu
  /// a anterior nao e arrastada pela proxima.
  ///
  /// Não confundir com `descricao`/`instrucoes`: aquilo é texto reescrito pela
  /// empresa e vence a versão. Isto é qual texto **do sistema** seguir quando
  /// não há reescrita.
  versaoPrompt String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  updatedBy String?

  empresa Empresa                  @relation(fields: [empresaId], references: [id])
  perfis  AgenteFerramentaPerfil[]

  @@unique([empresaId, chave])
  @@map("agente_ferramentas")
}

/**
 * Perfis liberados para uma ferramenta.
 * **Restringe, nunca amplia.** A permissão declarada no código
 * (`Ferramenta.permissao`, ex.: `clientes.visualizar`) continua sendo checada
 * de qualquer forma — esta tabela é um filtro adicional. Sem nenhuma linha, a
 * ferramenta vale para todos os perfis que passem naquela permissão, que é o
 * comportamento que existia antes desta tabela.
 */
/// Trilha das alterações no cadastro de ferramentas.
///
/// Existe porque o comportamento do assistente virou campo editável: sem
/// registro, "o assistente começou a responder diferente" seria impossível de
/// investigar — ninguém saberia se alguém reescreveu o prompt, quando, nem o
/// que estava lá antes.
///
/// Guarda o **antes e o depois**, e não só o depois: o valor anterior é o que
/// permite desfazer e o que explica a mudança de comportamento.
model AgenteFerramentaAuditoria {
  id        String @id @default(uuid())
  empresaId String

  /// Chave da ferramenta, igual à do catálogo.
  chave String
  /// Qual campo mudou: `ativa`, `nome`, `descricao`, `instrucoes`, `perfis`.
  campo String

  /// Texto, mesmo para booleano e lista: o log precisa continuar legível
  /// depois que o formato do campo mudar. Mesma escolha de
  /// `plataforma_auditoria`.
  valorAnterior String? @db.Text
  valorNovo     String? @db.Text

  /// Sem FK: a trilha tem de sobreviver à exclusão do usuário, senão perde
  /// justamente o registro de quem saiu. O e-mail vai junto pelo mesmo motivo.
  autorId    String?
  autorEmail String?

  criadoEm DateTime @default(now())

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@index([empresaId, chave, criadoEm])
  @@index([empresaId, criadoEm])
  @@map("agente_ferramenta_auditoria")
}

model AgenteFerramentaPerfil {
  id           String @id @default(uuid())
  empresaId    String
  ferramentaId String
  perfilId     String

  createdAt DateTime @default(now())

  ferramenta AgenteFerramenta @relation(fields: [ferramentaId], references: [id], onDelete: Cascade)
  perfil     Perfil           @relation(fields: [perfilId], references: [id])

  @@unique([ferramentaId, perfilId])
  @@map("agente_ferramenta_perfis")
}

model AgenteCredencial {
  id        String @id @default(uuid())
  empresaId String
  provedor  String

  // Nulos quando o provedor autentica por OAuth (Codex): lá não existe chave,
  // existe um par de tokens que expira.
  apiKeyCifrada  String?
  apiKeyUltimos4 String?
  modelo         String?

  // --- OAuth (provedor `codex`) ---
  // Os dois tokens são cifrados com a mesma AGENTE_IA_CRYPTO_KEY da chave de
  // API: são credenciais reutilizáveis, então hash não serve.
  accessTokenCifrado  String?
  refreshTokenCifrado String?
  /**
   * Vai no header ChatGPT-Account-ID; sem ele o backend responde 401/403.
   */
  contaId             String?
  contaEmail          String?
  /**
   * Expiração do access token — a renovação dispara antes disso.
   */
  tokenExpiraEm       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  updatedBy String?

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@unique([empresaId, provedor])
  @@map("agente_credenciais")
}

model AgenteConversa {
  id        String  @id @default(uuid())
  empresaId String
  usuarioId String
  titulo    String?
  arquivada Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empresa   Empresa          @relation(fields: [empresaId], references: [id])
  mensagens AgenteMensagem[]

  @@index([empresaId, usuarioId, updatedAt])
  @@map("agente_conversas")
}

/**
 * Cada passo da conversa, inclusive as chamadas de ferramenta — é aqui que
 * mora a auditoria: qual ferramenta o agente quis executar, com que argumentos
 * exatos, e quem confirmou.
 * `pendente` marca a ação de escrita que ainda não foi confirmada pelo
 * usuário; até `confirmadaEm` ser preenchida, nada foi gravado no sistema.
 */
model AgenteMensagem {
  id         String      @id @default(uuid())
  empresaId  String
  conversaId String
  papel      AgentePapel

  conteudo   String? @db.Text
  ferramenta String?
  argumentos Json?
  resultado  Json?

  pendente      Boolean   @default(false)
  confirmadaEm  DateTime?
  confirmadaPor String?

  tokensEntrada Int?
  tokensSaida   Int?

  criadaEm DateTime @default(now())

  empresa  Empresa        @relation(fields: [empresaId], references: [id])
  conversa AgenteConversa @relation(fields: [conversaId], references: [id], onDelete: Cascade)

  @@index([empresaId, conversaId, criadaEm])
  @@map("agente_mensagens")
}

/**
 * Sugestão de compra gerada para um cliente: produto que clientes semelhantes
 * compram e ele não.
 * Guardar o resultado não é cache por preguiça — é requisito. A geração por IA
 * é paga e lenta demais para rodar a cada abertura de tela, e a linha gravada é
 * o que permite auditar **o que a IA sugeriu** depois.
 * `origem` distingue o motor determinístico (`local`, SQL sobre a cesta de
 * compras e o CNAE) da recomendação do modelo (`ia`). `loteId` agrupa o que
 * saiu de uma mesma execução, para substituir um lote inteiro sem apagar o
 * outro motor.
 * Nada de valor ou nome de cliente vai para a IA — ver `anonimizar.ts`. Aqui
 * só voltam códigos de produto, que são reenriquecidos na leitura.
 */
model SugestaoCompraGerada {
  id        String               @id @default(uuid())
  empresaId String
  clienteId String
  produtoId String
  origem    OrigemSugestaoCompra @default(local)

  ordem  Int
  score  Float?
  motivo String?
  modelo String?
  loteId String

  geradaEm DateTime @default(now())

  empresa Empresa @relation(fields: [empresaId], references: [id])
  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  produto Produto @relation(fields: [produtoId], references: [id])

  @@unique([clienteId, produtoId, origem])
  @@index([empresaId, clienteId, origem, ordem])
  @@index([empresaId, loteId])
  @@map("sugestoes_compra")
}

// Define, por empresa, quais campos do cadastro de Cliente o formulário
// interno permite alterar (ex.: travar campos que vêm do ERP). Sem linha
// para um campo = editável por padrão — ver ClienteCampoConfigService.
model ClienteCampoConfig {
  id        String  @id @default(uuid())
  empresaId String
  campo     String
  editavel  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@unique([empresaId, campo])
  @@map("cliente_campo_config")
}

/// Situação da assinatura de uma empresa no SaaS.
///
/// `teste` e `ativa` entram no sistema; `suspensa` e `cancelada` não. A
/// diferença entre as duas últimas é de intenção, não de efeito: suspensa é
/// reversível (inadimplência, pedido do cliente), cancelada encerra a relação
/// — e as duas aparecem diferente para quem administra a plataforma.
enum SituacaoEmpresa {
  teste
  ativa
  suspensa
  cancelada
}

/// O que o administrador da plataforma fez. Log global do SaaS: não tem
/// `empresaId` no sentido de RLS — a empresa aqui é o **alvo** da ação, não a
/// dona do registro. Por isso a tabela fica fora do isolamento por empresa e
/// só o administrador da plataforma a lê.
model PlataformaAuditoria {
  id String @id @default(uuid())

  /// Quem executou. Sem FK: o log tem de sobreviver à exclusão do usuário,
  /// senão perde justamente o registro de quem saiu.
  usuarioId    String
  usuarioEmail String

  /// Empresa afetada, quando a ação tem uma. Nulo em ação sobre usuário. O
  /// nome vai junto porque o log precisa continuar legível se a empresa for
  /// excluída.
  empresaId          String?
  empresaRazaoSocial String?

  /// Verbo do domínio: `empresa.criada`, `empresa.situacao_alterada`,
  /// `empresa.limite_alterado`, `admin.promovido`, `admin.revogado`.
  acao String

  /// O antes e o depois, quando fazem sentido. Guardados como texto para o
  /// log não depender do formato de nenhuma entidade — ele precisa continuar
  /// legível depois que o schema mudar.
  valorAnterior String?
  valorNovo     String?

  createdAt DateTime @default(now())

  @@index([empresaId, createdAt])
  @@index([createdAt])
  @@map("plataforma_auditoria")
}

// Parâmetros do sistema por empresa. A validade do orçamento e a política de
// senha moram aqui (ORCAMENTO_DIAS_VALIDADE, SENHA_*): as duas tiveram tela
// própria e foram centralizadas em Administração > Parâmetros.
enum TipoParametro {
  texto
  numero
  booleano
  data
  senha
}

// Parâmetros do sistema por empresa, no formato clássico de tabela de
// parâmetros de ERP (uma linha por parâmetro, com tipo e conteúdo em texto).
// Centraliza o que antes ficava espalhado em telas próprias de Administração.
//
// conteudo é sempre texto: o campo `tipo` diz como interpretá-lo (ver
// ParametrosService.valorDe, que converte e valida). Parâmetro de tipo
// `senha` nunca tem o conteúdo devolvido pela API.
model ParametroEmpresa {
  id        String        @id @default(uuid())
  empresaId String
  parametro String
  tipo      TipoParametro @default(texto)
  // Limite de caracteres do conteúdo (texto/senha) ou de dígitos (numero).
  tamanho   Int?
  conteudo  String?
  descricao String?
  ativo     Boolean       @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@unique([empresaId, parametro])
  @@index([empresaId, parametro])
  @@map("parametros_empresa")
}

// Só o contador da numeração do orçamento — os parâmetros de negócio (dias
// de validade) migraram para ParametroEmpresa.
model OrcamentoConfig {
  id           String @id @default(uuid())
  empresaId    String @unique
  // Contador do Orcamento.numero. Incrementado por um INSERT ... ON CONFLICT
  // DO UPDATE (ver proximoNumeroOrcamento) — atômico, então dois vendedores
  // gravando ao mesmo tempo nunca pegam o mesmo número.
  ultimoNumero Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  updatedBy String?

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@map("orcamento_config")
}

// ------------------------------------------------------------------
// Cadastros auxiliares
// ------------------------------------------------------------------
// Dois grupos (decisão registrada em docs/planos): os geográficos/fiscais
// (Pais, Estado, Municipio, Cep, Cnae) são referência universal compartilhada
// entre as empresas — sem empresaId e sem RLS, como Modulo/Menu. Os de
// negócio (Categoria, CondicaoPagamento, Armazem) são por empresa com RLS,
// como Produto. codigoErp é a chave natural de upsert dos imports do legado
// e o ponto de amarração dos futuros módulos (Estoque, NF Saída, Títulos).

model Pais {
  id        String  @id @default(uuid())
  codigoErp String?
  nome      String
  sigla     String?
  comexId   String?
  ativo     Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  @@unique([codigoErp])
  @@map("paises")
}

model Estado {
  id         String  @id @default(uuid())
  codigoErp  String?
  sigla      String
  descricao  String
  codigoIbge String?
  ativo      Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  municipios Municipio[]
  ceps       Cep[]

  @@unique([sigla])
  @@map("estados")
}

model Municipio {
  id         String  @id @default(uuid())
  estadoId   String?
  codigoErp  String?
  descricao  String
  codigoIbge String?
  ativo      Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  estado Estado? @relation(fields: [estadoId], references: [id])
  ceps   Cep[]

  @@unique([codigoErp])
  // Chave natural do sync do IBGE e do casamento com o município que a
  // MinhaReceita/ViaCEP devolvem por código. Nulo é permitido (Postgres não
  // colide NULLs no índice único) — município cadastrado à mão fica de fora.
  @@unique([codigoIbge])
  @@index([descricao])
  @@map("municipios")
}

// Cache de consultas de CEP (o legado alimentava via serviço dos Correios —
// campo `origem` guarda a procedência da consulta).
model Cep {
  id          String  @id @default(uuid())
  cep         String
  estadoId    String?
  municipioId String?
  bairro      String?
  endereco    String?
  latitude    Float?
  longitude   Float?
  origem      String?
  ativo       Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  estado    Estado?    @relation(fields: [estadoId], references: [id])
  municipio Municipio? @relation(fields: [municipioId], references: [id])

  @@unique([cep])
  @@map("ceps")
}

// Referência de CNAEs. Vinha vazia do legado — quem popula é o `sync-ibge.ts`
// (subclasses da API do IBGE), então aqui `codigoErp` guarda o código da
// subclasse (7 dígitos) na fonte oficial, e não um código de ERP.
model Cnae {
  id        String  @id @default(uuid())
  codigoErp String?
  secao     String?
  divisao   String?
  grupo     String?
  classe    String?
  subclasse String?
  descricao String
  ativo     Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  clientes ClienteCnae[]

  @@unique([codigoErp])
  @@map("cnaes")
}

// CNAEs de um cliente (principal + secundárias), apontando para a referência
// `cnaes`. `principal` distingue o CNAE fiscal principal — o legado não tinha
// essa marca, a MinhaReceita tem (`cnae_fiscal` × `cnaes_secundarias`).
//
// É o eixo de afinidade da sugestão de compra: clientes do mesmo ramo tendem a
// comprar o mesmo conjunto de produtos.
model ClienteCnae {
  id        String  @id @default(uuid())
  empresaId String
  clienteId String
  cnaeId    String
  principal Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  empresa Empresa @relation(fields: [empresaId], references: [id])
  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  cnae    Cnae    @relation(fields: [cnaeId], references: [id])

  @@unique([clienteId, cnaeId])
  @@index([empresaId, clienteId])
  @@index([empresaId, cnaeId])
  @@map("cliente_cnaes")
}

// Categorias e subcategorias de produto na mesma tabela (auto-referência via
// categoriaPaiId), unificando as tabelas categoria/sub_categoria do legado —
// os cod_erp dos dois níveis não colidem. `usado` replica o flag S/N do
// legado (só existe no nível raiz; null nas subcategorias).
model Categoria {
  id             String   @id @default(uuid())
  empresaId      String
  categoriaPaiId String?
  codigoErp      String
  chave          String? // chave de integração (X2_UNICO); codigoErp é informativo
  descricao      String
  usado          Boolean?
  ativo          Boolean  @default(true)

  // Regra de desconto aplicável (SZ0 do ERP). Nulo = sem regra própria;
  // a resolução de qual regra vale ainda não existe — por ora é só o vínculo.
  regraDescontoId String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  empresa       Empresa        @relation(fields: [empresaId], references: [id])
  regraDesconto RegraDesconto? @relation(fields: [regraDescontoId], references: [id])
  categoriaPai  Categoria?     @relation("CategoriaSubcategoria", fields: [categoriaPaiId], references: [id])
  subcategorias Categoria[]    @relation("CategoriaSubcategoria")

  produtos                   Produto[]                   @relation("ProdutoCategoria")
  produtosSub                Produto[]                   @relation("ProdutoSubCategoria")
  objetivosVendedorCategoria ObjetivoVendedorCategoria[]

  @@unique([empresaId, chave])
  @@index([empresaId, codigoErp])
  @@index([empresaId, descricao])
  @@index([empresaId, regraDescontoId])
  @@map("categorias")
}

model CondicaoPagamento {
  id        String  @id @default(uuid())
  empresaId String
  codigoErp String
  chave     String? // chave de integração (X2_UNICO); codigoErp é informativo
  descricao String
  forma     String?
  ativo     Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  empresa      Empresa       @relation(fields: [empresaId], references: [id])
  notasSaida   NotaSaida[]
  notasEntrada NotaEntrada[]
  orcamentos   Orcamento[]
  clientes     Cliente[]

  @@unique([empresaId, chave])
  @@index([empresaId, codigoErp])
  @@map("condicoes_pagamento")
}

model Armazem {
  id        String  @id @default(uuid())
  empresaId String
  codigoErp String
  chave     String? // chave de integração (X2_UNICO); codigoErp é informativo
  descricao String
  ativo     Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  empresa           Empresa           @relation(fields: [empresaId], references: [id])
  produtos          Produto[]
  estoques          Estoque[]
  notasEntradaItens NotaEntradaItem[]

  @@unique([empresaId, chave])
  @@index([empresaId, codigoErp])
  @@map("armazens")
}

// Tabela de preços — cabeçalho. Espelha `tabela_preco` do legado; campos
// nunca usados no legado (filial_id, system_unit_id, utiliza) foram
// descartados (sempre NULL no dump).
model TabelaPreco {
  id        String    @id @default(uuid())
  empresaId String
  codigoErp String
  chave     String? // chave de integração (X2_UNICO); codigoErp é informativo
  descricao String
  dtInicio  DateTime?
  dtFim     DateTime?
  ativo     Boolean   @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  empresa  Empresa           @relation(fields: [empresaId], references: [id])
  itens    TabelaPrecoItem[]
  clientes Cliente[]

  @@unique([empresaId, chave])
  @@index([empresaId, codigoErp])
  @@index([empresaId, descricao])
  @@map("tabelas_preco")
}

// Item (produto + preço) de uma tabela de preço. empresaId denormalizado
// (mesmo padrão de NotaSaidaItem) para RLS/consulta sem join na tabela mãe.
// chave é a chave de upsert da integração, única dentro da tabela de preço
// (linhas criadas manualmente ficam com chave = null).
model TabelaPrecoItem {
  id            String  @id @default(uuid())
  empresaId     String
  tabelaPrecoId String
  produtoId     String
  // Ver NotaSaida.chave.
  chave         String? // chave de integração (X2_UNICO), única dentro do cabeçalho
  preco         Float
  ativo         Boolean @default(true)

  // Regra de desconto aplicável (SZ0 do ERP). Nulo = sem regra própria;
  // a resolução de qual regra vale ainda não existe — por ora é só o vínculo.
  regraDescontoId String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  empresa       Empresa        @relation(fields: [empresaId], references: [id])
  regraDesconto RegraDesconto? @relation(fields: [regraDescontoId], references: [id])
  tabelaPreco   TabelaPreco    @relation(fields: [tabelaPrecoId], references: [id], onDelete: Cascade)
  produto       Produto        @relation(fields: [produtoId], references: [id], onDelete: Restrict)

  @@unique([tabelaPrecoId, chave])
  @@index([tabelaPrecoId, produtoId])
  @@index([empresaId, produtoId])
  @@index([empresaId, regraDescontoId])
  @@map("tabela_preco_itens")
}

// Regra de desconto (SZ0 do ERP): teto de desconto e escalonamento da
// comissão do vendedor conforme o desconto concedido. Mestre-detalhe —
// o cabeçalho traz os limites e a comissão cheia, e as faixas dizem quanto
// dessa comissão sobra em cada intervalo de desconto.
//
// Por ora é só cadastro: nada no orçamento consulta estas regras ainda, e
// elas não estão vinculadas a produto/categoria/cliente.
model RegraDesconto {
  id        String  @id @default(uuid())
  empresaId String
  // Z0_CODIGO — chave de upsert da API de integração; null quando a regra
  // nasce na tela do CRM (mesmo padrão de Orcamento.codigoErp).
  codigoErp String?
  chave     String? // chave de integração (X2_UNICO); codigoErp é informativo
  descricao String

  // Z0_DESCAUT ("% Desc. Aut"): percentual de desconto autorizado.
  percDescontoAutorizado Float   @default(0)
  // Z0_PERMAX ("% Desc Max"): percentual de desconto máximo da regra.
  percDescontoMaximo     Float   @default(0)
  // Z0_COMIS: comissão cheia da regra, sobre a qual as faixas aplicam a base.
  percComissao           Float   @default(0)
  // Z0_PADRAO: regra usada quando nenhuma outra se aplica.
  padrao                 Boolean @default(false)
  ativo                  Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  empresa Empresa              @relation(fields: [empresaId], references: [id])
  faixas  RegraDescontoFaixa[]

  // Quem aponta pra esta regra. A precedência entre eles (item > tabela de
  // preço > produto > categoria) ainda não está implementada.
  categorias       Categoria[]
  produtos         Produto[]
  tabelaPrecoItens TabelaPrecoItem[]
  notasSaidaItens  NotaSaidaItem[]
  orcamentoItens   OrcamentoItem[]

  @@unique([empresaId, chave])
  @@index([empresaId, codigoErp])
  @@index([empresaId, descricao])
  @@map("regras_desconto")
}

// Faixa de desconto de uma regra (uma linha Z0_SEQ da SZ0): dentro do
// intervalo percInicial..percFinal, o vendedor recebe percBaseComissao% da
// comissão cheia da regra. empresaId denormalizado para RLS sem join na
// tabela mãe, como TabelaPrecoItem.
model RegraDescontoFaixa {
  id              String @id @default(uuid())
  empresaId       String
  regraDescontoId String

  sequencia        Int
  percInicial      Float @default(0)
  percFinal        Float @default(0)
  percBaseComissao Float @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  empresa       Empresa       @relation(fields: [empresaId], references: [id])
  regraDesconto RegraDesconto @relation(fields: [regraDescontoId], references: [id], onDelete: Cascade)

  @@unique([regraDescontoId, sequencia])
  @@index([empresaId, regraDescontoId])
  @@map("regras_desconto_faixas")
}

// ------------------------------------------------------------------
// Movimento comercial (consulta)
// ------------------------------------------------------------------
// Espelhos do ERP (estoque, notas fiscais de saída e títulos a receber): a
// API de tela só expõe listagem/detalhe — os dados entram pela API de
// integração, que o Protheus alimenta. chave guarda a chave de identidade
// que o ERP escolheu para o registro (X2_UNICO) e é a chave de upsert
// idempotente: a plataforma não interpreta o valor, só o usa para reconhecer o
// que já recebeu. codigoErp é só informativo (título "Código" na tela). Notas, itens e títulos carregam vendedorId para o mesmo escopo
// hierárquico de Clientes.

model Estoque {
  id        String @id @default(uuid())
  empresaId String
  codigoErp String
  chave     String? // chave de integração (X2_UNICO); codigoErp é informativo
  produtoId String
  armazemId String

  saldo        Float     @default(0)
  reserva      Float?
  custo        Float?
  ultimoPreco  Float?
  ultimaCompra DateTime?
  dataEnvio    DateTime  @default(now())

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  empresa Empresa @relation(fields: [empresaId], references: [id])
  produto Produto @relation(fields: [produtoId], references: [id])
  armazem Armazem @relation(fields: [armazemId], references: [id])

  @@unique([empresaId, produtoId, armazemId])
  @@unique([empresaId, chave])
  @@index([empresaId, codigoErp])
  @@index([empresaId, armazemId])
  @@map("estoques")
}

model NotaSaida {
  id                  String  @id @default(uuid())
  empresaId           String
  // Número da nota no ERP, informativo (título "Código" na tela).
  codigoErp           String?
  // Chave de identidade do registro no ERP (X2_UNICO): o valor que o Protheus
  // manda para dizer "esta é a mesma nota que já mandei antes". A plataforma
  // não interpreta o conteúdo — guarda, indexa e usa no upsert do POST.
  chave               String?
  clienteId           String?
  // Só na devolução de compra (tipo 'D'): o destinatário é um fornecedor, e
  // `clienteId` fica nulo. Espelho da NotaEntrada, onde a devolução de venda
  // aponta para o cliente.
  fornecedorId        String?
  vendedorId          String?
  condicaoPagamentoId String?

  numero        String
  serie         String?
  especieFiscal String?
  tipo          String?
  dtEmissao     DateTime?
  ano           Int?
  mes           Int?

  vlrBruto      Float @default(0)
  vlrMercadoria Float @default(0)
  vlrItens      Float @default(0)
  vlrDesconto   Float @default(0)
  vlrIcms       Float @default(0)
  vlrIpi        Float @default(0)
  vlrFrete      Float @default(0)
  vlrDevolucao  Float @default(0)

  chaveNfe String?
  dtNfe    DateTime?
  mensagem String?
  comodato Boolean   @default(false)
  ativo    Boolean   @default(true)

  // ---- 2ª via de DANFE (ver docs/planos/segunda-via-danfe-boleto.md) ----
  // O XML autorizado vive na tabela acessória `nota_saida_xml`, e não numa
  // coluna daqui: o Prisma seleciona todas as colunas quando não há `select`
  // explícito, e tanto a listagem de notas quanto a Posição de Cliente (que
  // carrega o histórico inteiro do cliente, sem paginar) passariam a arrastar
  // megabytes de XML que ninguém pediu.
  //
  // Estes três metadados ficam aqui porque são curtos e a **tela** usa:
  // `xmlRecebidoEm` não-nulo é o que responde "tem 2ª via?" sem tocar no XML.
  //
  // O DANFE **não** é guardado — é renderizado sob demanda a partir do XML.
  // Cachear o PDF de algo barato de refazer só criaria arquivo velho com
  // layout antigo.
  xmlRecebidoEm DateTime?
  // Protocolo de autorização (infProt/nProt) e situação da nota na SEFAZ:
  // "autorizada", "cancelada" ou "denegada". A ficha impressa avisa quando a
  // nota não está mais válida — mandar DANFE de nota cancelada para o cliente
  // é o tipo de erro que ninguém percebe até a fiscalização.
  protocoloNfe  String?
  situacaoNfe   String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  empresa           Empresa            @relation(fields: [empresaId], references: [id])
  cliente           Cliente?           @relation(fields: [clienteId], references: [id])
  fornecedor        Fornecedor?        @relation(fields: [fornecedorId], references: [id])
  vendedor          Vendedor?          @relation(fields: [vendedorId], references: [id])
  condicaoPagamento CondicaoPagamento? @relation(fields: [condicaoPagamentoId], references: [id])
  itens             NotaSaidaItem[]
  xml               NotaSaidaXml?

  @@unique([empresaId, chave])
  @@index([empresaId, codigoErp])
  @@index([empresaId, numero])
  @@index([empresaId, vendedorId, ano, mes])
  @@index([empresaId, clienteId])
  @@index([empresaId, fornecedorId])
  @@index([empresaId, dtEmissao])
  @@map("notas_saida")
}

/**
 * O XML autorizado da NF-e, de onde o DANFE é renderizado
 * (ver `docs/planos/segunda-via-danfe-boleto.md`).
 * Tabela acessória, e não coluna em `notas_saida`, por uma razão medida: o
 * Prisma traz todas as colunas quando não há `select` explícito, e as duas
 * consultas de nota do sistema não têm — a listagem paginada e a Posição de
 * Cliente, que carrega o histórico inteiro do cliente de uma vez. Uma coluna
 * de XML ali faria toda abertura de tela puxar megabytes que ninguém pediu, e
 * a armadilha ficaria armada para o próximo `findMany` que alguém escrevesse.
 * Aqui o XML só é lido por quem pede a 2ª via. `conteudo` é TEXT: o TOAST do
 * Postgres tira o valor de dentro da linha e comprime sozinho (~5 a 8x em
 * XML), então não há compressão em código para manter.
 * Um XML por nota (`notaSaidaId` único). Reenvio do ERP substitui o anterior:
 * a nota autorizada é uma só, e guardar versões antigas de um documento
 * fiscal que foi corrigido só cria dúvida sobre qual vale.
 */
model NotaSaidaXml {
  id          String @id @default(uuid())
  empresaId   String
  notaSaidaId String @unique

  conteudo     String
  // Tamanho em bytes do que foi recebido — a tela de operação responde
  // "o ERP mandou mesmo?" sem precisar ler o XML inteiro do banco.
  tamanhoBytes Int

  recebidoEm  DateTime @default(now())
  // Chave de API da integração que enviou (ver `autorIntegracao`).
  recebidoPor String?

  empresa   Empresa   @relation(fields: [empresaId], references: [id])
  notaSaida NotaSaida @relation(fields: [notaSaidaId], references: [id], onDelete: Cascade)

  @@index([empresaId, recebidoEm])
  @@map("nota_saida_xml")
}

// Item de nota com empresaId/clienteId/vendedorId/dtEmissao denormalizados
// (como no legado) — viabiliza a tela própria de itens com RLS e escopo sem
// join na nota.
model NotaSaidaItem {
  id          String  @id @default(uuid())
  empresaId   String
  notaSaidaId String
  // Chave de identidade do item no ERP. Tem a sua própria porque o upsert do
  // cabeçalho casa item a item por ela, em vez de apagar e recriar o conjunto
  // — o uuid do item sobrevive à alteração de uma linha da nota.
  chave       String? // chave de integração (X2_UNICO), única dentro do cabeçalho
  clienteId   String?
  vendedorId  String?
  produtoId   String?

  item      Int?
  dtEmissao DateTime?
  ano       Int?
  mes       Int?
  cfop      String?
  tipo      String?

  quantidade    Float  @default(0)
  vlrUnitario   Float  @default(0)
  vlrTabela     Float?
  percDesconto  Float?
  vlrDesconto   Float  @default(0)
  vlrTotal      Float  @default(0)
  quantidadeDev Float?
  vlrDev        Float?
  peso          Float?

  comodato Boolean @default(false)
  ativo    Boolean @default(true)

  // Percentual de comissão apurado na linha (resultado da regra de desconto
  // aplicada). Nulo enquanto não houver cálculo — nada preenche ainda.
  percComissao Float?

  // Regra de desconto aplicável (SZ0 do ERP). Nulo = sem regra própria;
  // a resolução de qual regra vale ainda não existe — por ora é só o vínculo.
  regraDescontoId String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  empresa       Empresa        @relation(fields: [empresaId], references: [id])
  regraDesconto RegraDesconto? @relation(fields: [regraDescontoId], references: [id])
  notaSaida     NotaSaida      @relation(fields: [notaSaidaId], references: [id], onDelete: Cascade)
  cliente       Cliente?       @relation(fields: [clienteId], references: [id])
  vendedor      Vendedor?      @relation(fields: [vendedorId], references: [id])
  produto       Produto?       @relation(fields: [produtoId], references: [id])

  @@unique([notaSaidaId, chave])
  @@index([notaSaidaId])
  @@index([empresaId, produtoId])
  @@index([empresaId, vendedorId, dtEmissao])
  @@index([empresaId, regraDescontoId])
  // Monta a cesta de compras de um cliente (Sugestão de Compra) — sem ele,
  // cada cliente-alvo faz seq scan na maior tabela da base.
  @@index([empresaId, clienteId, produtoId])
  @@map("notas_saida_itens")
}

/**
 * Fornecedor — a outra ponta do estoque, espelho do cadastro do ERP.
 * Read-only na plataforma: entra e sai apenas por `/integracao/fornecedores`.
 * Não é um `Cliente` com outro nome — não tem carteira, tabela de preço,
 * limite de crédito nem histórico de atendimento, e misturar os dois faria
 * toda consulta comercial precisar filtrar "só os que compram de nós".
 * O `produtos.codigoFornecedor` (texto solto, código do item no catálogo do
 * fornecedor) continua sendo outra coisa e **não** aponta para cá.
 */
model Fornecedor {
  id        String  @id @default(uuid())
  empresaId String
  // Chave de identidade do registro no ERP — o que o upsert do POST casa.
  codigoErp String?
  chave     String? // chave de integração (X2_UNICO); codigoErp é informativo

  tipoPessoa         TipoPessoa @default(juridica)
  razaoSocial        String
  nomeFantasia       String?
  cnpjCpf            String?
  inscricaoEstadual  String?
  inscricaoMunicipal String?

  contato  String?
  email    String?
  telefone String?
  celular  String?

  endereco    String?
  complemento String?
  bairro      String?
  municipio   String?
  uf          String?
  cep         String?

  observacao String?
  ativo      Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  empresa           Empresa           @relation(fields: [empresaId], references: [id])
  notasEntrada      NotaEntrada[]
  notasEntradaItens NotaEntradaItem[]
  notasSaida        NotaSaida[]
  produtos          Produto[]

  @@unique([empresaId, chave])
  @@index([empresaId, codigoErp])
  @@index([empresaId, razaoSocial])
  @@index([empresaId, cnpjCpf])
  @@map("fornecedores")
}

/**
 * Nota de entrada — espelho da SF1, irmã de `NotaSaida`.
 * Sem XML nem DANFE, ao contrário da saída: o documento de entrada foi
 * emitido por terceiro, e a plataforma não reimprime segunda via dele. Se um
 * dia precisar, o molde é `nota_saida_xml`.
 * **A SF1 guarda dois documentos diferentes**, separados por `tipo`:
 * - `'N'` — compra. O participante é um **fornecedor** (`fornecedorId`).
 * - `'D'` — devolução de venda. O participante é um **cliente**
 * (`clienteId`), e é o que alimenta a aba "Devoluções" da Posição de
 * Cliente.
 * Por isso as duas chaves são nulas: numa compra vem `fornecedorId`, numa
 * devolução vem `clienteId`. Um campo único ("participante") economizaria uma
 * coluna e custaria a FK — não haveria como o banco garantir que o código
 * aponta para o cadastro certo, e a consulta por cliente viraria texto.
 * A devolução **não** entra nas apurações (Objetivos, Consultas, Dashboard):
 * quem responde por ela ali continua sendo `NotaSaidaItem.vlrDev`, gravado na
 * própria nota de venda. Contar as duas somaria a mesma devolução duas vezes.
 */
model NotaEntrada {
  id                  String  @id @default(uuid())
  empresaId           String
  // Chave de identidade do registro no ERP — mesma semântica de NotaSaida.
  codigoErp           String?
  chave               String? // chave de integração (X2_UNICO); codigoErp é informativo
  fornecedorId        String?
  clienteId           String?
  condicaoPagamentoId String?

  numero        String
  serie         String?
  especieFiscal String?
  tipo          String?
  // `dtEmissao` é a data do documento do fornecedor; `dtEntrada` é quando a
  // mercadoria foi recebida. As duas raramente coincidem, e é a de emissão
  // que alimenta `ano`/`mes` — para que a apuração de compra case com a de
  // venda, que também usa emissão.
  dtEmissao     DateTime?
  dtEntrada     DateTime?
  ano           Int?
  mes           Int?

  // `vlrIcmsSt` é o F1_ICMSRET ("ICMS Solid." no dicionário do ERP).
  // Frete, seguro e despesas acessórias vêm separados porque é assim que a
  // SF1 os guarda — somá-los num "outras despesas" só impediria conferir a
  // nota contra o documento do fornecedor.
  vlrBruto      Float @default(0)
  vlrMercadoria Float @default(0)
  vlrItens      Float @default(0)
  vlrDesconto   Float @default(0)
  vlrIcms       Float @default(0)
  vlrIcmsSt     Float @default(0)
  vlrIpi        Float @default(0)
  vlrFrete      Float @default(0)
  vlrSeguro     Float @default(0)
  vlrDespesa    Float @default(0)

  chaveNfe String?
  dtNfe    DateTime?
  mensagem String?
  ativo    Boolean   @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  empresa           Empresa            @relation(fields: [empresaId], references: [id])
  fornecedor        Fornecedor?        @relation(fields: [fornecedorId], references: [id])
  cliente           Cliente?           @relation(fields: [clienteId], references: [id])
  condicaoPagamento CondicaoPagamento? @relation(fields: [condicaoPagamentoId], references: [id])
  itens             NotaEntradaItem[]

  @@unique([empresaId, chave])
  @@index([empresaId, codigoErp])
  @@index([empresaId, numero])
  @@index([empresaId, fornecedorId])
  @@index([empresaId, dtEmissao])
  @@index([empresaId, ano, mes])
  // A aba "Devoluções" da Posição de Cliente entra por aqui: um cliente, as
  // notas 'D' dele, mais recente primeiro.
  @@index([empresaId, clienteId, dtEmissao])
  @@map("notas_entrada")
}

// Item de nota de entrada com empresaId/fornecedorId/clienteId/dtEmissao/
// ano/mes denormalizados do cabeçalho — mesma decisão de `NotaSaidaItem`, e
// pelo mesmo motivo: a apuração por produto varre a tabela de itens, e um join
// com o cabeçalho em cima da maior tabela do módulo custa caro à toa.
//
// Não tem `ncm`: o NCM é do produto (`Produto.ncm`, vindo de `B1_POSIPI`), e
// repeti-lo aqui criaria duas versões do mesmo dado, livres para divergir.
model NotaEntradaItem {
  id            String  @id @default(uuid())
  empresaId     String
  notaEntradaId String
  // Chave própria do item no ERP: o upsert do cabeçalho casa item a item por
  // ela, em vez de apagar e recriar o conjunto.
  chave         String? // chave de integração (X2_UNICO), única dentro do cabeçalho
  // Espelham o participante do cabeçalho: fornecedor na compra, cliente na
  // devolução (ver NotaEntrada).
  fornecedorId  String?
  clienteId     String?
  produtoId     String?
  armazemId     String?

  item      Int?
  dtEmissao DateTime?
  ano       Int?
  mes       Int?
  cfop      String?

  quantidade  Float @default(0)
  vlrUnitario Float @default(0)
  vlrDesconto Float @default(0)
  vlrTotal    Float @default(0)
  vlrIcms     Float @default(0)
  vlrIcmsSt   Float @default(0)
  vlrIpi      Float @default(0)

  peso  Float?
  ativo Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  empresa     Empresa     @relation(fields: [empresaId], references: [id])
  notaEntrada NotaEntrada @relation(fields: [notaEntradaId], references: [id], onDelete: Cascade)
  fornecedor  Fornecedor? @relation(fields: [fornecedorId], references: [id])
  cliente     Cliente?    @relation(fields: [clienteId], references: [id])
  produto     Produto?    @relation(fields: [produtoId], references: [id])
  armazem     Armazem?    @relation(fields: [armazemId], references: [id])

  @@unique([notaEntradaId, chave])
  @@index([notaEntradaId])
  @@index([empresaId, produtoId])
  @@index([empresaId, fornecedorId, dtEmissao])
  @@index([empresaId, clienteId, produtoId])
  @@map("notas_entrada_itens")
}

/**
 * Convênio de cobrança da empresa — o que o boleto precisa saber sobre o
 * beneficiário e que não muda de título para título.
 * Existe como cadastro (e não como parâmetro ou campo repetido no payload do
 * ERP) por dois motivos: a empresa pode ter mais de uma conta de cobrança, e
 * instrução/multa/juros são texto que se corrige numa tela, não numa carga.
 * A plataforma **não registra boleto em banco**: quem registrou foi o ERP, e é
 * dele que vem o nosso número (ver `TituloReceber.nossoNumero`). Aqui só se
 * guarda o que é preciso para *reimprimir* a mesma ficha de compensação.
 */
model ContaBancaria {
  id        String @id @default(uuid())
  empresaId String

  descricao String
  // Código de compensação do banco ("237" = Bradesco). É string porque o
  // zero à esquerda ("001", "104") faz parte do código.
  banco     String
  agencia   String
  agenciaDv String?
  conta     String
  contaDv   String?
  // Carteira da cobrança ("09" no Bradesco). Entra no campo livre do código
  // de barras e é impressa na ficha.
  carteira  String

  /// Logo do banco para exibição na 2ª via do boleto.
  logoUrl String?

  // Beneficiário do boleto. Nulo = usa o cadastro da empresa — o caso normal;
  // preencher só quando a conta é de outra razão social (filial, factoring).
  beneficiarioNome      String?
  beneficiarioDocumento String?
  beneficiarioEndereco  String?

  localPagamento   String  @default("Pagável em qualquer banco até o vencimento")
  aceite           String  @default("N")
  especieDocumento String  @default("DM")
  instrucoes       String?
  demonstrativo    String?

  // Encargos impressos nas instruções. Não entram no valor do documento: o
  // que se cobra depois do vencimento é decisão do banco/ERP, aqui é texto.
  jurosMesPerc Float?
  multaPerc    Float?
  diasProtesto Int?

  // Conta usada quando o título não aponta nenhuma — que é o caso de todo
  // título já importado. Só uma por empresa (garantido no service).
  padrao Boolean @default(false)
  ativo  Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  empresa Empresa         @relation(fields: [empresaId], references: [id])
  titulos TituloReceber[]

  @@index([empresaId, ativo])
  @@map("contas_bancarias")
}

model TituloReceber {
  id         String  @id @default(uuid())
  empresaId  String
  // Ver NotaSaida.chave.
  codigoErp  String?
  chave      String? // chave de integração (X2_UNICO); codigoErp é informativo
  clienteId  String?
  vendedorId String?

  numero  String
  parcela String?
  prefixo String?
  tipo    String?

  emissao        DateTime?
  vencimento     DateTime?
  vencimentoReal DateTime?
  valor          Float     @default(0)
  saldo          Float     @default(0)
  acrescimo      Float?
  decrescimo     Float?
  dtBaixa        DateTime?
  formaPgto      String?
  historico      String?
  ativo          Boolean   @default(true)

  // ---- 2ª via de boleto (ver docs/planos/segunda-via-danfe-boleto.md) ----
  // Tudo opcional: título importado antes desta migration continua válido, e
  // título de outra forma de pagamento (depósito, dinheiro) nunca terá isso.

  // Conta de cobrança usada no registro. Nulo = a conta padrão da empresa.
  contaBancariaId String?
  // Identificação do boleto no banco, gerada pelo ERP no registro. Sem ela
  // não há 2ª via: um boleto com nosso número inventado não é pagável.
  nossoNumero     String?
  // Carteira do título, quando diverge da carteira da conta (ERP que registra
  // em mais de uma). Nulo = a da conta.
  carteira        String?

  // Código de barras / linha digitável **como o banco registrou**. Quando o
  // ERP manda, prevalecem sobre o cálculo local: divergir do que está
  // registrado é pior do que não imprimir.
  codigoBarras   String?
  linhaDigitavel String?

  // ---- Boleto autossuficiente: o ERP manda o desenho junto com o título ----
  // Quem registra o boleto no banco é o ERP, então é a informação dele que
  // vale. Todos opcionais, e todos com o mesmo contrato de precedência que o
  // `carteira` acima já tinha: preenchido, vence a conta de cobrança; nulo,
  // cai nela. Título importado antes desta migration continua sendo emitido
  // pelo cadastro, sem mudança nenhuma.
  nossoNumeroDac         String?
  banco                  String?
  bancoNome              String?
  bancoCodigoCompensacao String?
  agencia                String?
  agenciaDv              String?
  conta                  String?
  contaDv                String?
  beneficiarioNome       String?
  beneficiarioDocumento  String?
  beneficiarioEndereco   String?
  localPagamento         String?
  aceite                 String?
  especieDocumento       String?

  // Encargos em reais, calculados pelo ERP sobre o saldo. Substituem o cálculo
  // por percentual quando presentes: o valor impresso no boleto que está com o
  // cliente é este, e divergir dele gera contestação no caixa.
  jurosValorDia Float?
  multaValor    Float?
  descontoValor Float?
  instrucoes    String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  empresa       Empresa        @relation(fields: [empresaId], references: [id])
  cliente       Cliente?       @relation(fields: [clienteId], references: [id])
  vendedor      Vendedor?      @relation(fields: [vendedorId], references: [id])
  contaBancaria ContaBancaria? @relation(fields: [contaBancariaId], references: [id])

  baixas TituloReceberBaixa[]

  @@unique([empresaId, chave])
  @@index([empresaId, codigoErp])
  @@index([empresaId, clienteId])
  @@index([empresaId, vendedorId, vencimento])
  @@index([empresaId, vencimento])
  @@map("titulos_receber")
}

// A baixa do título — o que o cliente pagou de verdade, movimento a movimento.
// Espelho read-only da SE5 do Protheus: **a plataforma nunca cria, altera nem
// estorna uma baixa**, só recebe pelo import. Baixa é ato financeiro do ERP.
//
// Existe como tabela, e não como colunas no título, porque um título aceita
// baixa parcial: três pagamentos com datas, juros e descontos diferentes viram
// três linhas, e somá-los no título perderia justamente o que se quer ver.
//
// `valor` é o principal amortizado; os encargos vêm ao lado, cada um no seu
// campo. O que entrou em caixa é
// `valor + juros + multa - desconto - abatimento - impostosRetidos`, e a
// plataforma não recalcula isso: quem fecha a conta é o ERP.
//
// Não confundir com `TituloReceber.jurosValorDia`/`multaValor`/`descontoValor`:
// aqueles são as **instruções do boleto em aberto** (importância por dia de
// atraso, multa após o vencimento, desconto até o vencimento), calculadas sobre
// o saldo. Estes aqui são realizados, e só existem depois da baixa.
model TituloReceberBaixa {
  id              String  @id @default(uuid())
  empresaId       String
  tituloReceberId String
  // Chave própria do movimento no ERP: o upsert do título casa baixa a baixa
  // por ela, em vez de apagar e recriar o conjunto a cada coleta.
  chave           String?

  data  DateTime?
  // Principal amortizado do título nesta baixa.
  valor Float     @default(0)

  // Encargos realizados. Sempre positivos: o sinal está no nome do campo, não
  // no número — desconto de 10 é `desconto: 10`, nunca `-10`.
  juros           Float @default(0)
  multa           Float @default(0)
  desconto        Float @default(0)
  abatimento      Float @default(0)
  impostosRetidos Float @default(0)

  // Motivo da baixa no ERP (E5_MOTBX: NOR normal, CMP compensação, DAC…) e o
  // histórico digitado. Informativos.
  motivo    String?
  historico String?

  // Onde o dinheiro entrou, quando o ERP registra. Texto solto, e não um
  // vínculo com `contas_bancarias`: é o banco do movimento, não a conta de
  // cobrança em que o boleto foi registrado.
  banco   String?
  agencia String?
  conta   String?

  ativo Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  empresa       Empresa       @relation(fields: [empresaId], references: [id])
  tituloReceber TituloReceber @relation(fields: [tituloReceberId], references: [id], onDelete: Cascade)

  @@unique([tituloReceberId, chave])
  @@index([empresaId, tituloReceberId])
  @@index([empresaId, data])
  @@map("titulo_receber_baixas")
}

// ------------------------------------------------------------------
// CRM (funil de vendas + atividades comerciais)
// ------------------------------------------------------------------
// Cadastro novo (não vem do legado), editável, com o mesmo escopo
// hierárquico de vendedor das demais telas comerciais. Oportunidade e
// Atividade são recursos independentes (não mestre-detalhe entre si) — cada
// um referencia Cliente/Vendedor diretamente, e Atividade tem um vínculo
// opcional a uma Oportunidade.

enum EstagioOportunidade {
  prospeccao
  qualificacao
  proposta
  negociacao
  ganha
  perdida
}

enum TipoAtividade {
  ligacao
  reuniao
  email
  visita
  tarefa
}

model Oportunidade {
  id             String              @id @default(uuid())
  empresaId      String
  clienteId      String
  vendedorId     String
  titulo         String
  estagio        EstagioOportunidade @default(prospeccao)
  valorPrevisto  Float?
  dataPrevisao   DateTime?
  dataFechamento DateTime?
  motivoPerda    String?
  observacao     String?
  ativo          Boolean             @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  empresa    Empresa     @relation(fields: [empresaId], references: [id])
  cliente    Cliente     @relation(fields: [clienteId], references: [id])
  vendedor   Vendedor    @relation(fields: [vendedorId], references: [id])
  atividades Atividade[]
  orcamentos Orcamento[]

  @@index([empresaId, vendedorId])
  @@index([empresaId, clienteId])
  @@index([empresaId, estagio])
  @@map("oportunidades")
}

model Atividade {
  id             String        @id @default(uuid())
  empresaId      String
  clienteId      String?
  oportunidadeId String?
  orcamentoId    String?
  vendedorId     String
  tipo           TipoAtividade @default(tarefa)
  titulo         String
  descricao      String?
  dataVencimento DateTime?
  concluida      Boolean       @default(false)
  dataConclusao  DateTime?
  ativo          Boolean       @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  empresa      Empresa       @relation(fields: [empresaId], references: [id])
  cliente      Cliente?      @relation(fields: [clienteId], references: [id])
  oportunidade Oportunidade? @relation(fields: [oportunidadeId], references: [id])
  orcamento    Orcamento?    @relation(fields: [orcamentoId], references: [id])
  vendedor     Vendedor      @relation(fields: [vendedorId], references: [id])

  @@index([empresaId, vendedorId])
  @@index([empresaId, clienteId])
  @@index([empresaId, oportunidadeId])
  @@index([empresaId, orcamentoId])
  @@index([empresaId, dataVencimento])
  @@map("atividades")
}

// Orçamento/Proposta: mestre-detalhe editável (mesmo padrão de mestre-detalhe
// de ObjetivoVendedorMes — os itens são substituídos por inteiro a cada
// update, sem upsert por linha). vlrTabela referencia o preço vigente na
// TabelaPreco do cliente no momento em que o item foi adicionado (mesma
// convenção de NotaSaidaItem.vlrTabela); vlrUnitario é o preço praticado,
// que o vendedor pode ajustar manualmente. Não gera Nota de Saída — é só
// registro comercial nesta primeira versão.
/// Quem originou a venda — o **executor**, não o dono da carteira.
///
/// A venda fica sempre com o vendedor do cadastro do cliente (é ele quem
/// atende, e é na carteira dele que o histórico é consultado). Mas quem monta
/// o orçamento nem sempre é ele: supervisor, gerente e administrador vendem na
/// carteira do subordinado, e o cliente pode pedir sozinho. Sem esta coluna,
/// a comissão e a leitura de desempenho tratam as duas coisas como iguais.
///
/// Preenchida pelo servidor a partir de quem cria, comparando com o vendedor
/// do cliente — nunca vem do payload.
enum OrigemVenda {
  vendedor
  superior
  administrador
  cliente
}

enum StatusOrcamento {
  rascunho
  enviado
  aprovado
  recusado
  expirado
}

model Orcamento {
  id                  String          @id @default(uuid())
  empresaId           String
  // Chave de identidade do orçamento no ERP: recebe o número do Pedido de
  // Venda gerado a partir dele. É o que tira o orçamento da fila de
  // /integracao/orcamentos/pendentes — nulo enquanto o ERP não o importou,
  // e nulo para sempre no orçamento que morre na tela sem virar pedido.
  codigoErp           String?
  chave               String? // chave de integração (X2_UNICO); codigoErp é informativo
  // Número do orçamento pro cliente (é o que sai na proposta em PDF):
  // sequencial por empresa, atribuído na criação a partir do contador
  // OrcamentoConfig.ultimoNumero. Existe desde o rascunho — diferente do
  // codigoErp, que só aparece quando o ERP integra.
  numero              Int
  clienteId           String
  vendedorId          String
  oportunidadeId      String?
  condicaoPagamentoId String?
  titulo              String
  status              StatusOrcamento @default(rascunho)
  // Quem originou — ver `OrigemVenda`. O histórico anterior a 2026-09-02 fica
  // como `vendedor`: não há como saber, depois, quem digitou o que.
  origem              OrigemVenda     @default(vendedor)
  dataValidade        DateTime?
  // Data de retorno/follow-up: ao ser definida (na criação ou numa edição
  // que muda o valor), o backend gera automaticamente uma Atividade de
  // acompanhamento (tipo ligação) vinculada a este orçamento, com
  // dataVencimento = dataRetorno — vira um lembrete na Agenda/Atividades pro
  // vendedor retomar contato, que pode resultar num novo orçamento.
  dataRetorno         DateTime?
  observacao          String?
  vlrTotal            Float           @default(0)
  ativo               Boolean         @default(true)

  // Autorização de desconto em duas etapas: item com desconto igual ou acima
  // do "% Desc Máximo" da regra trava PDF e efetivação (status aprovado) até
  // alguém com permissão de aprovar autorizar. O vendedor solicita
  // (solicitadoEm/Por, que gera uma Atividade de pendência para o supervisor)
  // e o autorizador libera (autorizadoEm/Por). Autorizado vale para o
  // orçamento como está: mexer nos itens ou nos preços derruba a autorização,
  // senão daria para autorizar 15% e gravar 40% depois.
  descontoSolicitadoEm        DateTime?
  descontoSolicitadoPor       String?
  descontoAutorizadoEm        DateTime?
  descontoAutorizadoPor       String?
  clienteDecididoEm           DateTime?
  clienteDecididoPorContatoId String?
  clienteDecisao              String?
  clienteDecisaoObservacao    String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  empresa            Empresa            @relation(fields: [empresaId], references: [id])
  cliente            Cliente            @relation(fields: [clienteId], references: [id])
  vendedor           Vendedor           @relation(fields: [vendedorId], references: [id])
  oportunidade       Oportunidade?      @relation(fields: [oportunidadeId], references: [id])
  condicaoPagamento  CondicaoPagamento? @relation(fields: [condicaoPagamentoId], references: [id])
  itens              OrcamentoItem[]
  atividades         Atividade[]
  clienteDecididoPor ClienteContato?    @relation("OrcamentoDecisaoContato", fields: [clienteDecididoPorContatoId], references: [id])

  @@unique([empresaId, chave])
  @@index([empresaId, codigoErp])
  @@unique([empresaId, numero])
  @@index([empresaId, vendedorId])
  @@index([empresaId, clienteId])
  @@index([empresaId, status])
  @@index([empresaId, clienteDecididoPorContatoId])
  @@map("orcamentos")
}

model OrcamentoItem {
  id          String  @id @default(uuid())
  empresaId   String
  orcamentoId String
  produtoId   String
  // Chave de identidade do item no ERP — nula no item criado na tela, que é
  // o caso normal aqui: o orçamento nasce na plataforma.
  chave       String? // chave de integração (X2_UNICO), única dentro do cabeçalho

  quantidade   Float  @default(1)
  vlrTabela    Float?
  vlrUnitario  Float  @default(0)
  percDesconto Float?
  vlrDesconto  Float  @default(0)
  vlrTotal     Float  @default(0)

  // Regra de desconto aplicável (SZ0 do ERP). Nulo = sem regra própria;
  // a resolução de qual regra vale ainda não existe — por ora é só o vínculo.
  regraDescontoId String?
  // Percentual de comissão apurado na linha (resultado da regra de desconto
  // aplicada). Nulo enquanto não houver cálculo — nada preenche ainda.
  percComissao    Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empresa       Empresa        @relation(fields: [empresaId], references: [id])
  regraDesconto RegraDesconto? @relation(fields: [regraDescontoId], references: [id])
  orcamento     Orcamento      @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)
  produto       Produto        @relation(fields: [produtoId], references: [id], onDelete: Restrict)

  @@index([empresaId, produtoId])
  @@index([orcamentoId])
  @@index([empresaId, regraDescontoId])
  @@map("orcamento_itens")
  @@unique([orcamentoId, chave])
}

// ------------------------------------------------------------------
// Objetivos (metas comerciais)
// ------------------------------------------------------------------
// Mestre-detalhe (mês/ano/vendedor + linhas por categoria), espelhando as
// tabelas `meta_vendedor_mes`/`meta_vendedor_categoria` do legado — base do
// Dashboard Comercial (realizado vs objetivo). Cadastro editável (não
// read-only como NotaSaida/Item), com o mesmo escopo hierárquico de
// vendedor das demais telas comerciais.
model ObjetivoVendedorMes {
  id         String  @id @default(uuid())
  empresaId  String
  vendedorId String
  // Ver NotaSaida.chave.
  codigoErp  String?
  chave      String? // chave de integração (X2_UNICO); codigoErp é informativo

  mes           Int
  ano           Int
  valor         Float   @default(0)
  numeroCliente Float?
  novoCliente   Float?
  tipo          String?
  ativo         Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  empresa    Empresa                     @relation(fields: [empresaId], references: [id])
  vendedor   Vendedor                    @relation(fields: [vendedorId], references: [id])
  categorias ObjetivoVendedorCategoria[]

  @@unique([empresaId, vendedorId, mes, ano])
  @@unique([empresaId, chave])
  @@index([empresaId, codigoErp])
  @@index([empresaId, ano, mes])
  @@map("objetivos_vendedor_mes")
}

model ObjetivoVendedorCategoria {
  id                    String  @id @default(uuid())
  empresaId             String
  objetivoVendedorMesId String
  categoriaId           String
  // Ver NotaSaida.chave.
  chave                 String? // chave de integração (X2_UNICO), única dentro do cabeçalho
  valor                 Float   @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  empresa   Empresa             @relation(fields: [empresaId], references: [id])
  objetivo  ObjetivoVendedorMes @relation(fields: [objetivoVendedorMesId], references: [id], onDelete: Cascade)
  categoria Categoria           @relation(fields: [categoriaId], references: [id])

  @@unique([objetivoVendedorMesId, categoriaId])
  @@unique([objetivoVendedorMesId, chave])
  @@map("objetivos_vendedor_categoria")
}

// ------------------------------------------------------------------
// Sistema
// ------------------------------------------------------------------

enum ErroOrigem {
  servidor
  cliente
}

enum ErroTipo {
  excecao
  http
  rede
  resposta
  javascript
  promessa
}

/// Log de erros (Plataforma > Erros). Ver `docs/planos/log-de-erros.md`.
///
/// **Ocupa a tabela `audit_logs`**, que existia no schema desde cedo e nunca
/// foi usada — nenhuma referência no código, zero linhas. As colunas antigas
/// (entidade/ação/valorAnterior) eram de auditoria de alteração e não servem a
/// um erro, então a migration as troca. Quem procurar auditoria de alteração
/// encontra `plataforma_auditoria` e `acessos_log`.
///
/// **Sem RLS, de propósito** — mesma razão de `plataforma_auditoria`: só a
/// administração da plataforma lê, e ela lê **todas** as empresas. Uma policy
/// de tenant devolveria vazio para exatamente quem precisa enxergar. O
/// `empresaId` aqui é informativo (e nulo quando o erro acontece antes de
/// haver empresa ativa, no login).
model ErroLog {
  id String @id @default(uuid())

  origem ErroOrigem
  tipo   ErroTipo

  /// Quando aconteceu. Em erro de cliente é o relógio do navegador: o report
  /// espera em buffer local e pode chegar minutos depois, quando a conexão
  /// voltar — a hora de chegada não serve como hora do fato.
  ocorridoEm DateTime
  criadoEm   DateTime @default(now())

  /// A última repetição absorvida por esta linha, e o campo por onde a tela
  /// ordena. Igual a `ocorridoEm` enquanto `ocorrencias` for 1.
  ultimaEm DateTime

  /// Repetições colapsadas nesta linha. Um bug em laço gera milhares de
  /// eventos em minutos; o serviço junta os que caem na mesma janela curta
  /// num contador em vez de em linhas — é o que impede a rajada de ser a
  /// própria falha de disponibilidade.
  ocorrencias Int @default(1)

  /// Caminho como veio, com os ids reais — é o que permite reproduzir.
  rota       String
  /// O mesmo caminho com uuid/número trocados por `:id`. Sem isto, o mesmo
  /// erro em dez clientes vira dez grupos.
  rotaPadrao String
  metodo     String?
  /// Nulo em erro de JavaScript e quando a requisição nem recebeu resposta.
  status     Int?
  /// Endereço da tela onde o usuário estava (só nos erros de cliente).
  pagina     String?

  mensagem String  @db.Text
  /// Mensagem normalizada (ids, números e trechos entre aspas removidos). É o
  /// texto que agrupa, e o que a listagem mostra.
  resumo   String
  stack    String? @db.Text

  /// origem + tipo + rotaPadrao + método + status + resumo, em hash curto.
  assinatura String

  /// Sem FK em nenhum dos dois: o log tem de sobreviver à exclusão do usuário
  /// e da empresa, senão perde justamente o registro do que saiu. O nome vai
  /// junto pelo mesmo motivo.
  usuarioId          String?
  usuarioEmail       String?
  empresaId          String?
  empresaRazaoSocial String?

  ip        String?
  userAgent String?

  @@index([assinatura, ultimaEm])
  @@index([ultimaEm])
  @@index([empresaId, ultimaEm])
  @@map("audit_logs")
}

/// Governança do log de erros. Singleton (uma linha, id fixo `unico`): a
/// configuração é da plataforma inteira, não de uma empresa — quem a lê e
/// quem a ajusta é o administrador do SaaS.
model ErroLogConfig {
  id String @id @default("unico")

  /// 0 = sem expurgo por tempo.
  retencaoDias   Int     @default(30)
  /// Máximo de linhas por empresa; 0 = sem teto. A varredura corta as mais
  /// antigas. O prazo em dias sozinho não segura um bug em laço dentro da
  /// janela — daí o teto.
  tetoPorEmpresa Int     @default(5000)
  /// Grava também os 4xx. Desligado por padrão: 400 de validação é erro de
  /// quem preencheu, e registrar tudo esconde o 500 que importa. É
  /// interruptor de investigação pontual.
  registrar4xx   Boolean @default(false)

  atualizadoEm  DateTime @updatedAt
  atualizadoPor String?

  @@map("erros_log_config")
}

// Histórico de hashes de senha já usados por cada usuário, só para checar
// reuso (parâmetro SENHA_HISTORICO_QUANTIDADE). Global, sem RLS, mesmo
// precedente de RefreshToken.
model SenhaHistorico {
  id        String   @id @default(uuid())
  usuarioId String
  senhaHash String
  createdAt DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId, createdAt])
  @@map("senha_historico")
}

// ---------------------------------------------------------------------------
// WhatsApp do vendedor — ver docs/planos/whatsapp-vendedor.md
// ---------------------------------------------------------------------------

enum WhatsappTransporte {
  zapo
  evolution_go
  cloud_api
}

/// Que papel um número cumpre na empresa.
enum WhatsappSessaoTipo {
  /// Aparelho de uma pessoa. É o que sempre existiu.
  vendedor
  /// Número institucional: porta de entrada, atendida pela IA antes de chegar
  /// a alguém. Um por empresa.
  empresa
}

/// Em que ponto do atendimento uma conversa do número institucional está.
enum WhatsappAtendimentoStatus {
  /// A IA está atendendo. Não aparece para vendedor nenhum.
  bot
  /// A IA já direcionou, mas ninguém abriu ainda. Aparece para o vendedor
  /// escolhido.
  aguardando
  /// Alguém assumiu e está conduzindo.
  humano
  /// Encerrada. Mensagem nova do cliente devolve para `bot`, porque é um
  /// assunto novo e a triagem recomeça.
  encerrada
}

enum WhatsappSessaoStatus {
  desconectada
  pareando
  conectada
  banida
}

enum WhatsappDirecao {
  entrada
  saida
}

enum WhatsappTipoMensagem {
  texto
  imagem
  documento
  audio
  video
  localizacao
  contato
  outro
}

enum WhatsappStatusEntrega {
  pendente
  enviada
  entregue
  lida
  erro
}

/// Número de WhatsApp que o institucional reconhece como sendo de um
/// funcionário (ver docs/planos/whatsapp-institucional-funcionarios.md).
///
/// **O telefone sozinho não autoriza nada.** Ele é reconhecido em
/// `usuario_empresas.celular/telefone` — a mesma fonte que o `avisar_equipe`
/// usa para mandar recado —, mas antes de qualquer ferramenta ser oferecida a
/// pessoa confirma um código que só aparece **dentro do sistema**, onde ela
/// entrou com senha. É isso que impede um celular emprestado, perdido ou
/// clonado de falar com a voz do dono.
model WhatsappVinculoFuncionario {
  id        String @id @default(uuid())
  empresaId String
  usuarioId String

  /// Dígitos do número como o WhatsApp entregou (com DDI, sem formatação).
  /// Guardado inteiro para quem investiga saber qual aparelho foi pareado.
  telefone String

  /// **A chave do pareamento**: DDD + 8 dígitos, sem DDI e sem o 9º dígito
  /// (ver `chaveTelefone`). Identifica o aparelho de forma exata.
  ///
  /// Era o `sufixo` de 8 dígitos até 2026-09-05, e isso era uma escalação de
  /// privilégio: um número de **outro DDD** com os mesmos 8 dígitos finais caía
  /// no mesmo vínculo e herdava a confirmação do vendedor. O DDD é justamente o
  /// que separa os dois, e ele estava fora da chave.
  chave String

  /// Últimos 8 dígitos. Continua servindo para **encontrar** a pessoa no
  /// cadastro (onde o telefone pode estar sem DDI ou sem o 9º dígito), onde a
  /// tolerância é desejável — achar um candidato não autoriza nada, só abre um
  /// pedido de código. Não é mais chave de nada.
  sufixo String

  /// Código pendente e sua validade. Curto de propósito: ele trafega por
  /// WhatsApp, e um código que vale o dia todo vale para quem estiver com o
  /// aparelho depois.
  codigo         String?
  codigoExpiraEm DateTime?

  /// Erros seguidos no código. Estourado o teto, o código morre e é preciso
  /// escrever de novo para gerar outro — senão o WhatsApp vira um campo de
  /// tentativa e erro de seis dígitos.
  tentativas Int @default(0)

  confirmadoEm DateTime?

  /// Até quando o pareamento vale. Vencido, pede o código de novo: um número
  /// confirmado uma vez não pode valer para sempre, porque pessoas trocam de
  /// telefone e saem da empresa.
  validoAte DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id])
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@unique([empresaId, chave])
  @@index([empresaId, usuarioId])
  @@map("whatsapp_vinculos_funcionario")
}

enum WhatsappTipoContato {
  geral
  financeiro
  compras
  contabilidade_fiscal
  outros
}

/**
 * Sessão de WhatsApp de um vendedor — uma conexão viva no worker.
 * `credencialCifrada` é o estado de autenticação devolvido pelo pareamento
 * (AES-256-GCM, como `AgenteCredencial.apiKeyCifrada`). É segredo de verdade:
 * quem tem essa credencial fala pelo WhatsApp do vendedor. Nunca sai da API.
 * `transporte` fica na linha, e não só no parâmetro da empresa, porque a
 * migração para a Cloud API será gradual — sessões antigas continuam no Zapo
 * enquanto as novas já nascem oficiais.
 * `aceiteEm`/`aceiteVersao` registram que o vendedor foi informado de que a
 * conversa com clientes é gravada e visível ao supervisor. A trava que exige o
 * aceite é da Fatia 3 (governança); as colunas nascem aqui porque o aceite
 * acontece no pareamento, que é Fatia 1.
 */
model WhatsappSessao {
  id        String @id @default(uuid())
  empresaId String

  /// Que papel este número cumpre.
  ///
  /// `vendedor` é o aparelho de uma pessoa, como sempre foi. `empresa` é o
  /// número institucional: a porta de entrada, atendida primeiro pela IA e só
  /// depois direcionada a alguém. Os dois convivem — o cliente que já fala com
  /// o vendedor dele continua falando.
  tipo WhatsappSessaoTipo @default(vendedor)

  /// Nulo na sessão da empresa: ela não pertence a vendedor nenhum. A unicidade
  /// de "uma sessão institucional por empresa" é um índice parcial, criado na
  /// migration — o `@@unique` abaixo não a cobre, porque no Postgres vários
  /// NULL não colidem entre si.
  vendedorId String?

  numero     String?
  jid        String?
  status     WhatsappSessaoStatus @default(desconectada)
  transporte WhatsappTransporte   @default(zapo)

  credencialCifrada String?   @db.Text
  ultimaConexao     DateTime?
  ultimoErro        String?

  // Instância na Evolution GO (nulos nas sessões `zapo`).
  //
  // `instanciaExterna` é o nome técnico determinístico com que a instância foi
  // criada lá; `instanciaId` é o identificador que o serviço devolveu — os dois
  // porque as rotas da Evolution divergem entre versões sobre qual aceitam.
  //
  // `instanciaTokenCifrado` é o token exclusivo daquela instância e
  // `webhookSegredoCifrado` é o que autentica o caminho contrário (a Evolution
  // chamando a API). São segredos distintos de propósito: vazar um não entrega
  // o outro, e o do webhook pode ser trocado sem repareamento.
  instanciaExterna      String?
  instanciaId           String?
  instanciaTokenCifrado String? @db.Text
  webhookSegredoCifrado String? @db.Text

  aceiteEm     DateTime?
  aceiteVersao String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  empresa   Empresa            @relation(fields: [empresaId], references: [id])
  vendedor  Vendedor?          @relation(fields: [vendedorId], references: [id])
  conversas WhatsappConversa[]

  @@unique([empresaId, vendedorId])
  @@index([empresaId, status])
  // O webhook da Evolution GO identifica a origem pela instância, não pela
  // sessão: sem este índice, cada mensagem recebida varre a tabela.
  @@index([empresaId, instanciaExterna])
  @@map("whatsapp_sessoes")
}

/**
 * Contato do WhatsApp, identificado pelo `jid` (ex.: `5567999998888@s.whatsapp.net`).
 * `clienteId` é o que separa atendimento de conversa pessoal: sem vínculo, as
 * mensagens **não são persistidas** (ver privacidade no plano). `ignorado`
 * marca o contato que o vendedor declarou como não-cliente, para a tela parar
 * de perguntar.
 */
model WhatsappContato {
  id        String @id @default(uuid())
  empresaId String

  jid                 String
  nomeExibicao        String?
  telefoneNormalizado String?
  tipo                WhatsappTipoContato @default(geral)
  email               String?
  fotoUrl             String?

  clienteId        String?
  /// A pessoa. Quando o número é de alguém que está no cadastro do cliente, é
  /// este contato que dá nome, e-mail e — se houver — acesso ao portal.
  clienteContatoId String?
  vinculadoPor     String?
  vinculadoEm      DateTime?
  ignorado         Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empresa        Empresa            @relation(fields: [empresaId], references: [id])
  cliente        Cliente?           @relation(fields: [clienteId], references: [id])
  clienteContato ClienteContato?    @relation(fields: [clienteContatoId], references: [id])
  conversas      WhatsappConversa[]

  @@unique([empresaId, jid])
  @@index([empresaId, telefoneNormalizado])
  @@index([empresaId, clienteId])
  @@index([empresaId, clienteContatoId])
  @@map("whatsapp_contatos")
}

/**
 * Conversa entre uma sessão (vendedor) e um contato. `clienteId` é
 * desnormalizado do contato para permitir "todas as conversas deste cliente"
 * sem passar por contato — é a consulta do supervisor.
 */
model WhatsappConversa {
  id        String  @id @default(uuid())
  empresaId String
  sessaoId  String
  contatoId String
  clienteId String?

  ultimaMensagemEm DateTime?
  /// Última mensagem **de entrada** (do cliente) nesta conversa — distinto de
  /// `ultimaMensagemEm`, que conta as duas direções. Existe só para a Cloud
  /// API calcular a janela de 24h em que texto livre é aceito pela Meta; os
  /// outros dois transportes não têm essa regra e não leem este campo.
  ultimaMensagemClienteEm DateTime?
  naoLidas         Int       @default(0)
  arquivada        Boolean   @default(false)

  /// Em que ponto do atendimento esta conversa está.
  ///
  /// Só a conversa do número institucional passa por aqui. A do aparelho do
  /// vendedor nasce e morre em `humano`: ela já é dele.
  atendimento WhatsappAtendimentoStatus @default(humano)

  /// Quando a saudação da empresa foi enviada **nesta rodada** de triagem.
  ///
  /// Precisa existir porque a conversa institucional é reaproveitada, não
  /// recriada: encerrar o atendimento devolve a mesma linha para `bot`. Sem
  /// este marcador, contar mensagens enviadas faria a saudação sair uma única
  /// vez na vida da conversa — e o assunto seguinte, meses depois, começaria
  /// no meio. É zerado sempre que a conversa volta para `bot`.
  saudadoEm DateTime?

  /// Vendedor para quem a IA direcionou, ou que assumiu a conversa.
  ///
  /// Enquanto é nulo e o status é `bot` ou `aguardando`, a conversa **não
  /// aparece na tela de Atendimento de ninguém** — é isso que impede o número
  /// institucional de encher a caixa de todo mundo com triagem em andamento.
  atendenteVendedorId String?

  /// O que a IA entendeu que a pessoa quer, em uma linha. Serve para quem
  /// recebe o direcionamento chegar sabendo do que se trata.
  assunto String?

  /// Quando saiu da IA para uma pessoa. Nulo enquanto o bot atende.
  direcionadaEm DateTime?

  /// Quando alguém assumiu o atendimento. Com `direcionadaEm`, dá o tempo que
  /// o cliente esperou depois de a IA entregar; com `createdAt`, o tempo total
  /// desde que ele escreveu pela primeira vez.
  assumidaEm DateTime?

  /// Quando o contato foi associado a um cliente. É o outro indicador pedido:
  /// número que chega desconhecido só vira cadastro quando alguém o vincula, e
  /// quanto tempo isso leva diz se a fila está sendo trabalhada.
  clienteVinculadoEm DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empresa   Empresa                    @relation(fields: [empresaId], references: [id])
  // Restrict, não Cascade: a conversa com o cliente é da empresa, não do
  // aparelho. Vendedor desligado, troca de celular ou limpeza de sessão não
  // podem levar o histórico junto — e com Cascade isso aconteceria em
  // silêncio, num DELETE que ninguém associaria a perder atendimento.
  sessao    WhatsappSessao             @relation(fields: [sessaoId], references: [id], onDelete: Restrict)
  contato   WhatsappContato            @relation(fields: [contatoId], references: [id], onDelete: Restrict)
  cliente   Cliente?                   @relation(fields: [clienteId], references: [id])
  mensagens WhatsappMensagem[]
  acoes     WhatsappAcaoRegistro[]
  agendadas WhatsappMensagemAgendada[]

  @@unique([empresaId, sessaoId, contatoId])
  @@index([empresaId, clienteId])
  @@index([empresaId, sessaoId, ultimaMensagemEm])
  @@map("whatsapp_conversas")
}

/**
 * Mensagem trocada. `externoId` é o id do WhatsApp, e a unicidade por conversa
 * é o que torna o recebimento **idempotente**: na reconexão o provedor reenvia
 * o que já foi entregue, e o mesmo id não pode virar duas linhas.
 * A unicidade é por conversa (e não global) porque o id do WhatsApp só é único
 * dentro do par remetente/destinatário.
 */
model WhatsappMensagem {
  id         String @id @default(uuid())
  empresaId  String
  conversaId String

  externoId String
  direcao   WhatsappDirecao
  tipo      WhatsappTipoMensagem @default(texto)

  conteudo    String? @db.Text
  arquivoUrl  String?
  arquivoNome String?
  arquivoMime String?

  // Preenchido só na saída: qual usuário do sistema mandou.
  enviadaPor    String?
  statusEntrega WhatsappStatusEntrega @default(pendente)
  respondeuA    String?

  criadaEm DateTime @default(now())

  empresa  Empresa          @relation(fields: [empresaId], references: [id])
  conversa WhatsappConversa @relation(fields: [conversaId], references: [id], onDelete: Cascade)
  reacoes  WhatsappReacao[]

  @@unique([empresaId, conversaId, externoId])
  @@index([empresaId, conversaId, criadaEm])
  @@map("whatsapp_mensagens")
}

/**
 * Reação (emoji) a uma mensagem.
 * O WhatsApp trata reação como **substituição**, não acumulação: cada lado tem
 * no máximo uma por mensagem, trocar o emoji sobrescreve e reagir com string
 * vazia remove. Como o atendimento é 1:1, `deQuem` só tem dois valores — daí a
 * unicidade por (mensagem, lado), que é o que faz o upsert funcionar sem
 * duplicar.
 * Fica em tabela própria, e não numa coluna da mensagem, porque reação chega
 * e sai depois da mensagem existir: gravar por cima do registro dela faria a
 * atualização competir com o recebimento.
 */
model WhatsappReacao {
  id         String @id @default(uuid())
  empresaId  String
  mensagemId String

  emoji  String
  deQuem WhatsappLadoReacao

  // Só na saída: qual usuário do sistema reagiu.
  reagiuPor String?

  criadaEm     DateTime @default(now())
  atualizadaEm DateTime @updatedAt

  empresa  Empresa          @relation(fields: [empresaId], references: [id])
  mensagem WhatsappMensagem @relation(fields: [mensagemId], references: [id], onDelete: Cascade)

  @@unique([empresaId, mensagemId, deQuem])
  @@index([empresaId, mensagemId])
  @@map("whatsapp_reacoes")
}

/**
 * De que lado veio a reação — a conversa é 1:1, então são só dois.
 */
enum WhatsappLadoReacao {
  nos
  contato
}

/**
 * Mensagem escrita agora para sair depois.
 * O vendedor prepara a cobrança da manhã seguinte, o retorno combinado para a
 * semana que vem, e a plataforma envia na hora — sem ele precisar lembrar.
 * `status` existe para o envio ser **idempotente entre réplicas da API**: a
 * rotina só processa quem conseguir mudar `pendente` → `enviando` na própria
 * atualização condicional. Sem isso, duas réplicas mandariam a mesma mensagem
 * duas vezes para o cliente.
 */
model WhatsappMensagemAgendada {
  id         String @id @default(uuid())
  empresaId  String
  conversaId String

  texto    String   @db.Text
  enviarEm DateTime

  status     WhatsappAgendamentoStatus @default(pendente)
  /**
   * Preenchido quando o envio falha — é o que a tela mostra ao vendedor.
   */
  erro       String?
  /**
   * Mensagem criada no envio, para ligar o agendamento ao que saiu.
   */
  mensagemId String?

  criadaPor    String
  criadaEm     DateTime @default(now())
  atualizadaEm DateTime @updatedAt

  empresa  Empresa          @relation(fields: [empresaId], references: [id])
  conversa WhatsappConversa @relation(fields: [conversaId], references: [id], onDelete: Cascade)

  // A rotina varre por (status, enviarEm) a cada minuto: sem este índice, é
  // uma varredura na tabela inteira a cada passagem.
  @@index([status, enviarEm])
  @@index([empresaId, conversaId, enviarEm])
  @@map("whatsapp_mensagens_agendadas")
}

enum WhatsappAgendamentoStatus {
  pendente
  enviando
  enviada
  erro
  cancelada
}

/// Recado que a empresa manda para a **própria equipe** pelo número
/// institucional (ver docs/planos/whatsapp-institucional-funcionarios.md).
///
/// **Não alcança cliente**, e isso é decisão de negócio, não limitação: não há
/// envio em massa nesta plataforma. Cliente continua recebendo apenas na
/// conversa individual, onde alguém escreve para alguém.
///
/// Quem dispara é uma pessoa, na tela, vendo a lista de quem vai receber — a
/// IA ajuda a redigir, mas não aperta o botão. Errar por WhatsApp não tem
/// desfazer.
model WhatsappRecadoInterno {
  id        String @id @default(uuid())
  empresaId String

  texto String @db.Text

  /// Nulo = sair agora. Preenchido = a varredura despacha na hora marcada.
  enviarEm DateTime?

  status WhatsappAgendamentoStatus @default(pendente)

  /// Enviar notificação/visualização na plataforma
  enviarPlataforma Boolean @default(true)
  /// Enviar mensagem no WhatsApp da empresa (se conectado)
  enviarWhatsapp   Boolean @default(true)

  /// Quem escreveu. O nome vai junto porque o recado precisa continuar
  /// legível depois que a pessoa sair da empresa.
  criadoPor     String
  criadoPorNome String

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  empresa       Empresa                      @relation(fields: [empresaId], references: [id])
  destinatarios WhatsappRecadoDestinatario[]

  // A varredura procura por (status, enviarEm) a cada minuto.
  @@index([status, enviarEm])
  @@index([empresaId, criadoEm])
  @@map("whatsapp_recados_internos")
}

/// Uma linha por pessoa que deveria receber o recado.
///
/// Existe em vez de uma lista de ids no recado porque o resultado é **por
/// pessoa**: quem não tem telefone no cadastro não recebe, e quem escreveu
/// precisa ver isso na tela. Um status único no recado esconderia justamente
/// o caso que importa — "mandei para a equipe" com metade da equipe de fora.
model WhatsappRecadoDestinatario {
  id        String @id @default(uuid())
  empresaId String
  recadoId  String

  vendedorId String
  /// Nome e telefone no momento do envio, não por join: é o registro do que
  /// de fato aconteceu, e o cadastro muda depois.
  nome       String
  telefone   String?

  status    WhatsappAgendamentoStatus @default(pendente)
  erro      String?
  enviadoEm DateTime?
  lidoEm    DateTime?

  empresa Empresa               @relation(fields: [empresaId], references: [id])
  recado  WhatsappRecadoInterno @relation(fields: [recadoId], references: [id], onDelete: Cascade)

  @@index([empresaId, recadoId])
  @@map("whatsapp_recados_destinatarios")
}

/**
 * O que foi disparado de dentro da conversa (orçamento gerado, visita
 * agendada, boleto reenviado). É o que permite medir se a ferramenta vende.
 * Os ids de destino são colunas simples, **sem relação Prisma**, de propósito:
 * isto é registro de auditoria e precisa sobreviver à remoção do orçamento ou
 * da atividade que originou.
 */
model WhatsappAcaoRegistro {
  id         String @id @default(uuid())
  empresaId  String
  conversaId String

  acao            String
  orcamentoId     String?
  atividadeId     String?
  tituloReceberId String?
  detalhe         Json?

  executadaPor String?
  criadaEm     DateTime @default(now())

  empresa  Empresa          @relation(fields: [empresaId], references: [id])
  conversa WhatsappConversa @relation(fields: [conversaId], references: [id], onDelete: Cascade)

  @@index([empresaId, conversaId, criadaEm])
  @@map("whatsapp_acoes")
}

/**
 * Configuração do WhatsApp por empresa (singleton, padrão do AgenteConfig).
 * Separada da sessão de propósito: a sessão é do vendedor e é volátil (cai,
 * repareia, é banida); isto aqui é decisão da empresa e vale para todas elas.
 * `workerUrl` aponta para o serviço que mantém as conexões de pé
 * (`apps/whatsapp-worker`). Fica em configuração e não em env por causa da
 * troca de transporte: a Cloud API não tem worker, e a migração é gradual.
 */
model WhatsappConfig {
  id        String  @id @default(uuid())
  empresaId String  @unique
  ativo     Boolean @default(false)

  transporte WhatsappTransporte @default(zapo)
  workerUrl  String?

  // Evolution GO — usados só quando `transporte = evolution_go`.
  //
  // A chave é administrativa (a `GLOBAL_API_KEY` do serviço): quem a tem cria,
  // conecta e apaga instância de qualquer vendedor. Por isso vai cifrada, com
  // o mesmo AES-256-GCM da chave do agente de IA, e nunca é devolvida por
  // nenhuma rota de leitura.
  evolutionUrl           String?
  evolutionApiKeyCifrada String? @db.Text
  // Registrada por quem implantou. Diferença de versão é a primeira hipótese
  // quando um evento (resposta citada, reação) para de chegar.
  evolutionVersao        String?

  // `advancedSettings` da instância na Evolution GO.
  //
  // Eram fixos no código, no corpo do `POST /instance/create`, e portanto só
  // valiam para instância nova — não havia como rever a decisão depois. Ficam
  // aqui porque são **política da empresa**, não do aparelho: a mesma regra
  // vale para todos os vendedores dela.
  //
  // Os defaults reproduzem exatamente o que estava fixo no código até
  // 2026-09-21, então ligar isto não muda o comportamento de ninguém.
  // Atualizar depois de criada usa `PUT /instance/{id}/advanced-settings`.
  evolutionAlwaysOnline  Boolean @default(false)
  /// Grupo não faz parte do atendimento; ignorar na origem evita tráfego que a
  /// API descartaria de qualquer forma.
  evolutionIgnoreGroups  Boolean @default(true)
  evolutionIgnoreStatus  Boolean @default(true)
  /// Quem marca como lida é o vendedor, abrindo a conversa. Ligar isto manda o
  /// visto azul ao cliente sem ninguém ter lido.
  evolutionReadMessages  Boolean @default(false)
  /// Recusar chamada automaticamente. A mensagem abaixo só sai quando ligado.
  evolutionRejectCall    Boolean @default(false)
  evolutionMsgRejectCall String?

  // Cloud API (Meta) — usados só quando `transporte = cloud_api`.
  //
  // Sem pareamento por QR: quem autentica é o Phone Number ID + o token de
  // acesso, cadastrados no Business Manager da Meta. O App Secret assina o
  // webhook (HMAC-SHA256 do corpo bruto) — segredo distinto do token, mesmo
  // raciocínio da chave administrativa x token de instância na Evolution GO.
  cloudApiPhoneNumberId     String?
  cloudApiBusinessAccountId String?
  cloudApiAccessTokenCifrada String? @db.Text
  cloudApiAppSecretCifrada   String? @db.Text
  // Não é segredo de tráfego (não autentica nada sozinho, só o handshake de
  // verificação do webhook) — por isso fica em claro, ao contrário dos dois
  // campos acima. O administrador precisa relê-lo para colar no painel da
  // Meta.
  cloudApiWebhookVerifyToken String?

  // DDD a usar quando o telefone do cadastro vem sem ele — o que é a regra,
  // não a exceção, nesta base (8 ou 9 dígitos na maioria das linhas). Fica
  // nulo de propósito até alguém configurar: completar número de telefone por
  // dedução manda mensagem para a pessoa errada.
  dddPadrao String?

  // 0 = sem expurgo. A rotina que apaga é da Fatia 3 (governança); a decisão
  // de por quanto tempo guardar é da empresa e nasce aqui.
  retencaoDias Int @default(0)

  // ---------------------------------------------------------------
  // Atendimento pela IA no número institucional
  // ---------------------------------------------------------------

  /// Liga a triagem por IA no número da empresa. Desligada, o institucional se
  /// comporta como qualquer outro número: a mensagem entra e fica aguardando
  /// alguém — sem bot no meio.
  atendimentoIaAtivo Boolean @default(false)

  /// Primeira fala do atendimento, escrita pela empresa. Não vai ao modelo: é
  /// o texto que a empresa quer que o cliente leia, e deixar o modelo compor a
  /// saudação faz a mesma empresa soar diferente a cada conversa.
  atendimentoSaudacao String? @db.Text

  /// O que a IA pode responder sobre a empresa — horário, endereço, formas de
  /// pagamento, prazos. Vai no prompt como contexto.
  ///
  /// Vazio não é problema: sem isto a IA identifica e direciona, que é o
  /// mínimo. O que ela **não** faz é inventar — o prompt manda dizer que vai
  /// verificar com alguém.
  atendimentoInformacoes String? @db.Text

  /// Minutos de silêncio do cliente antes de a conversa em `bot` ser
  /// encerrada. 0 desliga o encerramento automático.
  ///
  /// Existe porque conversa parada no meio da triagem não chega a ninguém: ela
  /// não está com a IA nem com uma pessoa, e some da vista de todos.
  atendimentoInatividadeMin Int @default(30)

  // Quantos dias de histórico do celular importar quando a instância conecta.
  // 0 = nenhum, só o que chega ao vivo — é o padrão, porque puxar conversa
  // antiga traz para o servidor o que ninguém pediu para trazer.
  //
  // Não confundir com `retencaoDias`: aquele diz por quanto tempo se guarda o
  // que já entrou; este, o quanto se vai buscar para trás.
  historicoDias Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@map("whatsapp_config")
}

/**
 * Mirror local dos templates aprovados no Business Manager da Meta — só a
 * Cloud API os usa. Existe para a tela escolher um template sem chamar a
 * Graph API a cada clique; `sincronizarTemplates` (Administração > WhatsApp >
 * API Oficial) é quem mantém isto atualizado, puxando
 * `GET /{businessAccountId}/message_templates`.
 */
model WhatsappTemplate {
  id        String @id @default(uuid())
  empresaId String

  /// Id do template no lado da Meta — a chave de upsert da sincronização.
  metaId String
  nome   String
  idioma String

  /// MARKETING | UTILITY | AUTHENTICATION — como a Meta classifica.
  categoria String
  /// APPROVED | PENDING_REVIEW | REJECTED | PAUSED | DISABLED — só
  /// `APPROVED` pode ser enviado; os demais aparecem na tela só para
  /// acompanhamento.
  status String

  /// Estrutura de componentes (header/body/footer/buttons) como a Meta
  /// devolveu — usada para montar o corpo do envio (`components[].parameters`).
  componentes Json

  sincronizadoEm DateTime @default(now())

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@unique([empresaId, metaId])
  @@map("whatsapp_templates")
}

/**
 * Respostas rápidas / atalhos (/pix, /horario, /catalogo) cadastrados para uso
 * no chat de atendimento por WhatsApp.
 */
model WhatsappRespostaRapida {
  id        String @id @default(uuid())
  empresaId String

  /// O comando do atalho sem a barra (ex: "pix", "catalogo", "segundavia").
  atalho String
  titulo String
  /// O texto completo da mensagem. Pode incluir variáveis como {nome_cliente}.
  conteudo String @db.Text

  criadoPor String?
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@unique([empresaId, atalho])
  @@index([empresaId])
  @@map("whatsapp_respostas_rapidas")
}

/**
 * Notificação do sino, uma linha por destinatário.
 * O feed é lido **só desta tabela** (fonte única): o que antes era derivado do
 * dado vivo — conversa não lida, atividade vencida — agora é registrado aqui
 * por quem provoca o fato. É o que permite ter "lido" de verdade, histórico e
 * uma consulta única no sino, no lugar de uma varredura por origem a cada
 * passagem.
 * O preço é a coerência: quem marca a conversa como lida precisa marcar as
 * notificações dela junto, senão o sino insiste em algo que o vendedor já viu.
 * Ver `NotificacoesService`.
 */
model Notificacao {
  id        String @id @default(uuid())
  empresaId String
  /**
   * Destinatário. Vendedor sem usuário vinculado não gera notificação.
   */
  usuarioId String

  tipo      NotificacaoTipo
  titulo    String
  descricao String?
  /**
   * Para onde a linha do sino leva. Nulo = notificação sem destino.
   */
  rota      String?

  /**
   * Entidade que originou (conversa, atividade, título…). É por ela que a
   * notificação é deduplicada enquanto não lida e marcada em lote quando a
   * origem é resolvida — ver o índice parcial único na migration.
   */
  referenciaId String?
  /**
   * Ocorrências agrupadas nesta linha: as mensagens novas da conversa.
   */
  contador     Int     @default(1)

  /**
   * Quando o fato aconteceu — ordena o feed. Pode ser anterior a `criadaEm`:
   * a varredura de vencimento roda depois da data que ela anuncia.
   */
  ocorridaEm DateTime
  lidaEm     DateTime?

  criadaEm     DateTime @default(now())
  atualizadaEm DateTime @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id])
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  // O sino pergunta sempre a mesma coisa: as não lidas deste usuário, mais
  // recentes primeiro.
  @@index([empresaId, usuarioId, lidaEm, ocorridaEm])
  // Marcar em lote ao resolver a origem (conversa lida, atividade concluída).
  @@index([empresaId, tipo, referenciaId])
  @@map("notificacoes")
}

enum NotificacaoTipo {
  whatsapp_mensagem
  whatsapp_agendamento_erro
  atividade_vencimento
  orcamento_aprovado
  orcamento_recusado
  cliente_atribuido
  titulo_vencido
  /// Cliente esperando alguem assumir no numero institucional.
  whatsapp_aguardando
  /// Lead captado pela IA no numero institucional, aguardando alguem.
  lead_novo
  /// Recado interno da equipe enviado para o usuário.
  recado_interno
}

/// Em que ponto o lead está. Deliberadamente curto: um funil de lead com sete
/// estágios vira campo que ninguém atualiza, e o funil de verdade é o de
/// Oportunidade, que começa depois de o lead virar cliente.
enum LeadSituacao {
  novo
  em_atendimento
  convertido
  descartado
}

/// O quanto o lead parece pronto para comprar.
///
/// Três níveis, e não uma nota de 0 a 100: a IA está inferindo de uma conversa
/// curta, e uma escala fina daria à estimativa uma precisão que ela não tem.
enum LeadTemperatura {
  quente
  morno
  frio
}

/// Alguém que procurou a empresa e ainda não é cliente.
///
/// **Não é `Oportunidade`**, e a diferença não é de nome: aquela exige
/// `clienteId` e `vendedorId` — ela é o funil de quem já é cliente e já tem
/// dono. Um lead é anterior aos dois, e forçá-lo naquele modelo obrigaria a
/// inventar um cliente para cada curioso que manda mensagem.
model Lead {
  id        String @id @default(uuid())
  empresaId String

  /// Como a pessoa se identificou. **Nada aqui é verificado** — é o que ela
  /// disse na conversa, e a IA anotou.
  nome             String?
  empresaInformada String?
  documento        String?

  /// De onde veio. É o único dado que não depende do que ela diz.
  telefone String

  /// O que procura, em uma linha, escrito pela IA a partir da conversa.
  interesse String @db.Text

  temperatura LeadTemperatura @default(morno)

  /// Por que a IA classificou assim. Sem isto, a temperatura é um palpite que
  /// ninguém consegue conferir — e quem recebe o lead precisa decidir se
  /// concorda antes de investir tempo nele.
  motivoClassificacao String? @db.Text

  situacao LeadSituacao @default(novo)

  /// Preenchidos quando alguém assume ou direciona.
  vendedorId  String?
  assumidoPor String?
  assumidoEm  DateTime?

  /// A conversa que o originou. Um lead por conversa: a IA reescreve o mesmo
  /// registro conforme descobre mais, em vez de criar um por mensagem.
  conversaId String?

  observacao String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@unique([empresaId, conversaId])
  @@index([empresaId, situacao, createdAt])
  @@map("leads")
}

/// Comunicado interno exibido na tela inicial (Início).
///
/// É o "mural" da empresa: quem tem `comunicados.cadastrar` publica, e todo
/// usuário logado vê na entrada do sistema o que estiver **vigente** e
/// endereçado ao perfil dele. Não é notificação: não tem destinatário
/// individual, não tem "lido" e não some quando alguém abre — some quando o
/// prazo acaba.
model Comunicado {
  id        String @id @default(uuid())
  empresaId String

  titulo String
  texto  String @db.Text

  /// Aparece a partir daqui. Publicar com data futura é o jeito de deixar
  /// pronto e agendado.
  inicioEm DateTime  @default(now())
  /// Some depois daqui. Nulo = fica até alguém desativar — comunicado sem
  /// prazo é o caso comum (regra interna, aviso permanente).
  fimEm    DateTime?

  /// Sobe ao topo do mural, com destaque visual. Um por vez, na prática.
  fixado Boolean @default(false)
  ativo  Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  empresa Empresa            @relation(fields: [empresaId], references: [id])
  /// Perfis que enxergam. **Lista vazia = todo mundo** — é o caso comum, e
  /// exigir marcar todos os perfis para "todos" faria o cadastro errar por
  /// omissão (perfil novo não veria nada).
  perfis  ComunicadoPerfil[]

  // A consulta do mural é sempre a mesma: vigentes desta empresa, fixado
  // primeiro.
  @@index([empresaId, ativo, inicioEm])
  @@map("comunicados")
}

/// Destino do comunicado, por perfil. Tem `empresaId` (e RLS) mesmo sendo
/// tabela de junção: sem ele a linha seria legível de qualquer tenant por uma
/// consulta direta, e o Postgres deixaria passar.
model ComunicadoPerfil {
  empresaId    String
  comunicadoId String
  perfilId     String

  comunicado Comunicado @relation(fields: [comunicadoId], references: [id], onDelete: Cascade)
  perfil     Perfil     @relation(fields: [perfilId], references: [id])
  empresa    Empresa    @relation(fields: [empresaId], references: [id])

  @@id([comunicadoId, perfilId])
  @@index([empresaId, perfilId])
  @@map("comunicado_perfis")
}

/// Horário em que a **empresa** atende, por dia da semana.
///
/// Não confundir com `UsuarioHorario`, que é o expediente de uma pessoa e serve
/// para barrar login fora de hora. Este aqui é o horário comercial da empresa:
/// é o que decide se o WhatsApp institucional responde "já te atendo" ou "seu
/// retorno é na terça", e o que a triagem usa para marcar retorno.
///
/// Um dia pode ter mais de uma faixa (manhã e tarde, com intervalo de almoço).
model EmpresaHorarioAtendimento {
  id        String @id @default(uuid())
  empresaId String

  /// 0 = domingo … 6 = sábado.
  diaSemana  Int
  /// "HH:MM", no fuso da empresa.
  horaInicio String
  horaFim    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@unique([empresaId, diaSemana, horaInicio])
  @@index([empresaId, diaSemana])
  @@map("empresa_horarios_atendimento")
}

/// Dia em que a empresa não atende.
///
/// Guardado como data cheia, e não como dia/mês, mesmo para os fixos: feriado
/// móvel (Carnaval, Sexta-feira Santa, Corpus Christi) não tem dia fixo, e
/// misturar dois formatos na mesma tabela obrigaria toda consulta a tratar os
/// dois casos. O sistema gera os do ano; quem quiser acrescenta os locais.
model Feriado {
  id        String @id @default(uuid())
  empresaId String

  data DateTime @db.Date
  nome String

  /// De onde veio, e é o que autoriza o sistema a regerar sem apagar o que
  /// alguém cadastrou à mão.
  origem OrigemFeriado @default(manual)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@unique([empresaId, data])
  @@index([empresaId, data])
  @@map("feriados")
}

/// Quem cadastrou o feriado.
enum OrigemFeriado {
  /// Data fixa no calendário nacional (Natal, Tiradentes…). Gerado pelo sistema.
  nacional_fixo
  /// Depende da Páscoa (Carnaval, Sexta-feira Santa, Corpus Christi). Calculado.
  nacional_movel
  /// Cadastrado por alguém da empresa: feriado municipal, aniversário da
  /// cidade, ponto facultativo que a empresa decidiu emendar.
  manual
}
