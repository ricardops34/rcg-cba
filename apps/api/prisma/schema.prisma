model PortalClienteRotina {
  id     String  @id
  codigo String  @unique
  nome   String
  ordem  Int     @default(0)
  ativo  Boolean @default(true)

  permissoes PortalClientePerfilPermissao[]

  @@map("portal_cliente_rotinas")
