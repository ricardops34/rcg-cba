generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------
// Identidade & acesso
// ------------------------------------------------------------------

model Empresa {
  tipoPessoa   TipoPessoa @default(juridica)
  id           String     @id @default(uuid())
  razaoSocial  String
  nomeFantasia String
  cnpj         String     @unique
  alias        String?    @unique
  logoUrl      String?

  /// Define se esta empresa é a gestora/administradora da plataforma SaaS.
  ePlataforma  Boolean    @default(false)

  // Situação da assinatura — **fonte única do "pode entrar"**. Substituiu o
  // `ativo` booleano: manter os dois obrigaria a mantê-los coerentes, e dois
  // campos que precisam concordar já se provaram um defeito neste schema
  // (ver a migration 20260903120000_vendedor_superior). Quem decide o acesso
  // é `podeAcessar()`, em situacao-empresa.ts, e ninguém mais.
  situacao SituacaoEmpresa @default(ativa)

  // Fim do período de avaliação. Só faz sentido com `situacao = teste`; a
  // varredura diária expira quem passou da data. Nulo em teste significa
  // avaliação sem prazo definido — liberada até alguém encerrar na mão.
  testeExpiraEm DateTime?

  // Teto de usuários com vínculo ativo. Nulo = sem limite. Conferido na
  // criação do vínculo, não do usuário: a mesma pessoa pode atender duas
  // empresas, e quem consome a licença é o vínculo.
  limiteUsuarios Int?

  /// Fuso em que a empresa opera, no formato IANA (ex.: America/Campo_Grande).
  ///
  /// Era uma constante no código, e isso só funcionava porque havia uma
  /// empresa. Com várias, "18:00" não quer dizer o mesmo instante em Campo
  /// Grande e em Belém — e o atendimento fecharia na hora errada para quem
  /// estivesse fora do fuso do servidor.
  fusoHorario String @default("America/Campo_Grande")

  // Faixa institucional no topo do sistema (associação, certificação, grupo).
  // Era fixa no código — magenta e a imagem da allia, iguais para todo mundo,
  // na tela de login e dentro do sistema. Virou configuração por empresa
  // porque é marca de terceiro: a empresa que não é associada não deve exibir,
  // e quem é associada a outra coisa exibe a sua.
  //
  // Fica só **dentro** do sistema. Na tela de login não há empresa definida
  // até o usuário entrar, e mostrar a faixa de uma empresa para quem vai
  // logar em outra seria pior do que não mostrar nada.
  bannerAtivo     Boolean @default(false)
  // Cor de fundo em hexadecimal (#rrggbb). Nula usa a cor da marca do tema.
  bannerCor       String?
  // Caminho relativo da imagem, como logoUrl — gravado pelo upload.
  bannerImagemUrl String?

  // Identificação fiscal e contato — o que sai no cabeçalho de documentos
  // emitidos pro cliente (hoje a proposta em PDF do orçamento). Todos
  // opcionais: empresa cadastrada antes destes campos continua válida.
  inscricaoEstadual  String?
  inscricaoMunicipal String?
  endereco           String?
  complemento        String?
  bairro             String?
  municipio          String?
  uf                 String?
  cep                String?
  telefone           String?
  email              String?
  site               String?

  // ---------------------------------------------------------------
  // O que a IA pode contar sobre a empresa
  // ---------------------------------------------------------------
  // Estes entram no prompt do atendimento institucional. O resto da ficha
  // (endereço, telefone, e-mail, site, horários) já existia acima e passou a
  // ir junto — antes era preciso redigitar tudo no campo de texto livre de
  // Administração > WhatsApp, e o que estava no cadastro nunca chegava à IA.

  /// Telefone e e-mail alternativos, para quem atende em mais de um número.
  telefone2 String?
  email2    String?

  /// Data de fundação. Vira "no mercado desde 1998" na resposta da IA — e é o
  /// tipo de pergunta que um cliente novo faz antes de comprar.
  fundadaEm DateTime?

  /// A história da empresa, escrita por ela. Texto livre porque é narrativa:
  /// campo estruturado transformaria isso em formulário e a resposta sairia
  /// picotada.
  historia String? @db.Text

  /// Em que a empresa atua ("distribuição de bebidas, food service"). Uma
  /// linha, não uma taxonomia: serve para a IA saber se o que a pessoa procura
  /// é com a empresa, e taxonomia exigiria um cadastro que ninguém pediu.
  segmentos String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  usuarioEmpresas            UsuarioEmpresa[]
  produtos                   Produto[]
  produtoFotos               ProdutoFoto[]
  vendedores                 Vendedor[]
  clientes                   Cliente[]
  categorias                 Categoria[]
  condicoesPagamento         CondicaoPagamento[]
  armazens                   Armazem[]
  estoques                   Estoque[]
  tabelasPreco               TabelaPreco[]
  regrasDesconto             RegraDesconto[]
  regrasDescontoFaixas       RegraDescontoFaixa[]
  tabelasPrecoItens          TabelaPrecoItem[]
  notasSaida                 NotaSaida[]
  notasSaidaItens            NotaSaidaItem[]
  notasSaidaXml              NotaSaidaXml[]
  titulosReceber             TituloReceber[]
  titulosReceberBaixas       TituloReceberBaixa[]
  contasBancarias            ContaBancaria[]
  oportunidades              Oportunidade[]
  atividades                 Atividade[]
  objetivosVendedorMes       ObjetivoVendedorMes[]
  objetivosVendedorCategoria ObjetivoVendedorCategoria[]
  orcamentos                 Orcamento[]
  orcamentoItens             OrcamentoItem[]
  integracaoApiKeys          IntegracaoApiKey[]
  integracaoEndpointConfigs   IntegracaoEndpointConfig[]
  clienteCampoConfigs        ClienteCampoConfig[]
  produtoCampos              ProdutoCampo[]
  produtoCampoValores        ProdutoCampoValor[]
  produtoRelacionados        ProdutoRelacionado[]
  produtoFichas              ProdutoFicha[]
  agenteAnexos               AgenteAnexo[]
  fichaImportacoes           ProdutoFichaImportacao[]
  fichaTrechos               ProdutoFichaTrecho[]
  orcamentoConfig            OrcamentoConfig?
  parametros                 ParametroEmpresa[]
  clienteCnaes               ClienteCnae[]
  clienteAlteracoes          ClienteAlteracao[]
  clienteHistorico           ClienteHistorico[]
  sugestoesCompra            SugestaoCompraGerada[]
  agenteConfig               AgenteConfig?
  agenteCredenciais          AgenteCredencial[]
  agenteFerramentas          AgenteFerramenta[]
  agenteFerramentaAuditoria  AgenteFerramentaAuditoria[]
  agenteConversas            AgenteConversa[]
  agenteMensagens            AgenteMensagem[]
  whatsappConfig             WhatsappConfig?
  whatsappSessoes            WhatsappSessao[]
  whatsappContatos           WhatsappContato[]
  whatsappConversas          WhatsappConversa[]
  whatsappMensagens          WhatsappMensagem[]
  whatsappReacoes            WhatsappReacao[]
  whatsappAgendadas          WhatsappMensagemAgendada[]
  whatsappAcoes              WhatsappAcaoRegistro[]
  whatsappVinculos           WhatsappVinculoFuncionario[]
  whatsappTemplates          WhatsappTemplate[]
  whatsappRespostasRapidas   WhatsappRespostaRapida[]
  leads                      Lead[]
  whatsappRecados            WhatsappRecadoInterno[]
  whatsappRecadoDestinos     WhatsappRecadoDestinatario[]
  notificacoes               Notificacao[]
  comunicados                Comunicado[]
  comunicadoPerfis           ComunicadoPerfil[]
  portalClienteConfig        PortalClienteConfig?
  portalClientePerfis        PortalClientePerfil[]
  portalClientePermissoes    PortalClientePerfilPermissao[]
  portalClienteHabilitacoes  PortalClienteHabilitacao[]
  clienteContatos            ClienteContato[]
  empresaHorarioAtendimentos EmpresaHorarioAtendimento[]
  feriados                   Feriado[]
  fornecedores               Fornecedor[]
  notasEntrada               NotaEntrada[]
  notasEntradaItens          NotaEntradaItem[]
  tourExecucoes              TourExecucao[]
  modulosDesativados         EmpresaModulo[]
  menusDesativados           EmpresaMenu[]
  rotinasDesativadas         EmpresaRotina[]
  assinatura                 Assinatura?
  suporteAcessos             EmpresaSuporteAcesso[]
  suporteLogs                EmpresaSuporteLog[]

  @@map("empresas")
}

model Usuario {
  id          String    @id @default(uuid())
  nome        String
  email       String    @unique
  senhaHash   String
  ativo       Boolean   @default(true)
  ultimoLogin DateTime?
  primeiroAcessoConcluidoEm DateTime?
  avatarUrl   String?
  mfaEnabled  Boolean   @default(false)

  // Política de senha (parâmetros SENHA_* por empresa): senhaAlteradaEm
  // marca a "idade" da senha atual para cálculo de expiração; tentativasFalhas
  // e bloqueadoAte implementam o lockout de login; deveTrocarSenha força a
  // troca no próximo login após um reset feito por admin.
  senhaAlteradaEm  DateTime?
  tentativasFalhas Int       @default(0)
  bloqueadoAte     DateTime?
  deveTrocarSenha  Boolean   @default(false)

  // Restrição de expediente (ver UsuarioHorario): quando false — o padrão —
  // o usuário acessa a qualquer hora. Ligada, o login e cada requisição
  // autenticada passam a exigir que o momento esteja dentro de uma das faixas
  // cadastradas, no fuso da operação. O flag separado é necessário porque
  // "nenhuma faixa cadastrada" significa coisas opostas nos dois casos.
  restringirHorario Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  // Papel do usuário dentro da administração da plataforma (SaaS)
  perfilPlataformaRole PerfilPlataformaRole?

  usuarioEmpresas             UsuarioEmpresa[]
  refreshTokens               RefreshToken[]
  vendedores                  Vendedor[]
  senhaHistorico              SenhaHistorico[]
  horarios                    UsuarioHorario[]
  acessos                     AcessoLog[]
  sessoes                     Sessao[]
  notificacoes                Notificacao[]
  whatsappVinculos            WhatsappVinculoFuncionario[]
  termosAceites               TermoAceite[]
  tourExecucoes               TourExecucao[]
  suporteConcessoesConcedidas EmpresaSuporteAcesso[]        @relation("SuporteConcedidoPor")
  suporteConcessoesRevogadas  EmpresaSuporteAcesso[]        @relation("SuporteRevogadoPor")
  suporteAcoesRealizadas      EmpresaSuporteLog[]           @relation("SuporteAcoesRealizadas")

  @@map("usuarios")
}

// Documentos contratuais da plataforma são globais: a conta do usuário é uma
// só mesmo quando participa de várias empresas. Uma versão publicada é
// imutável; alteração de conteúdo nasce como outra linha/versão.
model TermoDocumento {
  id           String    @id @default(uuid())
  codigo       String
  versao       String
  tipo         TermoTipo
  titulo       String
  resumo       String
  conteudo     String
  conteudoHash String
  obrigatorio  Boolean   @default(true)
  publicadoEm  DateTime
  vigenteEm    DateTime
  revogadoEm   DateTime?
  createdAt    DateTime  @default(now())

  aceites TermoAceite[]

  @@unique([codigo, versao])
  @@index([obrigatorio, vigenteEm])
  @@map("termo_documentos")
}

enum TermoTipo {
  termos_uso
  aviso_privacidade
}

// Evidência imutável do aceite. `empresaContextoId` registra onde a sessão
// estava no momento, mas não muda o escopo: o aceite continua sendo da conta,
// sem empresaId de negócio e, portanto, sem RLS por tenant.
model TermoAceite {
  id                String   @id @default(uuid())
  termoId           String
  usuarioId         String
  empresaContextoId String?
  aceitoEm          DateTime @default(now())
  ip                String?
  userAgent         String?
  conteudoHash      String
  declaracao        String

  termo   TermoDocumento @relation(fields: [termoId], references: [id])
  usuario Usuario        @relation(fields: [usuarioId], references: [id])

  @@unique([termoId, usuarioId])
  @@index([usuarioId, aceitoEm])
  @@map("termo_aceites")
}

enum TourOrigem {
  automatico
  manual
}

enum TourStatus {
  em_andamento
  concluido
  dispensado
}

/// Cada início (inclusive uma repetição manual) gera uma execução. O
/// histórico permite saber qual versão foi apresentada e onde foi encerrada.
model TourExecucao {
  id           String     @id @default(uuid())
  empresaId    String
  usuarioId    String
  tourCodigo   String
  versao       Int
  origem       TourOrigem
  status       TourStatus @default(em_andamento)
  passoAtual   Int        @default(0)
  iniciadoEm   DateTime   @default(now())
  finalizadoEm DateTime?
  updatedAt    DateTime   @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id])
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([empresaId, usuarioId, tourCodigo, versao, iniciadoEm], map: "tour_execucoes_usuario_versao_idx")
  @@map("tour_execucoes")
}

/**
 * Faixa de expediente de um usuário, uma por dia da semana (0 = domingo …
 * 6 = sábado). Dia sem linha = sem acesso naquele dia, quando
 * `Usuario.restringirHorario` está ligado.
 * Horas ficam como texto "HH:MM" de propósito: é hora de parede no fuso da
 * operação (America/Campo_Grande), não um instante — guardar em DateTime
 * traria fuso e data junto, que não têm significado aqui.
 * Sem `empresaId`: a trava é da conta (login é global, como a política de
 * senha), não do vínculo com uma empresa. Por isso não tem RLS.
 */
model UsuarioHorario {
  id         String @id @default(uuid())
  usuarioId  String
  diaSemana  Int
  horaInicio String
  horaFim    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@unique([usuarioId, diaSemana])
  @@map("usuario_horarios")
}

// Vínculo usuário×empresa: perfil (RBAC) + hierarquia/dados de vendedor
// nessa empresa (ver docs/regras-de-negocio.md). Um usuário multiempresa tem
// um registro aqui por empresa, cada um com seu próprio perfil/superior. O
// perfil sistemaBase enxerga tudo da empresa sem restrição de carteira; os
// demais são escopados pela árvore superiorId, qualquer que seja o perfil.
model UsuarioEmpresa {
  id        String  @id @default(uuid())
  usuarioId String
  empresaId String
  perfilId  String
  ativo     Boolean @default(true)

  superiorId     String?
  codigoErp      String?
  nomeReduzido   String?
  telefone       String?
  celular        String?
  dataNascimento DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  usuario   Usuario          @relation(fields: [usuarioId], references: [id])
  empresa   Empresa          @relation(fields: [empresaId], references: [id])
  perfil    Perfil           @relation(fields: [perfilId], references: [id])
  superior  UsuarioEmpresa?  @relation("UsuarioEmpresaHierarquia", fields: [superiorId], references: [id])
  liderados UsuarioEmpresa[] @relation("UsuarioEmpresaHierarquia")

  @@unique([usuarioId, empresaId])
  @@map("usuario_empresas")
}

// Perfil (papel RBAC) é global — compartilhado por todas as empresas, sem
// empresaId/RLS (mesmo precedente de Modulo/Menu/Rotina). Cada vínculo
// usuário×empresa (UsuarioEmpresa) escolhe um perfil dessa lista global.
model Perfil {
  id                   String  @id @default(uuid())
  nome                 String
  descricao            String?
  sistemaBase          Boolean @default(false)
  // Autoriza mutações no catálogo global e a área /plataforma (PlatformAdminGuard).
  // Independente de sistemaBase: sistemaBase é acesso total DENTRO da empresa
  // (liga isAdmin), administraPlataforma é acesso ACIMA de qualquer empresa.
  // Veio do antigo Usuario.administradorPlataforma — um atributo do usuário
  // não bate com "perfil escolhido por vínculo empresa a empresa" (o mesmo
  // usuário podia ter perfis diferentes em cada empresa, mas era admin da
  // plataforma em todas ao mesmo tempo, sem meio-termo). Não entra em
  // PerfilCreate/PerfilUpdate — só o seed e a migration concedem, para não
  // abrir escalonamento de privilégio pela tela de Perfis/Usuários.
  administraPlataforma Boolean @default(false)
  ativo                Boolean @default(true)
  rotinaInicialId      String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  rotinaInicial     Rotina?                 @relation("PerfilRotinaInicial", fields: [rotinaInicialId], references: [id])
  usuarioEmpresas   UsuarioEmpresa[]
  permissoes        PerfilPermissao[]
  agenteFerramentas AgenteFerramentaPerfil[]
  comunicados       ComunicadoPerfil[]

  @@unique([nome])
  @@map("perfis")
}

model Modulo {
  id                    String  @id @default(uuid())
  nome                  String
  icone                 String?
  ordem                 Int     @default(0)
  ativo                 Boolean @default(true)
  disponivelTelaPequena Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  menus     Menu[]
  ativacoes EmpresaModulo[]
  planos    PlanoModulo[]

  @@map("modulos")
}

// Liga/desliga de módulo **para uma empresa**, sem tocar no catálogo.
//
// O catálogo (Modulo/Menu/Rotina) é global: o `ativo` de lá vale para todos os
// clientes, e só administrador da plataforma mexe nele. Estas duas tabelas são
// o outro lado — o administrador de uma empresa decide o que a empresa dele usa.
//
// **Ausência de linha significa ligado.** Gravar só a exceção evita ter de criar
// uma linha por empresa × módulo a cada empresa ou módulo novo, e faz o módulo
// recém-criado já nascer disponível para todo mundo.
//
// Tem `empresaId`, logo tem RLS (ver prisma/migrations/README.md).
model EmpresaModulo {
  id        String  @id @default(uuid())
  empresaId String
  moduloId  String
  ativo     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  empresa Empresa @relation(fields: [empresaId], references: [id])
  modulo  Modulo  @relation(fields: [moduloId], references: [id])

  @@unique([empresaId, moduloId])
  @@map("empresa_modulos")
}

/// Mesma ideia de `EmpresaModulo`, um nível abaixo: a empresa usa o módulo, mas
/// não esta tela dele.
model EmpresaMenu {
  id        String  @id @default(uuid())
  empresaId String
  menuId    String
  ativo     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  empresa Empresa @relation(fields: [empresaId], references: [id])
  menu    Menu    @relation(fields: [menuId], references: [id])

  @@unique([empresaId, menuId])
  @@map("empresa_menus")
}

/// Liga/desliga de rotina **para uma empresa**, completando o trio com EmpresaModulo e EmpresaMenu.
model EmpresaRotina {
  id        String  @id @default(uuid())
  empresaId String
  rotinaId  String
  ativo     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  empresa Empresa @relation(fields: [empresaId], references: [id])
  rotina  Rotina  @relation(fields: [rotinaId], references: [id])

  @@unique([empresaId, rotinaId])
  @@map("empresa_rotinas")
}

model Menu {
  id                    String  @id @default(uuid())
  moduloId              String
  menuPaiId             String?
  nome                  String
  icone                 String?
  rota                  String?
  ordem                 Int     @default(0)
  ativo                 Boolean @default(true)
  disponivelTelaPequena Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  modulo    Modulo        @relation(fields: [moduloId], references: [id])
  menuPai   Menu?         @relation("MenuSubmenu", fields: [menuPaiId], references: [id])
  submenus  Menu[]        @relation("MenuSubmenu")
  rotinas   Rotina[]
  ativacoes EmpresaMenu[]
  planos    PlanoMenu[]

  @@map("menus")
}

model Rotina {
  id                    String  @id @default(uuid())
  menuId                String
  nome                  String
  codigo                String
  ativo                 Boolean @default(true)
  disponivelTelaPequena Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  menu                Menu              @relation(fields: [menuId], references: [id])
  permissoes          PerfilPermissao[]
  ativacoes           EmpresaRotina[]
  planos              PlanoRotina[]
  perfisRotinaInicial Perfil[]          @relation("PerfilRotinaInicial")

  @@unique([codigo])
  @@map("rotinas")
}

enum SituacaoAssinatura {
  ativa
  teste
  atrasada
  suspensa
  cancelada
}

enum CicloPagamento {
  mensal
  trimestral
  semestral
  anual
}

/// Plano / Pacote de funcionalidades do SaaS (Básico, Profissional, Enterprise, Custom).
model Plano {
  id              String   @id @default(uuid())
  nome            String
  codigo          String   @unique
  descricao       String?  @db.Text
  valorMensal     Decimal  @default(0) @db.Decimal(12, 2)
  valorTrimestral Decimal  @default(0) @db.Decimal(12, 2)
  valorSemestral  Decimal  @default(0) @db.Decimal(12, 2)
  valorAnual      Decimal  @default(0) @db.Decimal(12, 2)
  limiteUsuarios  Int?
  ativo           Boolean  @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  modulos     PlanoModulo[]
  menus       PlanoMenu[]
  rotinas     PlanoRotina[]
  assinaturas Assinatura[]

  @@map("planos")
}

model PlanoModulo {
  planoId  String
  moduloId String

  plano  Plano  @relation(fields: [planoId], references: [id], onDelete: Cascade)
  modulo Modulo @relation(fields: [moduloId], references: [id], onDelete: Cascade)

  @@id([planoId, moduloId])
  @@map("plano_modulos")
}

model PlanoMenu {
  planoId String
  menuId  String

  plano Plano @relation(fields: [planoId], references: [id], onDelete: Cascade)
  menu  Menu  @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@id([planoId, menuId])
  @@map("plano_menus")
}

model PlanoRotina {
  planoId  String
  rotinaId String

  plano  Plano  @relation(fields: [planoId], references: [id], onDelete: Cascade)
  rotina Rotina @relation(fields: [rotinaId], references: [id], onDelete: Cascade)

  @@id([planoId, rotinaId])
  @@map("plano_rotinas")
}

enum PerfilPlataformaRole {
  admin_plataforma
  financeiro_plataforma
  suporte_plataforma
}

/// Liberação temporária de acesso ao ambiente da empresa para equipe de suporte da plataforma.
model EmpresaSuporteAcesso {
  id             String    @id @default(uuid())
  empresaId      String
  concedidoPorId String
  motivo         String    @db.Text
  validoAte      DateTime
  revogadoEm     DateTime?
  revogadoPorId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empresa      Empresa             @relation(fields: [empresaId], references: [id])
  concedidoPor Usuario             @relation("SuporteConcedidoPor", fields: [concedidoPorId], references: [id])
  revogadoPor  Usuario?            @relation("SuporteRevogadoPor", fields: [revogadoPorId], references: [id])
  logs         EmpresaSuporteLog[]

  @@index([empresaId, validoAte, revogadoEm])
  @@map("empresa_suporte_acessos")
}

/// Log auditado de cada ação realizada pela equipe da plataforma ao acessar o ambiente da empresa sob suporte.
model EmpresaSuporteLog {
  id                  String   @id @default(uuid())
  empresaId           String
  suporteAcessoId     String
  usuarioPlataformaId String
  metodoHttp          String
  rota                String
  payload             String?  @db.Text
  ip                  String?
  userAgent           String?
  createdAt           DateTime @default(now())

  empresa           Empresa              @relation(fields: [empresaId], references: [id])
  suporteAcesso     EmpresaSuporteAcesso @relation(fields: [suporteAcessoId], references: [id], onDelete: Cascade)
  usuarioPlataforma Usuario              @relation("SuporteAcoesRealizadas", fields: [usuarioPlataformaId], references: [id])

  @@index([empresaId, createdAt])
  @@map("empresa_suporte_logs")
}

/// Assinatura da Empresa com o SaaS (plano, mensalidade, vencimento, ciclo).
model Assinatura {
  id                  String             @id @default(uuid())
  empresaId           String             @unique
  planoId             String
  situacao            SituacaoAssinatura @default(ativa)
  ciclo               CicloPagamento     @default(mensal)
  valorMensalidade    Decimal            @default(0) @db.Decimal(12, 2)
  diaVencimento       Int                @default(10)
  inicioEm            DateTime           @default(now())
  proximoVencimentoEm DateTime?
  canceladaEm         DateTime?
  observacoes         String?            @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  empresa Empresa @relation(fields: [empresaId], references: [id])
  plano   Plano   @relation(fields: [planoId], references: [id])

  @@map("assinaturas")
}

enum Acao {
  visualizar
  cadastrar
  editar
  excluir
  importar
  exportar
  aprovar
  cancelar
  bloquear
}

model PerfilPermissao {
  id        String  @id @default(uuid())
  perfilId  String
  rotinaId  String
  acao      Acao
  permitido Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  perfil Perfil @relation(fields: [perfilId], references: [id])
  rotina Rotina @relation(fields: [rotinaId], references: [id])

  @@unique([perfilId, rotinaId, acao])
  @@map("perfil_permissoes")
}

model RefreshToken {
  id        String    @id @default(uuid())
  usuarioId String
  empresaId String?
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  ip        String?
  userAgent String?
  // Sessão a que este token pertence (ver Sessao): o login abre a sessão e
  // cada rotação de refresh carrega o mesmo id adiante, então o logout sabe
  // qual sessão encerrar e o tempo de uso não recomeça a cada 15 minutos.
  sessaoId  String?

  createdAt DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id])
  sessao  Sessao? @relation(fields: [sessaoId], references: [id])

  @@map("refresh_tokens")
}

/**
 * Uso do sistema por sessão: do login até o logout (ou até a última renovação
 * de token, quando o usuário simplesmente fecha o navegador). Alimenta o
 * "tempo de uso" da tela Administração > Acessos.
 * `ultimaAtividadeEm` avança a cada renovação de token (~15 min) e na troca de
 * empresa — não a cada requisição, que custaria uma escrita por chamada de
 * API. A precisão do tempo de uso é, portanto, da ordem de um ciclo de token.
 * Sem RLS pelo mesmo motivo de `refresh_tokens`: é escrita no login, antes de
 * haver empresa ativa no contexto. `empresaId` fica como informação de qual
 * empresa a sessão abriu, e é o que a consulta filtra.
 */
model Sessao {
  id                String    @id @default(uuid())
  usuarioId         String
  empresaId         String?
  iniciadaEm        DateTime  @default(now())
  ultimaAtividadeEm DateTime  @default(now())
  encerradaEm       DateTime?
  // "logout", "troca_empresa", "fora_horario" — nulo enquanto aberta.
  motivoFim         String?
  ip                String?
  userAgent         String?

  usuario       Usuario        @relation(fields: [usuarioId], references: [id])
  refreshTokens RefreshToken[]

  @@index([usuarioId, iniciadaEm])
  @@map("sessoes")
}

enum AcessoEvento {
  login_sucesso
  login_falha
  login_bloqueado
  login_fora_horario
  acesso_fora_horario
  logout
  troca_empresa
}

/**
 * Rastro de cada tentativa de autenticação e seu desfecho — inclusive as que
 * falharam, que são justamente as que interessam investigar. Alimenta a tela
 * Administração > Acessos.
 * `usuarioId` é nulo quando o e-mail digitado não existe no cadastro (a
 * tentativa é registrada mesmo assim, com o e-mail em `email`). Sem RLS pelo
 * mesmo motivo de `refresh_tokens`: é escrito no login, antes de existir
 * empresa ativa — a consulta é que filtra por empresa (ver AcessosService).
 */
model AcessoLog {
  id        String       @id @default(uuid())
  usuarioId String?
  email     String
  empresaId String?
  evento    AcessoEvento
  detalhe   String?
  ip        String?
  userAgent String?

  criadoEm DateTime @default(now())

  usuario Usuario? @relation(fields: [usuarioId], references: [id])

  @@index([criadoEm])
  @@index([usuarioId, criadoEm])
  @@map("acessos_log")
}

// Chave de integração máquina-a-máquina (ERP externo → plataforma, ver
// docs/planos/api-integracao-erp.md). A chave em claro só é exibida na
// criação; o banco guarda hash SHA-256. `prefixo` (8 primeiros chars da
// chave em claro) permite identificar a chave em tela/log sem expor o
// segredo. Sem RLS de propósito — mesma exceção de `refresh_tokens`: o
// ApiKeyGuard consulta por `chaveHash` antes de existir empresaId de
// contexto (é essa consulta que descobre o tenant).
model IntegracaoApiKey {
  id        String    @id @default(uuid())
  empresaId String
  nome      String
  chaveHash String    @unique
  prefixo   String
  ativo     Boolean   @default(true)
  expiraEm  DateTime?
  ultimoUso DateTime?
  ultimaColeta DateTime?
  ultimoEnvio  DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@index([empresaId])
  @@map("integracao_api_keys")
}

// Configuração e monitor dos endpoints da API de integração ERP por empresa.
model IntegracaoEndpointConfig {
  id            String    @id @default(uuid())
  empresaId     String
  endpointKey   String
  nome          String
  ativo         Boolean   @default(true)
  ultimoUso     DateTime?
  totalChamadas Int       @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@unique([empresaId, endpointKey])
  @@index([empresaId])
  @@map("integracao_endpoint_configs")
}

// ------------------------------------------------------------------
// Organização comercial
// ------------------------------------------------------------------

// Catálogo de produtos, espelhando a tabela `produto` do sistema legado.
// Categoria/subcategoria/armazém apontam para os cadastros auxiliares (a
// versão inicial usava texto achatado; virou FK quando os auxiliares foram
// implementados).
model Produto {
  id                  String  @id @default(uuid())
  empresaId           String
  codigoErp           String
  chave               String? // chave de integração (X2_UNICO); codigoErp é informativo
  descricao           String
  unidade             String?
  categoriaId         String?
  subCategoriaId      String?
  armazemId           String?
  marca               String?
  codigoBarras        String?
  codigoFornecedor    String?
  fabricanteId        String?
  codigoFabricante    String?
  descricaoFabricante String?
  dadosTecnicos       String?
  ncm                 String?
  qtdEmbalagem        Float?
  peso                Float?
  ultimoPreco         Float?
  observacao          String?
  exibirFotoOrcamento Boolean @default(false)
  ativo               Boolean @default(true)

  // Regra de desconto aplicável (SZ0 do ERP). Nulo = sem regra própria;
  // a resolução de qual regra vale ainda não existe — por ora é só o vínculo.
  regraDescontoId String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  empresa       Empresa        @relation(fields: [empresaId], references: [id])
  regraDesconto RegraDesconto? @relation(fields: [regraDescontoId], references: [id])
  categoria     Categoria?     @relation("ProdutoCategoria", fields: [categoriaId], references: [id])
  subCategoria  Categoria?     @relation("ProdutoSubCategoria", fields: [subCategoriaId], references: [id])
  armazem       Armazem?       @relation(fields: [armazemId], references: [id])
  fabricante    Fornecedor?    @relation(fields: [fabricanteId], references: [id])

  estoques          Estoque[]
  tabelasPrecoItens TabelaPrecoItem[]
  notasSaidaItens   NotaSaidaItem[]
  notasEntradaItens NotaEntradaItem[]
  orcamentoItens    OrcamentoItem[]
  sugestoesCompra   SugestaoCompraGerada[]
  fotos             ProdutoFoto[]
  camposValores     ProdutoCampoValor[]

  /// Relações que **partem** deste produto e as que **chegam** nele. As duas
  /// pontas existem porque toda consulta olha os dois lados — ver
  /// ProdutoRelacionado.
  relacionados  ProdutoRelacionado[] @relation("ProdutoRelacaoOrigem")
  relacionadoDe ProdutoRelacionado[] @relation("ProdutoRelacaoDestino")
  fichas        ProdutoFicha[]

  @@unique([empresaId, chave])
  @@index([empresaId, codigoErp])
  @@index([empresaId, descricao])
  @@index([empresaId, categoriaId])
  @@index([empresaId, regraDescontoId])
  @@index([empresaId, codigoFornecedor])
  @@index([empresaId, fabricanteId])
  @@map("produtos")
}

model ProdutoFoto {
  id          String  @id @default(uuid())
  empresaId   String
  produtoId   String?
  url         String
  nomeArquivo String
  principal   Boolean @default(false)
  ordem       Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  empresa Empresa  @relation(fields: [empresaId], references: [id])
  produto Produto? @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@index([empresaId, produtoId, ordem])
  @@map("produto_fotos")
}

/// Ficha técnica de um produto: o PDF que o fabricante manda e o Markdown que
/// o agente extraiu dele.
///
/// **Os dois têm leitores diferentes, e é por isso que os dois existem.** O PDF
/// é para o vendedor abrir e mandar ao cliente; o Markdown é o que a IA lê ao
/// falar do produto. Modelo nenhum recebe o PDF de novo a cada pergunta: ele é
/// lido **uma vez**, no anexo, e o que fica é o texto.
///
/// O Markdown é editável na tela de propósito. É ali que a regra "a IA nunca
/// passa preço" continua verificável: se a ficha do fabricante trouxer tabela
/// de preço, ela aparece para ser retirada, em vez de entrar no contexto do
/// modelo sem ninguém saber.
///
/// Vários documentos por produto (ficha, FISPQ, certificado): um campo único
/// no produto seria sobrescrito pelo segundo PDF.
model ProdutoFicha {
  id        String @id @default(uuid())
  empresaId String
  produtoId String

  /// Nome em disco (UUID + extensão) e o nome que a pessoa enviou. O segundo
  /// nunca toca o disco — ver `extensaoPorMime`.
  arquivo     String
  arquivoNome String
  mime        String
  tamanho     Int

  titulo   String
  markdown String

  /// Se a IA pode usar este texto ao falar do produto. Mesmo sentido do
  /// `visivelAgente` dos campos complementares.
  visivelAgente Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  empresa Empresa              @relation(fields: [empresaId], references: [id])
  produto Produto              @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  trechos ProdutoFichaTrecho[]

  @@index([empresaId, produtoId])
  @@map("produto_fichas")
}

/// Um pedaço de ficha técnica, com o vetor que o representa.
///
/// ## Por que pedaços, e não a ficha inteira
///
/// Duas razões, e as duas importam.
///
/// **Custo.** Mandar a ficha inteira ao modelo a cada pergunta é o gasto que não
/// para de crescer: 10 KB de Markdown são ~2.500 tokens, vezes três produtos,
/// vezes toda pergunta de todo cliente. Um trecho de 800 caracteres responde a
/// pergunta e custa uma fração disso.
///
/// **Precisão da busca.** Um vetor do documento inteiro é a média de tudo que
/// ele diz — dilui o que é específico. O vetor de "preserva as fibras do algodão
/// e não amarela" aponta para onde a pergunta sobre desgaste de lençol aponta;
/// o vetor da ficha inteira, não.
///
/// ## A dimensão é fixa, e isso é uma decisão
///
/// 768 é a dimensão do `nomic-embed-text`, que roda no Ollama local.
/// pgvector exige dimensão declarada para indexar, então trocar de modelo para
/// um de outra dimensão obriga a recriar a coluna **e** reindexar tudo. O
/// serviço recusa vetor de tamanho diferente em vez de gravar algo que a busca
/// depois compararia com lixo.
///
/// O tipo é `Unsupported` porque o Prisma não conhece `vector`: a coluna existe
/// e é migrada por ele, mas quem lê e escreve é SQL cru (ver
/// `FichaEmbeddingService`).
model ProdutoFichaTrecho {
  id        String @id @default(uuid())
  empresaId String

  fichaId   String
  /// Desnormalizado da ficha: a busca devolve produto, e sem isto toda consulta
  /// precisaria de mais um join só para chegar nele.
  produtoId String

  /// Posição do trecho dentro da ficha, para remontar a ordem na leitura.
  ordem Int
  texto String

  /// O vetor. Nulo enquanto a indexação não rodou — o trecho existe antes de o
  /// embedding chegar, e a busca lexical já funciona sem ele.
  embedding Unsupported("vector(768)")?

  /// Que modelo gerou o vetor. É o que permite reindexar só o que ficou para
  /// trás quando o modelo muda, em vez de refazer o catálogo inteiro.
  modelo String?

  createdAt DateTime @default(now())

  empresa Empresa      @relation(fields: [empresaId], references: [id])
  ficha   ProdutoFicha @relation(fields: [fichaId], references: [id], onDelete: Cascade)

  @@index([empresaId, produtoId])
  @@index([empresaId, fichaId, ordem])
  @@map("produto_ficha_trechos")
}

/// Em que pé está um PDF na fila de importação de fichas.
enum FichaImportacaoSituacao {
  pendente
  processando
  vinculada
  sem_correspondencia
  ambiguo
  erro
}

/// Um PDF de ficha técnica esperando (ou tendo terminado) o processamento em
/// lote.
///
/// **O vínculo é pelo conteúdo, não pelo nome do arquivo.** É a diferença para
/// a importação de fotos (`produto_fotos` com `produtoId` nulo), que casa pelo
/// nome: fabricante manda ficha com nome de catálogo interno dele, e o código
/// que interessa está impresso na página.
///
/// Quem lê é o modelo; quem **procura no catálogo** é o servidor. O modelo
/// devolve o que está escrito no documento (código do fabricante, nome do
/// produto) e o servidor busca — se ele devolvesse um id, bastaria alucinar um
/// para pendurar a ficha no produto errado.
///
/// A fila vive em tabela porque o processamento é lento e pago: cada PDF é uma
/// chamada ao provedor de IA. Um lote de 80 arquivos não cabe numa requisição
/// HTTP, e um reinício no meio não pode perder o que já foi feito.
model ProdutoFichaImportacao {
  id        String @id @default(uuid())
  empresaId String

  arquivo     String
  arquivoNome String
  mime        String
  tamanho     Int

  situacao FichaImportacaoSituacao @default(pendente)

  /// O que o modelo leu no documento — guardado mesmo quando não casa com
  /// nada, porque é o que explica à pessoa por que ficou pendente.
  codigoDetectado String?
  nomeDetectado   String?
  titulo          String?
  markdown        String?

  /// Preenchidos quando a importação achou o produto e gravou a ficha.
  produtoId String?
  fichaId   String?

  /// Mensagem do erro, quando `situacao = erro`. É o que a tela mostra em vez
  /// de um "falhou" que não ajuda ninguém.
  erro       String?
  tentativas Int     @default(0)

  processadoEm DateTime?
  createdAt    DateTime  @default(now())
  createdBy    String?

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@index([empresaId, situacao, createdAt])
  @@map("produto_ficha_importacoes")
}

/// Arquivo que alguém anexou a uma mensagem do assistente interno.
///
/// Vive em tabela própria, e não solto em disco, por três razões: o RLS o
/// prende à empresa, o `usuarioId` impede que uma conversa use o anexo de
/// outra pessoa, e o `consumidoEm` registra que ele já virou ficha ou foto —
/// o que evita reaproveitar o mesmo upload em duas gravações.
///
/// **O modelo nunca escolhe o anexo.** Ele vai ao provedor porque a mensagem o
/// carrega, e a ferramenta o recebe do servidor; se o id fosse um argumento,
/// bastaria convencer o modelo a informar outro.
model AgenteAnexo {
  id        String @id @default(uuid())
  empresaId String
  usuarioId String

  arquivo     String
  arquivoNome String
  mime        String
  tamanho     Int

  /// A conversa em que o arquivo entrou, gravada no primeiro envio.
  ///
  /// Sem isto o anexo valeria por **um turno**, e o fluxo natural quebrava:
  /// verificado com um PDF real em 2026-09-05, o modelo lê o documento, pede
  /// a confirmação do produto e, na resposta seguinte, já não tem o arquivo —
  /// respondeu "não tenho acesso ao conteúdo do PDF nesta conversa".
  conversaId String?

  /// Quando virou ficha técnica ou foto de produto. Nulo = ainda não usado.
  consumidoEm DateTime?

  createdAt DateTime @default(now())

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@index([empresaId, usuarioId, createdAt])
  @@index([empresaId, conversaId, consumidoEm])
  @@map("agente_anexos")
}

/// Como dois produtos se relacionam.
///
/// - `similar` — um substitui o outro. **Simétrica**: se A substitui B, B
///   substitui A. Guardada uma vez só e lida dos dois lados (ver
///   ProdutoRelacionado); duas linhas para o mesmo fato divergiriam na primeira
///   vez que alguém apagasse uma.
/// - `aplicacao` — o produto **usa** o outro. É o caso do comodato: a dosadora
///   emprestada ao cliente e os químicos que ela dilui. **Direcional**, e por
///   isso lida com rótulos diferentes em cada ponta ("usa" de um lado, "usado
///   em" do outro).
enum ProdutoRelacaoTipo {
  similar
  aplicacao
}

/// Produto relacionado a outro: similar ou aplicação.
///
/// Uma tabela só para os dois casos, porque a pergunta é a mesma ("que outros
/// produtos têm a ver com este?") e o que muda é o `tipo`. Separá-las daria
/// duas tabelas idênticas e duas telas iguais.
///
/// **Nada aqui é do ERP.** É conhecimento de quem vende: qual produto
/// substitui qual, e o que entra na aplicação do equipamento em comodato.
model ProdutoRelacionado {
  id        String @id @default(uuid())
  empresaId String

  produtoId     String
  relacionadoId String
  tipo          ProdutoRelacaoTipo

  /// Por que estão relacionados ("substitui só até 40 °C", "dose de 20 ml").
  /// É o que evita a lista de códigos que ninguém sabe interpretar.
  observacao String?
  ordem      Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  empresa     Empresa @relation(fields: [empresaId], references: [id])
  produto     Produto @relation("ProdutoRelacaoOrigem", fields: [produtoId], references: [id], onDelete: Cascade)
  relacionado Produto @relation("ProdutoRelacaoDestino", fields: [relacionadoId], references: [id], onDelete: Cascade)

  @@unique([empresaId, produtoId, relacionadoId, tipo])
  /// A consulta pela ponta de destino é tão comum quanto pela de origem: é ela
  /// que responde "em que equipamentos este químico é usado".
  @@index([empresaId, relacionadoId, tipo])
  @@map("produto_relacionados")
}

/// Tipo de um campo complementar de produto. Decide **como o valor é validado
/// e exibido** — o valor em si é sempre texto (ver ProdutoCampoValor).
enum ProdutoCampoTipo {
  texto
  texto_longo
  numero
  booleano
  data
  lista
}

/// Campo complementar de produto: o **cadastro** de quais dados extras a
/// empresa quer guardar (dimensões, peso bruto, regra de diluição, validade,
/// tensão…).
///
/// Por que não colunas novas em `produtos`: cada empresa quer os seus. Uma
/// distribuidora de químicos precisa de diluição e pictograma de risco; uma de
/// autopeças, de aplicação e medida. Ou o cadastro nasceria com dezenas de
/// colunas vazias, ou cada cliente pediria uma migration.
///
/// A definição é um cadastro de verdade — nome, tipo, unidade, ordem — e não
/// um par chave/valor solto: é ela que permite validar o que se digita e
/// montar a tela sozinha.
///
/// O import do ERP **não passa por aqui**. Ele faz upsert em `produtos` por
/// `codigoErp`, e estes valores vivem em tabela própria: o que a empresa
/// digitou sobrevive à próxima carga.
model ProdutoCampo {
  id        String @id @default(uuid())
  empresaId String

  /// Identificador estável, em minúsculas com hífen (`peso-bruto`). É por ele
  /// que a IA e as integrações referenciam o campo — renomear o rótulo não
  /// pode quebrar quem já lê.
  chave String
  nome  String
  tipo  ProdutoCampoTipo @default(texto)

  /// Unidade exibida ao lado do valor ("mm", "kg", "L"). Só rótulo: não há
  /// conversão nenhuma, e misturar unidades no mesmo campo é problema de quem
  /// cadastrou.
  unidade String?

  /// Valores aceitos quando `tipo = lista`. Vazio nos outros tipos.
  opcoes String[] @default([])

  /// Agrupamento na tela ("Dimensões", "Uso e diluição"). Nulo cai num grupo
  /// geral.
  grupo String?

  /// Texto de ajuda mostrado a quem preenche.
  ajuda String?

  ordem         Int     @default(0)
  obrigatorio   Boolean @default(false)
  /// Se a IA pode citar este campo ao falar do produto. Serve para a empresa
  /// guardar aqui algo que é de uso interno (custo de embalagem, margem) sem
  /// que ele chegue a quem pergunta pelo WhatsApp.
  visivelAgente Boolean @default(true)
  ativo         Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  empresa Empresa             @relation(fields: [empresaId], references: [id])
  valores ProdutoCampoValor[]

  @@unique([empresaId, chave])
  @@index([empresaId, ativo, ordem])
  @@map("produto_campos")
}

/// O valor de um campo complementar em um produto.
///
/// Guardado sempre como **texto**, em formato canônico gravado pelo service:
/// número com ponto decimal (`12.5`), booleano `true`/`false`, data em
/// `AAAA-MM-DD`. Uma coluna por tipo deixaria quatro nulas em toda linha, e
/// mudar o tipo de um campo já cadastrado obrigaria a migrar valores de coluna.
/// Quem converte para exibir é quem lê, a partir do `tipo` da definição.
model ProdutoCampoValor {
  id        String @id @default(uuid())
  empresaId String
  produtoId String
  campoId   String
  valor     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  empresa Empresa      @relation(fields: [empresaId], references: [id])
  produto Produto      @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  campo   ProdutoCampo @relation(fields: [campoId], references: [id], onDelete: Cascade)

  @@unique([empresaId, produtoId, campoId])
  @@index([empresaId, campoId, valor])
  @@map("produto_campo_valores")
}

// Cadastro de vendedores, supervisores e gerentes — mesma tabela, com `tipo`
// dizendo o papel.
//
// A hierarquia é **um ponteiro só**: `superiorId`, autorreferenciando esta
// tabela. Cada um aponta a quem responde — o vendedor ao supervisor, o
// supervisor ao gerente, e assim por diante, sem teto de níveis.
//
// Eram dois campos independentes (`supervisorId` e `gerenteId`) até
// 2026-09-03, e a independência era o problema: dava para gravar um vendedor
// sob o supervisor S e, ao mesmo tempo, sob o gerente G1, enquanto S respondia
// a G2. As duas leituras do sistema discordavam (o escopo de acesso punha o
// vendedor no time de G1; o Dashboard Gerencial o mostrava sob S). Com um
// ponteiro só, a contradição deixa de ser representável.
//
// Ciclo (A responde a B, B responde a A) é barrado no service, não no banco.
model Vendedor {
  id             String    @id @default(uuid())
  empresaId      String
  usuarioId      String?
  codigoErp      String?
  chave          String? // chave de integração (X2_UNICO); codigoErp é informativo
  nome           String
  nomeReduzido   String?
  telefone       String?
  email          String?
  dataNascimento DateTime?

  // Percentual de comissão do vendedor. Mantido pelo ERP (API de integração),
  // somente leitura na tela — mesmo tratamento dos campos de regra de desconto.
  percComissao Float?

  // Papel na hierarquia comercial — exatamente um. Antes eram três booleanos
  // independentes (vendedor/supervisor/gerente), que aceitavam combinações
  // sem sentido; o enum torna o estado inválido impossível.
  tipo         TipoVendedor     @default(vendedor)
  // Como o vendedor se liga à empresa. `sistema` são os cadastros que não são
  // pessoas de venda (ESCRITORIO, E-COMMERCE...), mantidos porque o ERP
  // credita notas a eles.
  vinculo      VinculoVendedor?
  // Aparece nas telas gerenciais (dashboard/objetivos). Cadastro de sistema e
  // vendedor sem carteira normalmente ficam de fora.
  usaDashboard Boolean          @default(true)

  /// A quem este cadastro responde. Nulo no topo da hierarquia.
  superiorId String?

  // `desligado` é o controle de saída do vendedor, e é ele que a tela exibe;
  // o serviço mantém `ativo` como seu espelho (desligado = não ativo), porque
  // `ativo` é o que todos os selects e filtros do sistema já consultam.
  ativo     Boolean @default(true)
  desligado Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  empresa Empresa  @relation(fields: [empresaId], references: [id])
  usuario Usuario? @relation(fields: [usuarioId], references: [id])

  superior             Vendedor?             @relation("VendedorHierarquia", fields: [superiorId], references: [id])
  subordinados         Vendedor[]            @relation("VendedorHierarquia")
  clientes             Cliente[]
  notasSaida           NotaSaida[]
  notasSaidaItens      NotaSaidaItem[]
  titulosReceber       TituloReceber[]
  oportunidades        Oportunidade[]
  atividades           Atividade[]
  objetivosVendedorMes ObjetivoVendedorMes[]
  orcamentos           Orcamento[]
  whatsappSessoes      WhatsappSessao[]

  @@unique([empresaId, chave])
  @@index([empresaId, codigoErp])
  @@index([empresaId, nome])
  // Subir e descer a hierarquia é consulta recursiva (ver resolverEscopoVendedores).
  @@index([empresaId, superiorId])
  @@map("vendedores")
}

enum TipoPessoa {
  fisica
  juridica
}

/// Papel do vendedor na hierarquia comercial — um só por cadastro. `gerente`
/// enxerga o time inteiro, `supervisor` os vendedores abaixo dele e `vendedor`
/// só a própria carteira (ver escopo-vendedores.ts).
/// O papel do cadastro na hierarquia comercial.
///
/// Dois valores, e não um por degrau (supervisor, gerente, diretor...): o
/// **nível** já é dado pela cadeia `superiorId`, que não tem teto. Nomear cada
/// degrau obrigava a inventar um valor novo no enum a cada camada de
/// organograma, e permitia contradição entre o rótulo e a posição real.
///
/// `vendedor` atende cliente e tem carteira; `superior` responde por outros —
/// é quem aparece como agrupador no Dashboard Gerencial. Decisão do usuário em
/// 2026-09-03.
enum TipoVendedor {
  vendedor
  superior
}

/// Vínculo do vendedor com a empresa. `sistema` marca os cadastros que não são
/// pessoas de venda (ESCRITORIO, E-COMMERCE, balcão), mas que recebem nota no
/// ERP e por isso precisam existir aqui.
enum VinculoVendedor {
  clt
  representante
  sistema
}

// Carteira de clientes, espelhando a tabela `cliente` do sistema legado
// (lookups como segmento/região ficaram de fora do v1 — ver
// docs/planos/clientes-crud.md). vendedorId define a carteira e é a base do
// escopo hierárquico aplicado em ClientesService (vendedor vê a própria
// carteira, supervisor/gerente veem o time). Campos de histórico comercial
// (primeiraCompra, ultimaCompra, ...) são preenchidos pelo import do legado,
// não pelo formulário.
model Cliente {
  id                  String  @id @default(uuid())
  empresaId           String
  vendedorId          String?
  tabelaPrecoId       String?
  condicaoPagamentoId String?
  codigoErp           String?
  chave               String? // chave de integração (X2_UNICO); codigoErp é informativo

  tipoPessoa         TipoPessoa @default(juridica)
  razaoSocial        String
  nomeFantasia       String?
  cnpjCpf            String?
  inscricaoEstadual  String?
  inscricaoMunicipal String?
  contribuinteIcms   Boolean?
  rg                 String?
  dataNascimento     DateTime?

  contato   String?
  email     String?
  telefone  String?
  telefone2 String?
  celular   String?

  endereco    String?
  complemento String?
  bairro      String?
  municipio   String?
  uf          String?
  cep         String?
  latitude    Float?
  longitude   Float?

  ativo            Boolean   @default(true)
  carteira         Boolean?
  site             String?
  limiteCredito    Float?
  vencimentoLimite DateTime?
  observacao       String?

  dataBloqueio         DateTime?
  observacaoBloqueio   String?
  dataReativacao       DateTime?
  observacaoReativacao String?

  primeiraCompra    DateTime?
  ultimaVisita      DateTime?
  ultimaCompra      DateTime?
  ultimoAtendimento DateTime?
  dataConsultaRfb   DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  empresa           Empresa            @relation(fields: [empresaId], references: [id])
  vendedor          Vendedor?          @relation(fields: [vendedorId], references: [id])
  tabelaPreco       TabelaPreco?       @relation(fields: [tabelaPrecoId], references: [id])
  condicaoPagamento CondicaoPagamento? @relation(fields: [condicaoPagamentoId], references: [id])

  notasSaida        NotaSaida[]
  notasSaidaItens   NotaSaidaItem[]
  // Devoluções de venda (SF1 com tipo 'D') — ver NotaEntrada.
  notasEntrada      NotaEntrada[]
  notasEntradaItens NotaEntradaItem[]
  titulosReceber    TituloReceber[]
  oportunidades     Oportunidade[]
  atividades        Atividade[]
  orcamentos        Orcamento[]
  cnaes             ClienteCnae[]
  alteracoes        ClienteAlteracao[]
  historico         ClienteHistorico[]
  sugestoesCompra   SugestaoCompraGerada[]
  whatsappContatos  WhatsappContato[]
  whatsappConversas WhatsappConversa[]
  contatosPortal    ClienteContato[]
  portalHabilitacao PortalClienteHabilitacao?

  @@unique([empresaId, chave])
  @@index([empresaId, codigoErp])
  @@index([empresaId, razaoSocial])
  @@index([empresaId, vendedorId])
  @@index([empresaId, tabelaPrecoId])
  @@index([empresaId, condicaoPagamentoId])
  @@map("clientes")
}

model ClienteContato {
  id        String  @id @default(uuid())
  empresaId String
  clienteId String
  perfilId  String?
  nome      String
  email     String
  telefone  String?
  celular   String?
  cargo     String?
  principal Boolean @default(false)
  ativo     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  empresa             Empresa                  @relation(fields: [empresaId], references: [id])
  cliente             Cliente                  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  perfil              PortalClientePerfil?     @relation(fields: [perfilId], references: [id])
  credencial          PortalClienteCredencial?
  orcamentosDecididos Orcamento[]              @relation("OrcamentoDecisaoContato")
  whatsappNumeros     WhatsappContato[]

  @@unique([empresaId, clienteId, email])
  @@index([empresaId, clienteId, ativo])
  @@map("cliente_contatos")
}

model PortalClienteConfig {
  id                        String  @id @default(uuid())
  empresaId                 String  @unique
  ativo                     Boolean @default(false)
  permitirAtualizarCadastro Boolean @default(false)
  permitirManterContatos    Boolean @default(false)
  exibirDesconto            Boolean @default(false)
  permitirSolicitarDesconto Boolean @default(false)
  descontoMaximoSolicitavel Float   @default(0)
  exibirEstoque             Boolean @default(false)
  permitirProdutoForaMix    Boolean @default(true)
  diasValidadeCarrinho      Int     @default(7)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  updatedBy String?

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@map("portal_cliente_configs")
}

model PortalClientePerfil {
  id          String  @id @default(uuid())
  empresaId   String
  nome        String
  descricao   String?
  sistemaBase Boolean @default(false)
  ativo       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  empresa    Empresa                        @relation(fields: [empresaId], references: [id])
  contatos   ClienteContato[]
