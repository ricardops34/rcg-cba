# Variaveis da stack stack.evolution-api.prod.yml.
# No Portainer: Stacks -> evolution-api -> Environment variables.

# Dominio apontado para o IP da VPS. Nao inclua https:// nem barra final.
EVOLUTION_HOST="evolution.bjsoft.com.br"

# Origens permitidas pelo navegador. `*` segue o default oficial da Evolution
# API e evita bloqueio do Manager embarcado; a API segue exigindo `apikey`.
EVOLUTION_CORS_ORIGIN="*"

# Tag fixa recomendada para producao. v2.3.7 era a ultima versao estavel
# publicada quando esta stack foi criada; 2.4.0-rc* e pre-release.
EVOLUTION_IMAGE="evoapicloud/evolution-api:v2.3.7"

# Banco `evolution` e role `evolution`, criados no PostgreSQL ja existente na
# VPS. A stack `postgres` e o servico `postgres` formam o DNS Swarm
# `postgres_postgres` na `network_public`.
# Use apenas letras e numeros na senha, pois ela entra na URI montada no YAML.
# Exemplo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EVOLUTION_POSTGRES_PASSWORD="gere-um-segredo-forte-exclusivo-para-o-postgres"

# Chave administrativa enviada no header `apikey`. Quem possui esta chave
# controla todas as instancias e sessoes de WhatsApp deste servidor.
EVOLUTION_API_KEY="gere-um-terceiro-segredo-forte-exclusivo-para-a-api"
