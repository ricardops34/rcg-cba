# Variáveis de stack.receita.prod.yml (base própria da Receita).
# Portainer: Stacks > receita > Environment variables. Valores sem aspas.

# Imagem publicada pelo `.\publish.ps1 -Target receita`. Use a tag de versão
# (yyyy.MM.dd-HHmm) em vez de latest, para poder voltar a anterior.
RECEITA_IMAGE=bjsoftware/plataforma-minha-receita:AAAA.MM.DD-HHMM

# Senha do banco próprio da base (serviço receita_postgres). Gere uma nova.
RECEITA_DB_PASSWORD=

# Token do serviço de controle (mínimo 16 caracteres). O mesmo valor vai em
# Administração > Base da Receita, campo "Token do controle" (gravado cifrado).
RECEITA_CONTROLE_TOKEN=
