FROM node:20-alpine

RUN npm config set strict-ssl false && \
    npm install -g pnpm@10.0.0 && \
    pnpm config set strict-ssl false

WORKDIR /app

CMD ["sh", "-c", "pnpm --filter @plataforma/contracts build && pnpm --filter @plataforma/api prisma:generate && pnpm --filter @plataforma/api prisma:deploy && pnpm --filter @plataforma/api start:dev"]
