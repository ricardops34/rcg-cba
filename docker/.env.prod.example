# Variáveis de ambiente do stack de produção (stack.rcgcba.prod.yml).
# No Portainer: Stacks → rcgcba → Environment variables (não é lido de arquivo,
# só serve de referência pra preencher os campos por lá).
#
# DATABASE_URL/REDIS_URL devem apontar pro host/alias do Postgres e do Redis
# já rodando na VPS (fora deste stack) — troque "postgres"/"redis" abaixo
# pelo nome real do serviço/rede usado por eles.
# 
# DATABASE_URL aqui é o role de APLICAÇÃO ("plataforma_app"), sem BYPASSRLS
# nem superuser — só assim o RLS por empresa (ver
# apps/api/prisma/migrations/README.md) realmente isola os tenants; um role
# dono de tabela ou superusuário ignora as policies. O role "plataforma_app"
# é criado pela migration 20260715221500_app_role_least_privilege com uma
# senha de placeholder ("plataforma_app_dev_only") — troque IMEDIATAMENTE
# após o primeiro `prisma migrate deploy` em produção com:
#   ALTER ROLE plataforma_app WITH PASSWORD 'SENHA_FORTE_AQUI';
# Migrations continuam rodando à parte, com o role dono das tabelas
# ("plataforma"), que não entra nesta variável.

DATABASE_URL="postgresql://plataforma_app:SENHA_FORTE_AQUI@postgres:5432/plataforma_comercial?schema=public"
REDIS_URL="redis://redis:6379"

# Conexão do whatsapp-worker. NÃO é o DATABASE_URL acima: o worker precisa de
# DDL dentro do schema `whatsapp` (a biblioteca de sessão roda as migrations
# dela a cada conexão) e não pode enxergar as tabelas de negócio. O role
# "whatsapp_store" é criado pela migration 20260815024500_whatsapp_store_schema
# com senha de placeholder ("whatsapp_store_dev_only") — troque IMEDIATAMENTE
# após o primeiro `prisma migrate deploy` em produção com:
#   ALTER ROLE whatsapp_store WITH PASSWORD 'SENHA_FORTE_AQUI';
# Quem tem esta senha alcança as sessões pareadas — ou seja, fala pelo WhatsApp
# dos vendedores. Trate como a senha do plataforma_app, não como a de um cache.
# O `?schema=whatsapp` é convenção do Prisma e o driver `pg` ignora; o que faz
# efeito é o `ALTER ROLE ... SET search_path` da migration 20260815025500.
WHATSAPP_STORE_DATABASE_URL="postgresql://whatsapp_store:SENHA_FORTE_AQUI@postgres:5432/plataforma_comercial?schema=whatsapp"

# Segredo compartilhado entre a API e o whatsapp-worker (MESMO valor nos dois
# serviços do stack). Sem ele o worker recusa subir, de propósito: quem alcança
# o worker fala pelo WhatsApp dos vendedores. Gere um próprio:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WHATSAPP_WORKER_TOKEN="gere-um-segredo-forte-aleatorio-worker"

JWT_ACCESS_SECRET="gere-um-segredo-forte-aleatorio-access"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="gere-um-segredo-forte-aleatorio-refresh"
JWT_REFRESH_EXPIRES_IN="7d"

CORS_ORIGIN="https://rcgcba.bjsoft.com.br"

# Cifra a chave de API do provedor de IA (agente interno) com AES-256-GCM.
# 32 bytes em base64. Gere uma própria — NÃO reaproveite a de dev:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Sem esta variável, gravar a chave do agente é RECUSADO (de propósito: melhor
# recusar do que guardar segredo de terceiro em claro no banco). Trocar esta
# chave depois invalida o que já está gravado — é preciso regravar a chave do
# provedor pela tela de Administração > Agente IA.
AGENTE_IA_CRYPTO_KEY="gere-32-bytes-em-base64-aqui"

# ---------------------------------------------------------------------------
# E-mail (SMTP) — opcional, mas com uma pegadinha
#
# Há DUAS fontes possíveis, nesta ordem: o parâmetro por empresa (Administração
# > Parâmetros, campo SMTP_HOST) e, como fallback, estas variáveis. Se a
# empresa já configurou pela tela, não é preciso definir nada aqui.
#
# Se NENHUMA das duas existir, o envio **falha em silêncio**: nada quebra, o
# e-mail simplesmente não sai e fica só um aviso no log da API
# ("SMTP não configurado ... e-mail para X não enviado"). Vale conferir o log
# depois do primeiro deploy se algum fluxo depender de e-mail.
# SMTP_HOST="smtp.seuprovedor.com.br"
# SMTP_PORT="587"
# SMTP_SECURE="false"                # "true" só para porta 465
# SMTP_USER="usuario"
# SMTP_PASSWORD="senha"
# MAIL_FROM="Plataforma <nao-responda@seudominio.com.br>"

# ---------------------------------------------------------------------------
# Opcionais (têm default no código):
# EXTERNAL_HTTP_TIMEOUT_MS="8000"    # IBGE, ViaCEP, MinhaReceita
# AGENTE_IA_TIMEOUT_MS="60000"       # chamada ao provedor de IA
# IBGE_BASE_URL / VIACEP_BASE_URL / MINHARECEITA_BASE_URL — só se usar espelho próprio
# WHATSAPP_LOG_NIVEL="info"
# WHATSAPP_STORE_PREFIX / WHATSAPP_WORKER_TIMEOUT_MS — ajuste fino do worker

# ---------------------------------------------------------------------------
# NÃO vai aqui: NEXT_PUBLIC_API_URL
#
# Variável `NEXT_PUBLIC_*` é embutida pelo Next no BUILD da imagem, não lida em
# runtime — defini-la no Portainer não tem efeito nenhum. Ela é build-arg, com
# o valor de produção fixado em `docker/web.Dockerfile` e repassado pelo
# `publish.ps1`. Para mudar a URL da API do front, é preciso rebuildar e
# republicar a imagem do web.
