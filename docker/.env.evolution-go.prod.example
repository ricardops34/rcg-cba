# Variaveis de stack.evolution-go.prod.yml.
# No Portainer: Stacks -> evogo -> Environment variables.
EVOLUTION_GO_HOST="evogo.bjsoft.com.br"

# Versao fixa ja validada no projeto; nao implica ser a ultima disponivel.
EVOLUTION_GO_IMAGE="evoapicloud/evolution-go:0.7.2"

# Banco e role `evogo` no PostgreSQL existente (postgres_postgres:5432).
# Gere uma senha somente com letras e numeros para uso direto na URI.
# Gerar segredo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EVOLUTION_GO_POSTGRES_PASSWORD="substituaPorUmaSenhaForteExclusiva"

# Gere OUTRO segredo para a chave administrativa (GLOBAL_API_KEY).
EVOLUTION_GO_API_KEY="substituaPorOutraChaveForteExclusiva"
