+package cmd
+
+import (
+	"log/slog"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestGravarTabmunPlataforma(t *testing.T) {
+	c := &controle{dir: t.TempDir(), log: slog.Default()}
+	c.municipios = []municipioCarga{{CodigoReceita: "1182", UF: "MT", IBGE: 5101837}, {CodigoReceita: "9051", UF: "MS", IBGE: 5002704}}
+	if err := c.gravarTabmunPlataforma(); err != nil {
+		t.Fatal(err)
+	}
+	b, err := os.ReadFile(filepath.Join(c.dir, arquivoTabmunPlataforma))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got, want := string(b), "1182;;;MT;5101837\n9051;;;MS;5002704\n"; got != want {
+		t.Fatalf("arquivo no formato do tabmun errado:\n%q\nesperava\n%q", got, want)
+	}
+}
+
+func TestGravarTabmunPlataformaSemMunicipiosNaoGrava(t *testing.T) {
+	c := &controle{dir: t.TempDir(), log: slog.Default()}
+	if err := c.gravarTabmunPlataforma(); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := os.Stat(filepath.Join(c.dir, arquivoTabmunPlataforma)); !os.IsNotExist(err) {
+		t.Fatal("sem municípios não deve gravar arquivo")
+	}
+}
+
+func TestCargaRecusaMunicipioInvalido(t *testing.T) {
+	c := &controle{dir: t.TempDir(), log: slog.Default()}
+	h := c.handler("token-de-teste-1234567890")
+	for _, corpo := range []string{
+		`{"mes":"2026-11","ufs":["MT"],"situacoes":["02"],"municipios":[{"codigoReceita":"11","uf":"MT","ibge":5101837}]}`,
+		`{"mes":"2026-11","ufs":["MT"],"situacoes":["02"],"municipios":[{"codigoReceita":"1182","uf":"Mato","ibge":5101837}]}`,
+		`{"mes":"2026-11","ufs":["MT"],"situacoes":["02"],"municipios":[{"codigoReceita":"1182","uf":"MT","ibge":51}]}`,
+	} {
+		req := httptest.NewRequest(http.MethodPost, "/carga", strings.NewReader(corpo))
+		req.Header.Set("Authorization", "Bearer token-de-teste-1234567890")
+		rec := httptest.NewRecorder()
+		h.ServeHTTP(rec, req)
+		if rec.Code != http.StatusBadRequest {
+			t.Errorf("esperava 400 para %s, veio %d: %s", corpo, rec.Code, rec.Body.String())
+		}
+	}
+	if c.carga.Rodando {
+		t.Fatal("carga inválida não pode começar")
+	}
+}
+
+func TestReferenciasECepsRecusamDuranteACarga(t *testing.T) {
+	c := &controle{dir: t.TempDir(), log: slog.Default()}
+	c.carga.Rodando = true
+	h := c.handler("token-de-teste-1234567890")
+	for _, rota := range []string{"/referencias", "/ceps"} {
+		req := httptest.NewRequest(http.MethodGet, rota, nil)
+		req.Header.Set("Authorization", "Bearer token-de-teste-1234567890")
+		rec := httptest.NewRecorder()
+		h.ServeHTTP(rec, req)
+		if rec.Code != http.StatusConflict {
+			t.Errorf("%s durante a carga: esperava 409, veio %d", rota, rec.Code)
+		}
+	}
+}
diff --git a/download/referencias.go b/download/referencias.go
new file mode 100644
index 0000000..65590fa
--- /dev/null
+++ b/download/referencias.go
@@ -0,0 +1,198 @@
+package download
+
+import (
+	"archive/zip"
+	"bytes"
+	"encoding/csv"
+	"fmt"
+	"io"
+	"log/slog"
+	"os"
+	"path/filepath"
+	"strings"
+	"time"
+
+	"golang.org/x/text/encoding/charmap"
+)
+
+// Patch da plataforma: as tabelas de referência que a plataforma guarda com os
+// códigos da Receita (docs/planos/2026-11-21-tabelas-referencia-compartilhadas.md).
+// O serviço de controle as entrega à API em GET /referencias; a plataforma
+// grava em municipios.codigoReceita, naturezas_juridicas e cnaes.
+
+// Referencia é um código com a descrição, como a Receita publica.
+type Referencia struct {
+	Codigo    string `json:"codigo"`
+	Descricao string `json:"descricao"`
+}
+
+// MunicipioTesouro é uma linha do tabmun.csv do Tesouro: o código municipal
+// da Receita (TOM/SIAFI) com o IBGE.
+type MunicipioTesouro struct {
+	CodigoReceita string `json:"codigoReceita"`
+	Nome          string `json:"nome"`
+	UF            string `json:"uf"`
+	IBGE          string `json:"ibge"`
+}
+
+// Referencias reúne o que a plataforma sincroniza.
+type Referencias struct {
+	Mes        string             `json:"mes"`
+	Tesouro    []MunicipioTesouro `json:"tesouro"`
+	Municipios []Referencia       `json:"municipios"`
+	Naturezas  []Referencia       `json:"naturezas"`
+	CNAEs      []Referencia       `json:"cnaes"`
+}
+
+var (
+	tentativasReferencia = 5
+	esperaReferencia     = 10 * time.Second
+)
+
+// comTentativas repete fn: o servidor da Receita recusa conexão e o firewall
+// dele troca o arquivo por uma página de rejeição (ver resiliencia.go).
+func comTentativas(nome string, fn func() error) error {
+	var err error
+	for t := 1; t <= tentativasReferencia; t++ {
+		if err = fn(); err == nil {
+			return nil
+		}
+		if t < tentativasReferencia {
+			slog.Warn("referência falhou, tentando de novo", "arquivo", nome, "tentativa", t, "error", err)
+			time.Sleep(esperaReferencia)
+		}
+	}
+	return fmt.Errorf("%s: %w", nome, err)
+}
+
+// lerCSVLatin1 lê um CSV da Receita/Tesouro (ISO-8859-15, separado por ;).
+func lerCSVLatin1(b []byte) ([][]string, error) {
+	r := csv.NewReader(charmap.ISO8859_15.NewDecoder().Reader(bytes.NewReader(b)))
+	r.Comma = ';'
+	r.LazyQuotes = true
+	r.FieldsPerRecord = -1
+	return r.ReadAll()
+}
+
+// lerZipCSV abre o zip e lê o primeiro arquivo dele como CSV.
+func lerZipCSV(pth string) ([][]string, error) {
+	z, err := zip.OpenReader(pth)
+	if err != nil {
+		return nil, err
+	}
+	defer z.Close()
+	if len(z.File) == 0 {
+		return nil, fmt.Errorf("zip vazio")
+	}
+	f, err := z.File[0].Open()
+	if err != nil {
+		return nil, err
+	}
+	defer f.Close()
+	b, err := io.ReadAll(f)
+	if err != nil {
+		return nil, err
+	}
+	return lerCSVLatin1(b)
+}
+
+func paraReferencias(linhas [][]string) []Referencia {
+	var out []Referencia
+	for _, l := range linhas {
+		if len(l) < 2 || strings.TrimSpace(l[0]) == "" {
+			continue
+		}
+		out = append(out, Referencia{Codigo: strings.TrimSpace(l[0]), Descricao: strings.TrimSpace(l[1])})
+	}
+	return out
+}
+
+func paraTesouro(linhas [][]string) []MunicipioTesouro {
+	var out []MunicipioTesouro
+	for _, l := range linhas {
+		// TOM;CNPJ;NOME;UF;IBGE
+		if len(l) < 5 || strings.TrimSpace(l[0]) == "" {
+			continue
+		}
+		out = append(out, MunicipioTesouro{
+			CodigoReceita: strings.TrimSpace(l[0]),
+			Nome:          strings.TrimSpace(l[2]),
+			UF:            strings.TrimSpace(l[3]),
+			IBGE:          strings.TrimSpace(l[4]),
+		})
+	}
+	return out
+}
+
+// BaixarReferencias baixa o tabmun do Tesouro e os Municipios, Naturezas e
+// Cnaes da Receita do mês ym para dir e devolve o conteúdo.
+func BaixarReferencias(dir, ym string) (*Referencias, error) {
+	if err := validateYearMonth(ym); err != nil {
+		return nil, err
+	}
+	ym = normalizeYearMonth(ym)
+	refs := Referencias{Mes: ym}
+
+	err := comTentativas("tabmun.csv", func() error {
+		urls, err := ckanURLs(nationalTreasureBase, nationalTreasurePkgID)
+		if err != nil {
+			return err
+		}
+		for _, u := range urls {
+			if !strings.HasSuffix(strings.ToLower(u), "tabmun.csv") {
+				continue
+			}
+			pth := filepath.Join(dir, "tabmun.csv")
+			if _, err := downloadURL(u, pth); err != nil {
+				return err
+			}
+			b, err := os.ReadFile(pth)
+			if err != nil {
+				return err
+			}
+			linhas, err := lerCSVLatin1(b)
+			if err != nil {
+				return err
+			}
+			refs.Tesouro = paraTesouro(linhas)
+			if len(refs.Tesouro) == 0 {
+				return fmt.Errorf("tabmun.csv sem municípios")
+			}
+			return nil
+		}
+		return fmt.Errorf("o Tesouro não lista o tabmun.csv")
+	})
+	if err != nil {
+		return nil, err
+	}
+
+	base := newClient(cnpjToken).authBase() + ym + "/"
+	for _, a := range []struct {
+		nome    string
+		destino *[]Referencia
+	}{
+		{"Municipios.zip", &refs.Municipios},
+		{"Naturezas.zip", &refs.Naturezas},
+		{"Cnaes.zip", &refs.CNAEs},
+	} {
+		err := comTentativas(a.nome, func() error {
+			pth := filepath.Join(dir, a.nome)
+			if _, err := downloadURL(base+a.nome, pth); err != nil {
+				return err
+			}
+			linhas, err := lerZipCSV(pth)
+			if err != nil {
+				return err
+			}
+			*a.destino = paraReferencias(linhas)
+			if len(*a.destino) == 0 {
+				return fmt.Errorf("arquivo sem linhas")
+			}
+			return nil
+		})
+		if err != nil {
+			return nil, err
+		}
+	}
+	return &refs, nil
+}
