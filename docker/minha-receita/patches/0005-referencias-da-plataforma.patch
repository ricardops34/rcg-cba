+package transform
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+// Patch da plataforma: o controle grava tabmun-plataforma.csv (pares código da
+// Receita → IBGE da tabela de municípios da plataforma) ao lado do tabmun.csv
+// do Tesouro. O transform lê os dois, e um código que só a plataforma tem
+// (município novo, como Boa Esperança do Norte-MT = 1182) ganha IBGE.
+func TestTabmunDaPlataformaCompletaODoTesouro(t *testing.T) {
+	dir := t.TempDir()
+	b, err := os.ReadFile(filepath.Join(testdataDir, "tabmun.csv"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(dir, "tabmun.csv"), b, 0o644); err != nil {
+		t.Fatal(err)
+	}
+	// 1182 só a plataforma tem; 9701 (Brasília) está nos dois, com o mesmo IBGE.
+	if err := os.WriteFile(filepath.Join(dir, "tabmun-plataforma.csv"), []byte("1182;;;MT;5101837\n9701;;;DF;5300108\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	kv, err := newBadger(nil, t.TempDir(), false)
+	if err != nil {
+		t.Fatalf("expected no error creating kv, got %s", err)
+	}
+	defer func() {
+		if err := kv.db.Close(); err != nil {
+			t.Errorf("expected no error closing badger, got %s", err)
+		}
+	}()
+	srcs := sources()
+	var tab *source
+	for _, s := range srcs {
+		if s.key == "tab" {
+			tab = s
+		}
+	}
+	if tab == nil {
+		t.Fatal("fonte tabmun não encontrada")
+	}
+	if err := loadCSVs(context.Background(), dir, tab, nil, kv); err != nil {
+		t.Fatalf("não carregou os dois tabmun: %s", err)
+	}
+	if err := kv.flush(); err != nil {
+		t.Fatal(err)
+	}
+	for cod, ibge := range map[string]string{"1182": "5101837", "9701": "5300108"} {
+		got, err := stringFromKV(srcs, kv, "tab", cod, 3)
+		if err != nil || got == nil || *got != ibge {
+			t.Errorf("código %s: esperava IBGE %s, veio %v (%v)", cod, ibge, got, err)
+		}
+	}
+}
