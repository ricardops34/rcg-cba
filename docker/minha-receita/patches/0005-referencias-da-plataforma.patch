+// cepBase é um CEP da base com o endereço mais frequente entre as empresas dele.
+type cepBase struct {
+	CEP           string `json:"cep"`
+	UF            string `json:"uf"`
+	CodigoReceita string `json:"codigoReceita"`
+	Bairro        string `json:"bairro"`
+	Endereco      string `json:"endereco"`
+	Empresas      int    `json:"empresas"`
+}
+
+func (c *controle) ceps(ctx context.Context) ([]cepBase, error) {
+	pool, err := pgxpool.New(ctx, c.dbURL)
+	if err != nil {
+		return nil, err
+	}
+	defer pool.Close()
+	rows, err := pool.Query(ctx, `
+		SELECT cep, uf, codmun, bairro, endereco, total::int FROM (
+			SELECT cep, uf, codmun, bairro, endereco,
+			       sum(count(*)) OVER (PARTITION BY cep) AS total,
+			       row_number() OVER (PARTITION BY cep ORDER BY (endereco <> '') DESC, count(*) DESC) AS rn
+			FROM (
+				SELECT json->>'cep' AS cep, json->>'uf' AS uf,
+				       lpad(json->>'codigo_municipio', 4, '0') AS codmun,
+				       coalesce(json->>'bairro', '') AS bairro,
+				       trim(concat_ws(' ', nullif(json->>'descricao_tipo_de_logradouro', ''), nullif(json->>'logradouro', ''))) AS endereco
+				FROM cnpj
+				WHERE json->>'cep' ~ '^[0-9]{8}$' AND json->>'cep' <> '00000000'
+			) e
+			GROUP BY cep, uf, codmun, bairro, endereco
+		) x WHERE rn = 1`)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	var out []cepBase
+	for rows.Next() {
+		var c cepBase
+		if err := rows.Scan(&c.CEP, &c.UF, &c.CodigoReceita, &c.Bairro, &c.Endereco, &c.Empresas); err != nil {
+			return nil, err
+		}
+		out = append(out, c)
+	}
+	return out, rows.Err()
+}
