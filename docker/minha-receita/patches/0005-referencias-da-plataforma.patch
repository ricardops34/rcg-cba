+	got := paraTesouro(linhas)
+	if len(got) != 1 || got[0] != (MunicipioTesouro{CodigoReceita: "9051", Nome: "CAMPO GRANDE", UF: "MS", IBGE: "5002704"}) {
+		t.Fatalf("linha do tabmun lida errada: %+v", got)
+	}
+}
