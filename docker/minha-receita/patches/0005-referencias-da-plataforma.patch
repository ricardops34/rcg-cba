+// gravarTabmunPlataforma grava os pares no formato do tabmun.csv do Tesouro
+// (TOM;CNPJ;NOME;UF;IBGE); o transform só lê o IBGE (quinta coluna).
+func (c *controle) gravarTabmunPlataforma() error {
+	c.mu.Lock()
+	ms := c.municipios
+	c.mu.Unlock()
+	if len(ms) == 0 {
+		return nil
+	}
+	var b strings.Builder
+	for _, m := range ms {
+		fmt.Fprintf(&b, "%s;;;%s;%d\n", m.CodigoReceita, m.UF, m.IBGE)
+	}
+	if err := os.WriteFile(filepath.Join(c.dir, arquivoTabmunPlataforma), []byte(b.String()), 0o644); err != nil {
+		return err
+	}
+	c.logLinha(fmt.Sprintf("Municípios da plataforma: %d pares código da Receita → IBGE", len(ms)))
+	return nil
+}
