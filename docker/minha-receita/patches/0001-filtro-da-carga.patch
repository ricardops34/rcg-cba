diff --git a/transform/filtro.go b/transform/filtro.go
new file mode 100644
index 0000000..84cad92
--- /dev/null
+++ b/transform/filtro.go
@@ -0,0 +1,82 @@
+package transform
+
+// Filtro da carga — patch da plataforma (não existe no projeto original).
+//
+// A base inteira da Receita ocupa ~180 GB; a plataforma só prospecta empresas
+// de alguns estados e em certas situações cadastrais. O filtro descarta o
+// estabelecimento logo depois de lido, antes de montar a empresa, então o que
+// fica de fora nunca chega ao banco.
+//
+// Configuração por variável de ambiente (vazia = sem filtro, como o original):
+//
+//   MR_FILTRO_UFS        UFs mantidas, separadas por vírgula (ex.: "MS,MT")
+//   MR_FILTRO_SITUACOES  códigos de situação cadastral mantidos (ex.: "02");
+//                        01 nula, 02 ativa, 03 suspensa, 04 inapta, 08 baixada
+
+import (
+	"os"
+	"strings"
+	"sync"
+)
+
+// Colunas do CSV de Estabelecimentos (layout da Receita).
+const (
+	colSituacaoCadastral = 5
+	colUF                = 19
+)
+
+type filtroCarga struct {
+	ufs       map[string]bool
+	situacoes map[string]bool
+}
+
+func normalizarSituacao(s string) string {
+	s = strings.TrimSpace(s)
+	if len(s) == 1 {
+		return "0" + s
+	}
+	return s
+}
+
+func novoFiltro(ufs, situacoes string) filtroCarga {
+	f := filtroCarga{ufs: map[string]bool{}, situacoes: map[string]bool{}}
+	for _, u := range strings.Split(ufs, ",") {
+		if u = strings.ToUpper(strings.TrimSpace(u)); u != "" {
+			f.ufs[u] = true
+		}
+	}
+	for _, s := range strings.Split(situacoes, ",") {
+		if s = normalizarSituacao(s); s != "" {
+			f.situacoes[s] = true
+		}
+	}
+	return f
+}
+
+// manter diz se o estabelecimento (linha já limpa) entra na base.
+func (f filtroCarga) manter(row []string) bool {
+	if len(f.ufs) > 0 {
+		if len(row) <= colUF || !f.ufs[strings.ToUpper(strings.TrimSpace(row[colUF]))] {
+			return false
+		}
+	}
+	if len(f.situacoes) > 0 {
+		if len(row) <= colSituacaoCadastral || !f.situacoes[normalizarSituacao(row[colSituacaoCadastral])] {
+			return false
+		}
+	}
+	return true
+}
+
+var (
+	filtroAtual filtroCarga
+	filtroOnce  sync.Once
+)
+
+// manterEstabelecimento aplica o filtro das variáveis de ambiente (lido uma vez).
+func manterEstabelecimento(row []string) bool {
+	filtroOnce.Do(func() {
+		filtroAtual = novoFiltro(os.Getenv("MR_FILTRO_UFS"), os.Getenv("MR_FILTRO_SITUACOES"))
+	})
+	return filtroAtual.manter(row)
+}
diff --git a/transform/filtro_test.go b/transform/filtro_test.go
new file mode 100644
index 0000000..fae0fa0
--- /dev/null
+++ b/transform/filtro_test.go
@@ -0,0 +1,46 @@
+package transform
+
+import "testing"
+
+func linhaEstabelecimento(situacao, uf string) []string {
+	row := make([]string, companyCols)
+	row[colSituacaoCadastral] = situacao
+	row[colUF] = uf
+	return row
+}
+
+func TestFiltroCarga(t *testing.T) {
+	casos := []struct {
+		nome      string
+		ufs       string
+		situacoes string
+		situacao  string
+		uf        string
+		manter    bool
+	}{
+		{"sem filtro mantém tudo", "", "", "08", "SP", true},
+		{"UF na lista", "MS,MT", "", "08", "MS", true},
+		{"UF fora da lista", "MS,MT", "", "02", "SP", false},
+		{"UF com espaço e minúscula", " ms , mt", "", "02", "mt", true},
+		{"só ativas: ativa", "", "02", "02", "SP", true},
+		{"só ativas: baixada sai", "", "02", "08", "SP", false},
+		{"situação com um dígito", "", "2", "02", "SP", true},
+		{"UF e situação juntas", "MS", "02", "02", "MS", true},
+		{"UF certa, situação errada", "MS", "02", "04", "MS", false},
+	}
+	for _, c := range casos {
+		t.Run(c.nome, func(t *testing.T) {
+			f := novoFiltro(c.ufs, c.situacoes)
+			if got := f.manter(linhaEstabelecimento(c.situacao, c.uf)); got != c.manter {
+				t.Errorf("manter = %v, esperado %v", got, c.manter)
+			}
+		})
+	}
+}
+
+func TestFiltroLinhaCurta(t *testing.T) {
+	f := novoFiltro("MS", "")
+	if f.manter([]string{"1", "2"}) {
+		t.Error("linha sem a coluna de UF não pode passar quando há filtro de UF")
+	}
+}
