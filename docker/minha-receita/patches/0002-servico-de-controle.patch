+func TestConferirZipCorrompido(t *testing.T) {
+	pth := zipDeTeste(t, t.TempDir())
+	b, err := os.ReadFile(pth)
+	if err != nil {
+		t.Fatal(err)
+	}
+	// Estraga o meio dos dados comprimidos, como no download de 2026-11-20.
+	for i := len(b) / 3; i < len(b)/3+64; i++ {
+		b[i] ^= 0xFF
+	}
+	if err := os.WriteFile(pth, b, 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if err := conferirZip(pth); err == nil {
+		t.Fatal("zip corrompido passou na conferência")
+	}
+}
