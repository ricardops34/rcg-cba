+func TestBaixarTentaDeNovoERetoma(t *testing.T) {
+	esperaOriginal := esperaDownload
+	esperaDownload = 0
+	defer func() { esperaDownload = esperaOriginal }()
+
+	var chamadas [][]string
+	c := &controle{dir: t.TempDir(), log: slog.Default()}
+	c.rodarFn = func(_ string, _ []string, args ...string) error {
+		chamadas = append(chamadas, append([]string(nil), args...))
+		if len(chamadas) < 3 {
+			return errors.New("connection refused")
+		}
+		return nil
+	}
+	if err := c.baixar("2026-11", true); err != nil {
+		t.Fatalf("devia ter conseguido na terceira: %v", err)
+	}
+	if len(chamadas) != 3 {
+		t.Fatalf("esperava 3 tentativas, foram %d", len(chamadas))
+	}
+	if !slices.Contains(chamadas[0], "--restart") {
+		t.Error("a primeira tentativa pedida com restart devia recomeçar")
+	}
+	for _, ch := range chamadas[1:] {
+		if slices.Contains(ch, "--restart") {
+			t.Error("as retentativas devem retomar, não recomeçar")
+		}
+	}
+}
