+func TestEnvDownloadSoComOQueFoiEscolhido(t *testing.T) {
+	c := &controle{dir: t.TempDir(), log: slog.Default()}
+	if env := c.envDownload(); len(env) != 0 {
+		t.Fatalf("sem escolha não deve mandar nada, veio %v", env)
+	}
+	c.carga.Conexoes, c.carga.Retentativas, c.carga.EsperaS = 2, 40, 20
+	env := c.envDownload()
+	for _, esperado := range []string{"MR_DOWNLOAD_CONEXOES=2", "MR_DOWNLOAD_RETENTATIVAS=40", "MR_DOWNLOAD_ESPERA_S=20"} {
+		if !slices.Contains(env, esperado) {
+			t.Errorf("faltou %s em %v", esperado, env)
