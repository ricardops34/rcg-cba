+package cmd
+
+import (
+	"archive/zip"
+	"bytes"
+	"errors"
+	"log/slog"
+	"math/rand"
+	"os"
+	"path/filepath"
+	"slices"
+	"testing"
+)
+
+// zipDeTeste grava um zip com conteúdo pouco compressível e devolve o caminho.
+func zipDeTeste(t *testing.T, dir string) string {
+	t.Helper()
+	var buf bytes.Buffer
+	w := zip.NewWriter(&buf)
+	f, err := w.Create("ESTABELE")
+	if err != nil {
+		t.Fatal(err)
+	}
+	dados := make([]byte, 256<<10)
+	rand.New(rand.NewSource(1)).Read(dados)
+	if _, err := f.Write(dados); err != nil {
+		t.Fatal(err)
+	}
+	if err := w.Close(); err != nil {
+		t.Fatal(err)
+	}
+	pth := filepath.Join(dir, "Estabelecimentos0.zip")
+	if err := os.WriteFile(pth, buf.Bytes(), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	return pth
+}
+
+func TestConferirZipIntegro(t *testing.T) {
+	pth := zipDeTeste(t, t.TempDir())
