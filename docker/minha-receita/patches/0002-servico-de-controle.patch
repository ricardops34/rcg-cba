+func TestBaixarDesisteDepoisDoLimite(t *testing.T) {
+	esperaOriginal := esperaDownload
+	esperaDownload = 0
+	defer func() { esperaDownload = esperaOriginal }()
+
+	n := 0
+	c := &controle{dir: t.TempDir(), log: slog.Default()}
+	c.rodarFn = func(string, []string, ...string) error { n++; return errors.New("connection refused") }
+	if err := c.baixar("2026-11", false); err == nil {
+		t.Fatal("devia falhar depois de esgotar as tentativas")
+	}
+	if n != tentativasDownload {
+		t.Fatalf("esperava %d tentativas, foram %d", tentativasDownload, n)
+	}
+}
