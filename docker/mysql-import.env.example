# Valores específicos da VPS pro docker/mysql-import.compose.yml — copie pra
# docker/mysql-import.env e preencha (esse arquivo .env não é commitado).

# Nome da rede Docker externa onde o Postgres de destino já está rodando
# (mesma rede usada pelo DATABASE_URL do stack.rcgcba.prod.yml, ex.: network_public).
POSTGRES_NETWORK=network_public

# Role DONO das tabelas (não o "plataforma_app" de aplicação, que tem RLS e
# NOBYPASSRLS — os scripts de seed/import escrevem direto, sem passar por
# withTenant/set_config, e precisam bypassar RLS). Troque host/banco/senha
# pelos valores reais da VPS.
DATABASE_URL_OWNER=postgresql://plataforma:SENHA_AQUI@postgres:5432/BANCO_DEMO?schema=public
