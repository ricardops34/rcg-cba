{
  "name": "plataforma-comercial",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "prisma:generate": "pnpm --filter @plataforma/api prisma:generate",
    "prisma:migrate": "pnpm --filter @plataforma/api prisma:migrate",
    "prisma:seed": "pnpm --filter @plataforma/api prisma:seed"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "overrides": {
      "dompurify": "3.4.17",
      "multer": "^2.5.0",
      "body-parser": "^2.4.0",
      "proxy-addr": "^2.0.8",
      "brace-expansion@^1": "^1.1.20",
      "brace-expansion@^2": "^2.1.6",
      "nanoid": "^3.3.18",
      "postcss": "^8.5.18",
      "browserslist": "^4.28.7",
      "source-map-js": "^1.2.2"
    }
  }
}
